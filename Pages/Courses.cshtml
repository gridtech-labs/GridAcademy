@page
@model GridAcademy.Pages.CoursesModel
@using GridAcademy.DTOs.Marketplace
@{
    ViewData["Title"]           = string.IsNullOrEmpty(Model.Q) ? "Mock Tests & Courses" : $"Search: {Model.Q}";
    ViewData["ActivePage"]      = "Courses";
    ViewData["MetaDescription"] = "Browse mock tests and practice series for JEE, NEET, UPSC, SSC, RRB and more on GridAcademy.";
    Layout = "_PublicLayout";

    var activeCat = Model.Category ?? "";
    var activeQ   = Model.Q ?? "";
}

@section Styles {
<style>
    /* ── Card ────────────────────────────────────────────────── */
    .ga-card {
        background: #fff;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: box-shadow .15s, border-color .15s, transform .12s;
    }
    .ga-card:hover {
        box-shadow: 0 6px 24px rgba(0,0,0,.09);
        border-color: #c7d2fe;
        transform: translateY(-2px);
    }
    .ga-card-accent {
        height: 5px;
        border-radius: 12px 12px 0 0;
        background: linear-gradient(90deg, #1760f4, #6366f1);
    }
    .ga-card-body  { padding: 1.5rem 1.6rem; flex: 1; display: flex; flex-direction: column; }
    .ga-card-title { font-size: 1.15rem; font-weight: 700; color: #111827; margin-bottom: .5rem; line-height: 1.4; }
    .ga-card-meta  { font-size: .875rem; color: #6b7280; margin-bottom: .85rem; display: flex; flex-wrap: wrap; gap: .6rem; }
    .ga-card-meta span { display: inline-flex; align-items: center; gap: .3rem; }
    .ga-card-footer { padding: 1rem 1.6rem; border-top: 1px solid #e5e7eb; }

    /* ── Price / free badge ──────────────────────────────────── */
    .badge-free  { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; border-radius: 6px; padding: .25rem .65rem; font-size: .8rem; font-weight: 700; }
    .badge-price { font-size: .95rem; font-weight: 700; color: #374151; }

    /* ── Buttons ─────────────────────────────────────────────── */
    .btn-card {
        display: block; text-align: center;
        background: #1760f4; color: #fff;
        border-radius: 8px; padding: .72rem;
        font-weight: 700; font-size: .95rem; text-decoration: none;
        transition: background .15s;
    }
    .btn-card:hover { background: #0e4dd4; color: #fff; }
    .btn-card-outline {
        display: block; text-align: center;
        background: #fff; color: #1760f4;
        border: 1.5px solid #1760f4; border-radius: 8px; padding: .72rem;
        font-weight: 700; font-size: .95rem; text-decoration: none;
        transition: background .15s, color .15s;
    }
    .btn-card-outline:hover { background: #1760f4; color: #fff; }

    /* ── Category filter chips ───────────────────────────────── */
    .filter-chip {
        display: inline-block;
        padding: .5rem 1rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 50px;
        background: #f9fafb;
        color: #374151;
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .12s, border-color .12s, color .12s;
        white-space: nowrap;
    }
    .filter-chip:hover { background: #f3f4f6; border-color: #d1d5db; color: #111827; }
    .filter-chip.active { background: #1760f4; border-color: #1760f4; color: #fff; }

    /* ── Search box ──────────────────────────────────────────── */
    .search-input {
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: .6rem 1rem;
        font-size: .9rem;
        color: #111827;
        background: #fff;
        width: 100%;
        max-width: 340px;
        outline: none;
        transition: border-color .15s;
    }
    .search-input:focus { border-color: #1760f4; }
    .btn-search {
        background: #1760f4; color: #fff; border: none;
        border-radius: 8px; padding: .6rem 1.1rem;
        font-size: .9rem; font-weight: 700; cursor: pointer;
        transition: background .15s;
    }
    .btn-search:hover { background: #0e4dd4; }

    /* ── Pagination ──────────────────────────────────────────── */
    .ga-page-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .55rem 1.2rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        color: #374151;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        transition: border-color .12s, color .12s;
    }
    .ga-page-btn:hover { border-color: #1760f4; color: #1760f4; }
    .ga-page-btn.disabled { opacity: .4; pointer-events: none; }
    .ga-page-info { font-size: .875rem; color: #6b7280; font-weight: 500; }

    /* ── Empty state ─────────────────────────────────────────── */
    .empty-state { text-align: center; padding: 5rem 1rem; color: #6b7280; }
    .empty-state i { font-size: 2.5rem; color: #d1d5db; display: block; margin-bottom: 1rem; }
</style>
}

<!-- ══════════════════════════════ PAGE HERO ═══════════════════════════════ -->
<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Mock Tests</li>
            </ol>
        </nav>
        <h1><i class="bi bi-collection-play me-2"></i>Mock Tests</h1>
        <p>Find the right series for your exam — free and premium tests from top educators.</p>
    </div>
</section>

<!-- ══════════════════════════════ FILTER BAR ══════════════════════════════ -->
<section style="background:#f9fafb;border-bottom:1px solid #e5e7eb;padding:1rem 0;">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center gap-3">

            <!-- Category chips -->
            <div class="d-flex flex-wrap gap-2 flex-grow-1">
                <a href="/Courses@(string.IsNullOrEmpty(activeQ) ? "" : $"?q={Uri.EscapeDataString(activeQ)}")"
                   class="filter-chip @(string.IsNullOrEmpty(activeCat) ? "active" : "")">
                    All Exams
                </a>
                @foreach (var cat in Model.Categories)
                {
                    var href = string.IsNullOrEmpty(activeQ)
                        ? $"/Courses?category={cat.Slug}"
                        : $"/Courses?category={cat.Slug}&q={Uri.EscapeDataString(activeQ)}";
                    <a href="@href"
                       class="filter-chip @(activeCat == cat.Slug ? "active" : "")">
                        @if (!string.IsNullOrEmpty(cat.Emoji)) { <span>@cat.Emoji</span> }
                        @cat.Name
                    </a>
                }
            </div>

            <!-- Search -->
            <form method="get" class="d-flex gap-2 align-items-center" style="flex-shrink:0;">
                @if (!string.IsNullOrEmpty(activeCat))
                {
                    <input type="hidden" name="category" value="@activeCat" />
                }
                <input type="search" name="q" value="@activeQ" class="search-input"
                       placeholder="Search tests…" />
                <button type="submit" class="btn-search">
                    <i class="bi bi-search"></i>
                </button>
            </form>

        </div>
    </div>
</section>

<!-- ══════════════════════════════ RESULTS ═════════════════════════════════ -->
<section class="py-4" style="background:#fff;">
    <div class="container">

        <!-- Result summary -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="ga-page-info">
                @if (Model.Results.TotalCount > 0)
                {
                    var start = (Model.Results.Page - 1) * Model.Results.PageSize + 1;
                    var end   = Math.Min(Model.Results.Page * Model.Results.PageSize, Model.Results.TotalCount);
                    <span>Showing @start–@end of @Model.Results.TotalCount result@(Model.Results.TotalCount != 1 ? "s" : "")</span>
                }
                else
                {
                    <span>No results found</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(activeQ) || !string.IsNullOrEmpty(activeCat))
            {
                <a href="/Courses" style="font-size:.82rem;color:#6b7280;text-decoration:none;">
                    <i class="bi bi-x-circle me-1"></i>Clear filters
                </a>
            }
        </div>

        @if (Model.Results.Items.Count > 0)
        {
            <!-- Grid -->
            <div class="row g-4 row-cols-1 row-cols-sm-2">
                @foreach (var series in Model.Results.Items)
                {
                    <div class="col">
                        <div class="ga-card">
                            <div class="ga-card-accent"></div>
                            <div class="ga-card-body">
                                <div class="ga-card-title">@series.Title</div>
                                <div class="ga-card-meta">
                                    @if (!string.IsNullOrEmpty(series.ExamTypeName))
                                    {
                                        <span><i class="bi bi-mortarboard"></i>@series.ExamTypeName</span>
                                    }
                                    <span><i class="bi bi-file-text"></i>@series.TestCount test@(series.TestCount != 1 ? "s" : "")</span>
                                    @if (!string.IsNullOrEmpty(series.Language))
                                    {
                                        <span><i class="bi bi-translate"></i>@series.Language</span>
                                    }
                                    @if (series.PurchaseCount > 0)
                                    {
                                        <span><i class="bi bi-people"></i>@series.PurchaseCount enrolled</span>
                                    }
                                </div>
                                <div class="mt-auto d-flex align-items-center justify-content-between">
                                    @if (series.PriceInr == 0)
                                    {
                                        <span class="badge-free">FREE</span>
                                    }
                                    else if (series.IsFirstTestFree)
                                    {
                                        <div class="d-flex gap-2 align-items-center">
                                            <span class="badge-price">₹@series.PriceInr.ToString("0")</span>
                                            <span class="badge-free">1st free</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge-price">₹@series.PriceInr.ToString("0")</span>
                                    }
                                    @if (series.AvgRating > 0)
                                    {
                                        <span style="font-size:.85rem;color:#6b7280;">
                                            <i class="bi bi-star-fill" style="color:#f59e0b;"></i>
                                            @series.AvgRating.ToString("0.0")
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="ga-card-footer">
                                @if (series.PriceInr == 0 || series.IsFirstTestFree)
                                {
                                    <a href="/Series/@series.Slug" class="btn-card">
                                        Start Test <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="/Series/@series.Slug" class="btn-card-outline">
                                        View Series <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.Results.TotalPages > 1)
            {
                <div class="d-flex align-items-center justify-content-between mt-4 pt-2" style="border-top:1px solid #e5e7eb;">
                    @{
                        string PagingHref(int p)
                        {
                            var parts = new System.Text.StringBuilder("/Courses?page=");
                            parts.Append(p);
                            if (!string.IsNullOrEmpty(activeCat)) { parts.Append("&category="); parts.Append(activeCat); }
                            if (!string.IsNullOrEmpty(activeQ))   { parts.Append("&q="); parts.Append(Uri.EscapeDataString(activeQ)); }
                            return parts.ToString();
                        }
                    }

                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@PagingHref(Model.CurrentPage - 1)" class="ga-page-btn">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    }
                    else
                    {
                        <span class="ga-page-btn disabled"><i class="bi bi-chevron-left"></i> Previous</span>
                    }

                    <span class="ga-page-info">
                        Page @Model.Results.Page of @Model.Results.TotalPages
                    </span>

                    @if (Model.CurrentPage < Model.Results.TotalPages)
                    {
                        <a href="@PagingHref(Model.CurrentPage + 1)" class="ga-page-btn">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="ga-page-btn disabled">Next <i class="bi bi-chevron-right"></i></span>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-search"></i>
                <strong style="display:block;color:#374151;margin-bottom:.5rem;">No tests found</strong>
                <p style="font-size:.875rem;">
                    @if (!string.IsNullOrEmpty(activeQ))
                    {
                        <span>No results for "<em>@activeQ</em>". </span>
                    }
                    Try a different exam category or search term.
                </p>
                <a href="/Courses" class="btn-card" style="display:inline-block;padding:.5rem 1.4rem;width:auto;">
                    Clear Filters
                </a>
            </div>
        }

    </div>
</section>

@section Scripts {
<script>
    // Replace Uri1.EscapeDataString with proper JS encoding for any dynamic links
    // (static Razor escaping is handled server-side above)
</script>
}
