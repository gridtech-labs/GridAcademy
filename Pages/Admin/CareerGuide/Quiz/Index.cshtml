@page
@model GridAcademy.Pages.Admin.CareerGuide.Quiz.IndexModel
@{
    ViewData["Title"] = "Career Guide — Quiz Questions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-patch-question me-2 text-primary"></i>Career Quiz Questions</h4>
        <p class="text-muted small mb-0">Manage the career-type quiz shown on the /career-guide page</p>
    </div>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#questionModal" onclick="openAddModal()">
        <i class="bi bi-plus-lg me-1"></i>Add Question
    </button>
</div>

@if (TempData["Error"]   != null) { <div class="alert alert-danger   alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]  <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.85rem">
            <thead class="table-light">
                <tr>
                    <th style="width:60px">Sort</th>
                    <th>Question</th>
                    <th style="width:100px" class="text-center">Options</th>
                    <th style="width:90px" class="text-center">Status</th>
                    <th style="width:160px" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Questions.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No questions yet. Click <strong>Add Question</strong> to create your first one.</td></tr>
                }
                @foreach (var q in Model.Questions)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@q.SortOrder</span></td>
                        <td class="fw-medium">@q.QuestionText</td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">@q.Options.Count opts</span>
                        </td>
                        <td class="text-center">
                            @if (q.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary"
                                        onclick='openEditModal(@q.Id, @q.SortOrder, @q.IsActive.ToString().ToLower(), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(q.QuestionText)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(q.Options)))'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Toggle" style="display:inline">
                                    <input type="hidden" name="id" value="@q.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn @(q.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(q.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi @(q.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" style="display:inline"
                                      onsubmit="return confirm('Delete this question?')">
                                    <input type="hidden" name="id" value="@q.Id" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Add / Edit Modal ──────────────────────────────────────────────────── -->
<div class="modal fade" id="questionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Save">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EditId" id="editIdInput" />

                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle"><i class="bi bi-patch-question me-2"></i>Add Question</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-9">
                            <label class="form-label fw-semibold">Question Text <span class="text-danger">*</span></label>
                            <input type="text" asp-for="QText" id="qTextInput" class="form-control" placeholder="e.g. On a free weekend, you naturally reach for..." required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Sort Order</label>
                            <input type="number" asp-for="QSort" id="qSortInput" class="form-control" value="0" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end pb-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="QActive" id="qActiveInput" checked />
                                <label class="form-check-label small" for="qActiveInput">Active</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <p class="fw-semibold small text-muted mb-2">Options (minimum 2, recommended 4 — each option maps to a career category)</p>

                    <div id="optionsContainer">
                        @for (int i = 0; i < 4; i++)
                        {
                            <div class="row g-2 mb-2 option-row">
                                <div class="col-7">
                                    <input type="text" name="OptText" class="form-control form-control-sm" placeholder="Option @(char.ConvertFromUtf32(65+i)) text..." />
                                </div>
                                <div class="col-4">
                                    <select name="OptCategory" class="form-select form-select-sm">
                                        <option value="">— Category —</option>
                                        <option value="makers">🪵 Makers</option>
                                        <option value="connectors">🤝 Connectors</option>
                                        <option value="explorers">🏕️ Explorers</option>
                                        <option value="screen-workers">💻 Screen Workers</option>
                                        <option value="thinkers">🧠 Thinkers</option>
                                        <option value="performers">🎭 Performers</option>
                                        <option value="healers">💊 Healers</option>
                                        <option value="builders">🚀 Builders</option>
                                    </select>
                                </div>
                                <div class="col-1 d-flex align-items-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-opt" onclick="removeOption(this)"><i class="bi bi-x"></i></button>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-1" onclick="addOptionRow()">
                        <i class="bi bi-plus-lg me-1"></i>Add Option
                    </button>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save Question</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
const CATEGORIES = ['makers','connectors','explorers','screen-workers','thinkers','performers','healers','builders'];
const CAT_LABELS = {
  'makers':'🪵 Makers','connectors':'🤝 Connectors','explorers':'🏕️ Explorers',
  'screen-workers':'💻 Screen Workers','thinkers':'🧠 Thinkers','performers':'🎭 Performers',
  'healers':'💊 Healers','builders':'🚀 Builders'
};

function buildOptionRow(text = '', category = '') {
    const idx = document.querySelectorAll('.option-row').length;
    const label = String.fromCharCode(65 + idx);
    const opts = Object.entries(CAT_LABELS).map(([val,lbl]) =>
        `<option value="${val}" ${val===category?'selected':''}>${lbl}</option>`).join('');
    return `<div class="row g-2 mb-2 option-row">
        <div class="col-7"><input type="text" name="OptText" class="form-control form-control-sm" placeholder="Option ${label} text..." value="${text.replace(/"/g,'&quot;')}" /></div>
        <div class="col-4"><select name="OptCategory" class="form-select form-select-sm"><option value="">— Category —</option>${opts}</select></div>
        <div class="col-1 d-flex align-items-center"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeOption(this)"><i class="bi bi-x"></i></button></div>
    </div>`;
}

function addOptionRow() {
    document.getElementById('optionsContainer').insertAdjacentHTML('beforeend', buildOptionRow());
}

function removeOption(btn) {
    btn.closest('.option-row').remove();
}

function openAddModal() {
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-patch-question me-2"></i>Add Question';
    document.getElementById('editIdInput').value = '0';
    document.getElementById('qTextInput').value = '';
    document.getElementById('qSortInput').value = '0';
    document.getElementById('qActiveInput').checked = true;
    const container = document.getElementById('optionsContainer');
    container.innerHTML = '';
    for (let i = 0; i < 4; i++) container.insertAdjacentHTML('beforeend', buildOptionRow());
}

function openEditModal(id, sort, active, questionText, options) {
    document.getElementById('modalTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Edit Question';
    document.getElementById('editIdInput').value = id;
    document.getElementById('qTextInput').value = questionText;
    document.getElementById('qSortInput').value = sort;
    document.getElementById('qActiveInput').checked = active;
    const container = document.getElementById('optionsContainer');
    container.innerHTML = '';
    options.forEach(o => container.insertAdjacentHTML('beforeend', buildOptionRow(o.optionText, o.careerCategory)));
    new bootstrap.Modal(document.getElementById('questionModal')).show();
}
</script>
}
