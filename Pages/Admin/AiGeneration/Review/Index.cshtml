@page
@model GridAcademy.Pages.Admin.AiGeneration.Review.IndexModel
@{ ViewData["Title"] = "AI Review Queue"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-clipboard2-check me-2 text-warning"></i>Review Queue</h4>
        <p class="text-muted small mb-0">Keyboard: <kbd>j</kbd>/<kbd>k</kbd> navigate · <kbd>a</kbd> approve · <kbd>r</kbd> reject · <kbd>e</kbd> edit</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Admin/AiGeneration/Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-house me-1"></i>Dashboard
        </a>
        @if (Model.JobId.HasValue && Model.StatusTab == 1 && Model.PendingCount > 0)
        {
            <form method="post" asp-page-handler="BulkReject">
                <input type="hidden" name="jobId" value="@Model.JobId" />
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Reject ALL pending drafts in this job?')">
                    <i class="bi bi-x-circle me-1"></i>Reject All
                </button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Status tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.StatusTab == 1 ? "active" : "")"
           asp-page="Index" asp-route-StatusTab="1" asp-route-jobId="@Model.JobId">
            Pending <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusTab == 2 ? "active" : "")"
           asp-page="Index" asp-route-StatusTab="2" asp-route-jobId="@Model.JobId">
            Approved <span class="badge bg-success ms-1">@Model.ApprovedCount</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusTab == 3 ? "active" : "")"
           asp-page="Index" asp-route-StatusTab="3" asp-route-jobId="@Model.JobId">
            Rejected <span class="badge bg-secondary ms-1">@Model.RejectedCount</span>
        </a>
    </li>
</ul>

@if (!Model.Drafts.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-check2-all fs-1"></i>
        <p class="mt-2">No drafts in this category.</p>
    </div>
}
else
{
    <!-- Drafts list -->
    <div id="draftsList">
        @for (int i = 0; i < Model.Drafts.Count; i++)
        {
            var d      = Model.Drafts[i];
            var opts   = IndexModel.ParseOptions(d.OptionsJson);
            var flags  = IndexModel.ParseFlags(d.FlagsJson);
            var hasFlagS = flags.Any();

            <div class="card border-0 shadow-sm mb-3 draft-card @(hasFlagS ? "border-warning" : "")"
                 data-draft-id="@d.Id" id="draft-@d.Id">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                    <div>
                        <span class="text-muted small me-2">#@d.Id</span>
                        <span class="badge bg-secondary me-1">@(d.DifficultyEstimate ?? "?") difficulty</span>
                        @if (d.EstimatedSeconds.HasValue)
                        {
                            <span class="badge bg-light text-dark border me-1">~@(d.EstimatedSeconds)s</span>
                        }
                        <span class="badge bg-info me-1">job #@d.GenerationJobId</span>
                        @foreach (var f in flags)
                        {
                            <span class="badge bg-warning text-dark me-1">⚑ @f.Replace("_", " ")</span>
                        }
                    </div>
                    <span class="text-muted small">@d.CreatedAt.ToString("dd MMM HH:mm")</span>
                </div>
                <div class="card-body">
                    <!-- Question text -->
                    <div class="mb-3 question-text">
                        <div class="fw-semibold">@Html.Raw(d.QuestionText)</div>
                    </div>

                    <!-- Options -->
                    <div class="row g-2 mb-3">
                        @foreach (var (opt, idx) in opts.Select((o, i) => (o, i)))
                        {
                            <div class="col-md-6">
                                <div class="p-2 rounded small @(idx == d.CorrectIndex ? "bg-success bg-opacity-10 border border-success" : "bg-light border")">
                                    <strong>@opt.Label.</strong> @opt.Text
                                    @if (idx == d.CorrectIndex)
                                    {
                                        <i class="bi bi-check-circle-fill text-success ms-1"></i>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Explanation (collapsible) -->
                    @if (!string.IsNullOrEmpty(d.Explanation))
                    {
                        <div class="mb-3">
                            <button class="btn btn-xs btn-outline-secondary" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#exp-@d.Id">
                                <i class="bi bi-lightbulb me-1"></i>Explanation
                            </button>
                            <div class="collapse mt-2 p-2 bg-light rounded small" id="exp-@d.Id">
                                @d.Explanation
                            </div>
                        </div>
                    }

                    <!-- Action buttons (pending only) -->
                    @if (d.Status == GridAcademy.Modules.AiGeneration.Domain.Entities.DraftStatus.PendingReview)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <form method="post" asp-page-handler="Approve" style="display:inline">
                                <input type="hidden" name="draftId" value="@d.Id" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Approve
                                </button>
                            </form>
                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#rejectModal-@d.Id">
                                <i class="bi bi-x-lg me-1"></i>Reject
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal"
                                    data-bs-target="#editModal-@d.Id">
                                <i class="bi bi-pencil me-1"></i>Edit &amp; Approve
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Reject modal -->
            <div class="modal fade" id="rejectModal-@d.Id" tabindex="-1">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title">Reject Draft #@d.Id</h6>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                        </div>
                        <form method="post" asp-page-handler="Reject">
                            <div class="modal-body">
                                <input type="hidden" name="draftId" value="@d.Id" />
                                <label class="form-label small">Reason</label>
                                <textarea name="reason" class="form-control form-control-sm" rows="2"
                                          placeholder="Wrong answer / unclear / out of scope…"></textarea>
                            </div>
                            <div class="modal-footer py-2">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Edit + Approve modal -->
            <div class="modal fade" id="editModal-@d.Id" tabindex="-1">
                <div class="modal-dialog modal-xl">
                    <div class="modal-content">
                        <div class="modal-header py-2">
                            <h6 class="modal-title">Edit &amp; Approve Draft #@d.Id</h6>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                        </div>
                        <form method="post" asp-page-handler="EditApprove">
                            <input type="hidden" name="EditDraftId" value="@d.Id" />
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Question Text</label>
                                    <textarea name="EditQuestionText" class="form-control form-control-sm" rows="4">@d.QuestionText</textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold">Options JSON</label>
                                    <textarea name="EditOptionsJson" class="form-control form-control-sm font-monospace" rows="6">@d.OptionsJson</textarea>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label small">Correct Index (0-based)</label>
                                        <input name="EditCorrectIndex" type="number" min="0" max="3"
                                               class="form-control form-control-sm" value="@d.CorrectIndex" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Subject</label>
                                        <select name="EditSubjectId" class="form-select form-select-sm">
                                            <option value="">— Keep —</option>
                                            @foreach (var s in Model.SubjectOptions)
                                            { <option value="@s.Id" selected="@(d.SubjectId == s.Id)">@s.Name</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Topic</label>
                                        <select name="EditTopicId" class="form-select form-select-sm">
                                            <option value="">— Keep —</option>
                                            @foreach (var t in Model.TopicOptions)
                                            { <option value="@t.Id" selected="@(d.TopicId == t.Id)">@t.Name</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small">Difficulty</label>
                                        <select name="EditDifficultyId" class="form-select form-select-sm">
                                            <option value="">— Keep —</option>
                                            @foreach (var dif in Model.DifficultyOptions)
                                            { <option value="@dif.Id">@dif.Name</option> }
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Explanation</label>
                                    <textarea name="EditExplanation" class="form-control form-control-sm" rows="2">@d.Explanation</textarea>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Review Notes</label>
                                    <input name="EditReviewNotes" class="form-control form-control-sm"
                                           placeholder="Optional notes about your edits…" />
                                </div>
                            </div>
                            <div class="modal-footer py-2">
                                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Save &amp; Approve
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TotalCount > 10)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int p = 1; p <= (int)Math.Ceiling((double)Model.TotalCount / 10); p++)
            {
                <li class="page-item @(p == Model.PageNum ? "active" : "")">
                    <a class="page-link" asp-page="Index"
                       asp-route-StatusTab="@Model.StatusTab"
                       asp-route-jobId="@Model.JobId"
                       asp-route-pageNum="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}

<style>
    .draft-card.border-warning { border: 1px solid #ffc107 !important; }
    .btn-xs { padding: 1px 8px; font-size: .75rem; }
    kbd { background:#eee; border-radius:3px; padding:1px 5px; font-size:.8rem; }
</style>

<script>
    // ── Keyboard navigation ─────────────────────────────────────────────────
    (function () {
        let cards = [...document.querySelectorAll('.draft-card')];
        let current = 0;

        function highlight(idx) {
            cards.forEach(c => c.classList.remove('ring'));
            if (cards[idx]) cards[idx].classList.add('ring');
        }

        function clickBtn(idx, selector) {
            const btn = cards[idx]?.querySelector(selector);
            if (btn) btn.click();
        }

        highlight(0);

        document.addEventListener('keydown', e => {
            // Don't intercept when typing in inputs/textareas
            if (['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) return;
            if (document.querySelector('.modal.show')) return;

            if (e.key === 'j' || e.key === 'ArrowDown') {
                current = Math.min(current + 1, cards.length - 1);
                highlight(current);
                cards[current]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (e.key === 'k' || e.key === 'ArrowUp') {
                current = Math.max(current - 1, 0);
                highlight(current);
                cards[current]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (e.key === 'a') {
                clickBtn(current, 'button[type=submit].btn-success');
            } else if (e.key === 'r') {
                clickBtn(current, 'button.btn-danger[data-bs-target]');
            } else if (e.key === 'e') {
                clickBtn(current, 'button.btn-outline-primary[data-bs-target]');
            }
        });
    })();
</script>

<style>
    .ring { box-shadow: 0 0 0 3px rgba(13,110,253,.35) !important; }
</style>
