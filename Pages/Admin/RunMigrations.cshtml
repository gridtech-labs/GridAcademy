@page
@model GridAcademy.Pages.Admin.RunMigrationsModel
@{
    ViewData["Title"] = "Database Migrations";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-4" style="max-width:700px">
    <h4 class="mb-1"><i class="bi bi-database-gear me-2 text-primary"></i>Database Migrations</h4>
    <p class="text-muted mb-4">Apply any pending EF Core migrations to the production database.</p>

    @if (Model.Result != null)
    {
        <div class="alert @(Model.Success ? "alert-success" : "alert-danger") d-flex gap-2 align-items-start">
            <i class="bi @(Model.Success ? "bi-check-circle-fill" : "bi-x-circle-fill") mt-1"></i>
            <div>
                <strong>@(Model.Success ? "Success" : "Error")</strong><br/>
                <pre class="mb-0 mt-1" style="font-size:.85rem;white-space:pre-wrap">@Model.Result</pre>
            </div>
        </div>
    }

    @if (Model.PendingMigrations?.Any() == true)
    {
        <div class="alert alert-warning">
            <strong>@Model.PendingMigrations.Count() pending migration(s):</strong>
            <ul class="mb-0 mt-2">
                @foreach (var m in Model.PendingMigrations)
                {
                    <li><code>@m</code></li>
                }
            </ul>
        </div>
    }
    else if (Model.PendingMigrations != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            All migrations are already applied. No action needed.
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-play-circle me-2"></i>Apply Pending Migrations
        </button>
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary ms-2">Back to Dashboard</a>
    </form>
</div>
