@page
@model GridAcademy.Pages.Admin.ClientMgmt.IndexModel
@{
    ViewData["Title"] = "Client Management";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="fw-bold mb-1">Clients</h5>
        <p class="text-muted small mb-0">@Model.Clients.Count client(s) on this platform</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary">
        <i class="bi bi-building-add me-1"></i>Add Client
    </a>
</div>

<!-- Table -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Clients.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-buildings text-muted" style="font-size:2.5rem;opacity:0.4"></i>
                <p class="text-muted mt-3 mb-0">No clients found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Slug</th>
                            <th>Users</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.Clients)
                        {
                            <tr>
                                <td class="text-muted small">@c.Id</td>
                                <td class="fw-semibold">@c.Name</td>
                                <td><code class="small">@c.Slug</code></td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                        @c.UserCount
                                    </span>
                                </td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                    }
                                </td>
                                <td class="text-muted small">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-page="./Edit" asp-route-id="@c.Id"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
