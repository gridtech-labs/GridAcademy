@page "{id:guid}"
@model GridAcademy.Pages.Admin.Content.Tests.EditModel
@using GridAcademy.Data.Entities.Assessment
@{
    ViewData["Title"] = Model.Test is not null ? $"Edit — {Model.Test.Title}" : "Edit Test";
    bool isPublished = Model.Test?.Status == TestStatus.Published;
}

<!-- ── Page header ─────────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Test</h4>
        <p class="text-muted small mb-0">@(Model.Test?.Title ?? "")</p>
    </div>
    <a asp-page="/Admin/Content/Tests/Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Back to Tests
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (isPublished)
{
    <div class="alert alert-warning d-flex gap-2 py-2 mb-3">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-1"></i>
        <div>
            <strong>Published tests cannot be edited without unpublishing first.</strong>
            Fields are locked. Unpublish the test to make changes.
        </div>
    </div>
}

<!-- ═══════════════════════════════════════════════════════════════
     TOP CARD — Test header form
     ═══════════════════════════════════════════════════════════════ -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold"><i class="bi bi-info-circle me-1 text-primary"></i>Test Details</span>
        @{
            var statusBadge = Model.Test?.Status switch {
                TestStatus.Published => ("bg-success-subtle text-success border border-success-subtle", "Published"),
                TestStatus.Archived  => ("bg-dark-subtle text-dark border border-dark-subtle",    "Archived"),
                _                    => ("bg-secondary-subtle text-secondary border border-secondary-subtle", "Draft")
            };
        }
        <span class="badge @statusBadge.Item1">@statusBadge.Item2</span>
    </div>
    <div class="card-body">
        <form method="post" asp-page-handler="Test">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="TestForm.Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                <input asp-for="TestForm.Title" class="form-control" required disabled="@isPublished" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Instructions</label>
                @if (isPublished)
                {
                    <div class="form-control bg-light" style="min-height:120px; font-size:.9rem;" readonly>
                        @Html.Raw(Model.TestForm.Instructions ?? "<em class='text-muted'>No instructions set.</em>")
                    </div>
                    <input type="hidden" asp-for="TestForm.Instructions" />
                }
                else
                {
                    <div id="instructionsEditor" style="min-height:160px; border:1px solid #dee2e6; border-radius:0 0 .375rem .375rem;"></div>
                    <input type="hidden" asp-for="TestForm.Instructions" id="instructionsHidden" />
                }
                <div class="form-text">Use the toolbar to format — bold, italic, lists, colors. Shown to the student before the exam.</div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-3">
                    <label asp-for="TestForm.DurationMinutes" class="form-label fw-semibold">Duration (min)</label>
                    <input asp-for="TestForm.DurationMinutes" type="number" min="1" class="form-control" disabled="@isPublished" />
                </div>
                <div class="col-sm-3">
                    <label asp-for="TestForm.PassingPercent" class="form-label fw-semibold">Passing %</label>
                    <input asp-for="TestForm.PassingPercent" type="number" min="0" max="100" step="0.01" class="form-control" disabled="@isPublished" />
                </div>
                <div class="col-sm-3">
                    <label asp-for="TestForm.ExamTypeId" class="form-label fw-semibold">Exam Type</label>
                    <select asp-for="TestForm.ExamTypeId" class="form-select" disabled="@isPublished">
                        <option value="0">— None —</option>
                        @foreach (var et in Model.ExamTypes)
                        {
                            <option value="@et.Id">@et.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3 d-flex align-items-end pb-1">
                    <div class="form-check form-switch">
                        <input asp-for="TestForm.NegativeMarkingEnabled" class="form-check-input" type="checkbox"
                               role="switch" id="negMarkSwitch" disabled="@isPublished" />
                        <label class="form-check-label fw-semibold" for="negMarkSwitch">Neg. Marking</label>
                    </div>
                </div>
            </div>

            @if (!isPublished)
            {
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-floppy me-1"></i>Save Test
                </button>
            }
        </form>

        <!-- Publish / Unpublish — MUST be outside the Test form (no nested forms) -->
        <div class="mt-3 d-flex gap-2">
            @if (Model.Test?.Status == TestStatus.Draft || Model.Test?.Status == TestStatus.Archived)
            {
                <form method="post" asp-page-handler="Publish">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-success btn-sm">
                        <i class="bi bi-check-circle me-1"></i>Publish
                    </button>
                </form>
            }
            else if (Model.Test?.Status == TestStatus.Published)
            {
                <form method="post" asp-page-handler="Unpublish">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-warning btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Unpublish
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     MIDDLE CARD — Sections list
     ═══════════════════════════════════════════════════════════════ -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white fw-semibold py-2">
        <i class="bi bi-layers me-1 text-primary"></i>Sections
        <span class="badge bg-secondary ms-1">@(Model.Test?.Sections.Count ?? 0)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Test?.Sections.Any() == true)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Subject</th>
                            <th>Difficulty</th>
                            <th class="text-center">Count</th>
                            <th class="text-center">Marks+</th>
                            <th class="text-center">Marks-</th>
                            <th class="text-center">Pool</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.Test.Sections.OrderBy(x => x.SortOrder))
                    {
                        <tr>
                            <td class="text-muted small">@s.SortOrder</td>
                            <td class="fw-semibold small">@s.Name</td>
                            <td class="small">@s.SubjectName</td>
                            <td class="small text-muted">@(s.DifficultyLevelName ?? "Any")</td>
                            <td class="text-center small">@s.QuestionCount</td>
                            <td class="text-center small text-success fw-semibold">+@s.MarksPerQuestion</td>
                            <td class="text-center small text-danger">-@s.NegativeMarksPerQuestion</td>
                            <td class="text-center">
                                <span class="pool-badge badge bg-light text-dark border" data-section-id="@s.Id">…</span>
                            </td>
                            <td class="text-end">
                                @if (!isPublished)
                                {
                                    <form method="post" asp-page-handler="DeleteSection"
                                          onsubmit="return confirm('Remove this section?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sectionId" value="@s.Id" />
                                        <button class="btn btn-sm btn-outline-danger" title="Remove section">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-layers" style="font-size:2rem;opacity:0.3"></i>
                <p class="mt-2 mb-0 small">No sections yet. Add a section below.</p>
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     QUESTIONS CARD — Directly mapped questions + Add-Questions modal
     ═══════════════════════════════════════════════════════════════ -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold">
            <i class="bi bi-question-circle me-1 text-primary"></i>Questions
            <span id="qCountBadge" class="badge bg-secondary ms-1">…</span>
        </span>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Content/Tests/Questions/Index"
               asp-route-testId="@Model.Id"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-list-ul me-1"></i>Manage Questions
            </a>
            @if (!isPublished)
            {
                <a asp-page="/Admin/Content/Questions/Create"
                   asp-route-testId="@Model.Id"
                   class="btn btn-success btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Add Question
                </a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div id="mappedQuestionsContainer">
            <!-- loaded via JS -->
            <div class="text-center py-4 text-muted small" id="qLoadingMsg">
                <div class="spinner-border spinner-border-sm me-1"></div> Loading…
            </div>
        </div>
    </div>
</div>

<!-- ── Add Questions Modal ──────────────────────────────────────────────── -->
<div class="modal fade" id="addQuestionsModal" tabindex="-1" aria-labelledby="addQuestionsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title fs-6 fw-bold" id="addQuestionsModalLabel">
                    <i class="bi bi-journals me-1 text-primary"></i>Add Questions from Bank
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <!-- Filter row -->
                <div class="row g-2 mb-3">
                    <div class="col-12 col-md-4">
                        <input type="text" id="qSearch" class="form-control form-control-sm"
                               placeholder="Search by question text…" />
                    </div>
                    <div class="col-6 col-md-3">
                        <select id="qSubjectFilter" class="form-select form-select-sm">
                            <option value="">All Subjects</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <select id="qDiffFilter" class="form-select form-select-sm">
                            <option value="">All Difficulties</option>
                            @foreach (var d in Model.DifficultyLevels)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="button" id="qSearchBtn" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-search me-1"></i>Search
                        </button>
                    </div>
                </div>

                <!-- Selection summary -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small" id="qBrowseInfo">Showing results…</span>
                    <span class="badge bg-primary" id="qSelectedCount">0 selected</span>
                </div>

                <!-- Question list -->
                <div id="qBrowseList" style="min-height:200px">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-search" style="font-size:2rem;opacity:0.3"></i>
                        <p class="mt-2 small">Use filters above to browse questions.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <span class="text-muted small me-auto" id="qAlreadyNote"></span>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm" id="qAddSelectedBtn" disabled>
                    <i class="bi bi-plus-lg me-1"></i>Add Selected
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden form to POST selected question IDs -->
<form method="post" id="addQuestionsForm" asp-page-handler="AddQuestions">
    @Html.AntiForgeryToken()
    <input type="hidden" name="questionIds" id="selectedIdsInput" />
</form>

<!-- ═══════════════════════════════════════════════════════════════
     BOTTOM CARD — Add Section form
     ═══════════════════════════════════════════════════════════════ -->
@if (!isPublished)
{
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold py-2">
            <i class="bi bi-plus-circle me-1 text-success"></i>Add Section
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="AddSection">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-3">
                        <label asp-for="SectionForm.Name" class="form-label fw-semibold">Section Name <span class="text-danger">*</span></label>
                        <input asp-for="SectionForm.Name" class="form-control form-control-sm" placeholder="e.g. Physics" required />
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="SectionForm.SubjectId" class="form-label fw-semibold">Subject <span class="text-danger">*</span></label>
                        <select asp-for="SectionForm.SubjectId" class="form-select form-select-sm" required>
                            <option value="0">— Select —</option>
                            @foreach (var s in Model.Subjects)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label asp-for="SectionForm.DifficultyLevelId" class="form-label fw-semibold">Difficulty</label>
                        <select asp-for="SectionForm.DifficultyLevelId" class="form-select form-select-sm">
                            <option value="">Any</option>
                            @foreach (var d in Model.DifficultyLevels)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-4 col-md-1">
                        <label asp-for="SectionForm.QuestionCount" class="form-label fw-semibold">Count</label>
                        <input asp-for="SectionForm.QuestionCount" type="number" min="1" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label asp-for="SectionForm.MarksPerQuestion" class="form-label fw-semibold">Marks+</label>
                        <input asp-for="SectionForm.MarksPerQuestion" type="number" min="0" step="0.25" class="form-control form-control-sm" />
                    </div>
                    <div class="col-4 col-md-2">
                        <label asp-for="SectionForm.NegativeMarksPerQuestion" class="form-label fw-semibold">Marks-</label>
                        <input asp-for="SectionForm.NegativeMarksPerQuestion" type="number" min="0" step="0.25" class="form-control form-control-sm" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="bi bi-plus-lg me-1"></i>Add
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<!-- Quill.js (only needed when not published) -->
@if (!isPublished)
{
    <text>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
    (function () {
        const hiddenInput = document.getElementById('instructionsHidden');
        if (!hiddenInput) return;
        const quill = new Quill('#instructionsEditor', {
            theme: 'snow',
            placeholder: 'Type exam instructions here…',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ color: [] }, { background: [] }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    [{ align: [] }],
                    ['clean']
                ]
            }
        });

        // Pre-populate from hidden input
        if (hiddenInput.value) {
            quill.clipboard.dangerouslyPasteHTML(hiddenInput.value);
        }

        // Sync before form submit
        hiddenInput.closest('form').addEventListener('submit', function () {
            hiddenInput.value = quill.getSemanticHTML();
        });
    })();
    </script>
    </text>
}
<script>
// ── Mapped Questions Card ─────────────────────────────────────────────────────
(function () {
    const container  = document.getElementById('mappedQuestionsContainer');
    const loadingMsg = document.getElementById('qLoadingMsg');
    const badge      = document.getElementById('qCountBadge');
    const isPublished = @(isPublished ? "true" : "false");

    function stripHtml(html) {
        const d = document.createElement('div');
        d.innerHTML = html || '';
        return d.textContent || '';
    }

    function loadMappedQuestions() {
        fetch('?handler=TestQuestions', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(data => {
                badge.textContent = data.length;
                if (data.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-question-circle" style="font-size:2rem;opacity:0.3"></i>
                            <p class="mt-2 mb-0 small">No questions added yet. Use <strong>Add Questions</strong> to pick from the bank.</p>
                        </div>`;
                    return;
                }
                let rows = data.map((q, i) => `
                    <tr>
                        <td class="text-muted small">${q.sortOrder}</td>
                        <td class="small" style="max-width:380px">
                            <span class="text-truncate d-block" style="max-width:380px" title="${stripHtml(q.text).replace(/"/g,"&quot;")}">
                                ${stripHtml(q.text).substring(0, 120)}${q.text.length > 120 ? '…' : ''}
                            </span>
                        </td>
                        <td class="small text-muted">${q.subjectName}</td>
                        <td class="small">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">${q.questionType}</span>
                        </td>
                        <td class="small text-muted">${q.difficultyLevel || '—'}</td>
                        <td class="text-end">
                            ${isPublished ? '' : `
                            <form method="post" action="?handler=RemoveQuestion&questionId=${q.questionId}" onsubmit="return confirm('Remove this question from the test?')">
                                <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name=__RequestVerificationToken]')?.value || ''}" />
                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Remove">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>`}
                        </td>
                    </tr>`).join('');
                container.innerHTML = `
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 table-sm">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:50px">#</th>
                                    <th>Question</th>
                                    <th>Subject</th>
                                    <th>Type</th>
                                    <th>Difficulty</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
            })
            .catch(() => {
                container.innerHTML = '<div class="text-center py-3 text-danger small">Failed to load questions.</div>';
            });
    }

    loadMappedQuestions();

    // ── Browse / Add modal ────────────────────────────────────────────────────
    let selectedIds = new Set();

    function updateSelectedCount() {
        const btn  = document.getElementById('qAddSelectedBtn');
        const span = document.getElementById('qSelectedCount');
        span.textContent = selectedIds.size + ' selected';
        btn.disabled = selectedIds.size === 0;
        btn.textContent = selectedIds.size > 0 ? `Add Selected (${selectedIds.size})` : 'Add Selected';
    }

    function renderBrowseList(items) {
        const list    = document.getElementById('qBrowseList');
        const info    = document.getElementById('qBrowseInfo');
        const already = document.getElementById('qAlreadyNote');

        const alreadyCount = items.filter(i => i.alreadyMapped).length;
        info.textContent  = `Showing ${items.length} result(s)`;
        already.textContent = alreadyCount > 0 ? `${alreadyCount} already in test (shown greyed)` : '';

        if (items.length === 0) {
            list.innerHTML = '<div class="text-center text-muted py-5 small">No questions match your filters.</div>';
            return;
        }

        list.innerHTML = `
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width:36px">
                            <input type="checkbox" id="qSelectAll" class="form-check-input" />
                        </th>
                        <th>Question</th>
                        <th>Subject</th>
                        <th>Topic</th>
                        <th>Type</th>
                        <th>Difficulty</th>
                    </tr>
                </thead>
                <tbody>
                    ${items.map(q => `
                        <tr class="${q.alreadyMapped ? 'table-secondary' : ''}">
                            <td>
                                <input type="checkbox" class="form-check-input q-check"
                                       value="${q.id}"
                                       ${selectedIds.has(q.id) ? 'checked' : ''}
                                       ${q.alreadyMapped ? 'disabled title="Already in test"' : ''} />
                            </td>
                            <td style="max-width:320px">
                                <span class="d-block text-truncate small"
                                      style="max-width:320px"
                                      title="${stripHtml(q.text).replace(/"/g,'&quot;')}">
                                    ${stripHtml(q.text).substring(0, 100)}${q.text.length > 100 ? '…' : ''}
                                </span>
                            </td>
                            <td class="small text-muted">${q.subjectName}</td>
                            <td class="small text-muted">${q.topicName}</td>
                            <td class="small">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">${q.questionType}</span>
                            </td>
                            <td class="small text-muted">${q.difficultyLevel || '—'}</td>
                        </tr>`).join('')}
                </tbody>
            </table>`;

        // Checkbox events
        list.querySelectorAll('.q-check').forEach(cb => {
            cb.addEventListener('change', function () {
                if (this.checked) selectedIds.add(this.value);
                else selectedIds.delete(this.value);
                updateSelectedCount();
            });
        });

        // Select-all
        document.getElementById('qSelectAll').addEventListener('change', function () {
            list.querySelectorAll('.q-check:not(:disabled)').forEach(cb => {
                cb.checked = this.checked;
                if (this.checked) selectedIds.add(cb.value);
                else selectedIds.delete(cb.value);
            });
            updateSelectedCount();
        });
    }

    function doBrowse() {
        const search  = document.getElementById('qSearch').value.trim();
        const subjId  = document.getElementById('qSubjectFilter').value;
        const diffId  = document.getElementById('qDiffFilter').value;
        const list    = document.getElementById('qBrowseList');
        list.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm"></div></div>';

        const params = new URLSearchParams({ handler: 'BrowseQuestions' });
        if (subjId)  params.append('subjectId', subjId);
        if (diffId)  params.append('difficultyLevelId', diffId);
        if (search)  params.append('search', search);

        fetch('?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(renderBrowseList)
            .catch(() => { list.innerHTML = '<div class="text-center text-danger small py-4">Error loading questions.</div>'; });
    }

    // Trigger browse when modal opens
    document.getElementById('addQuestionsModal')?.addEventListener('show.bs.modal', () => {
        selectedIds.clear();
        updateSelectedCount();
        doBrowse();
    });

    document.getElementById('qSearchBtn')?.addEventListener('click', doBrowse);
    document.getElementById('qSearch')?.addEventListener('keydown', e => { if (e.key === 'Enter') doBrowse(); });
    document.getElementById('qSubjectFilter')?.addEventListener('change', doBrowse);
    document.getElementById('qDiffFilter')?.addEventListener('change', doBrowse);

    // Submit selected IDs
    document.getElementById('qAddSelectedBtn')?.addEventListener('click', function () {
        if (selectedIds.size === 0) return;
        document.getElementById('selectedIdsInput').value = Array.from(selectedIds).join(',');
        document.getElementById('addQuestionsForm').submit();
    });
})();

// ── Section pool badges ───────────────────────────────────────────────────────
document.querySelectorAll('.pool-badge').forEach(function(badge) {
    const sectionId = badge.dataset.sectionId;
    if (!sectionId) return;
    fetch(`?handler=SectionPool&sectionId=${sectionId}`, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.ok ? r.json() : null)
    .then(data => {
        if (!data) { badge.textContent = '?'; return; }
        const count = data.count;
        badge.textContent = count >= 0 ? count + ' avail.' : '?';
        if (count >= 0) {
            const row = badge.closest('tr');
            const needed = parseInt(row ? row.querySelectorAll('td')[4]?.textContent ?? '0' : '0', 10);
            badge.className = 'pool-badge badge border ' + (count >= needed
                ? 'bg-success-subtle text-success border-success-subtle'
                : 'bg-danger-subtle text-danger border-danger-subtle');
        }
    })
    .catch(() => { badge.textContent = '?'; });
});
</script>
}
