@page "{testId:guid}"
@model GridAcademy.Pages.Admin.Content.Tests.Questions.IndexModel
@using GridAcademy.Data.Entities.Content
@using GridAcademy.Data.Entities.Assessment
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = $"Questions — {Model.Test?.Title ?? "Test"}";
    int  totalPages  = (int)Math.Ceiling((double)(Model.Questions.TotalCount) / IndexModel.PageSize);
    var  sections    = Model.Test?.Sections ?? [];
    bool isPublished = Model.Test?.Status == TestStatus.Published;
    bool isManual    = Model.Test?.QuestionMode == GridAcademy.Data.Entities.Assessment.QuestionMode.Manual;

    string StripHtml(string? html) =>
        Regex.Replace(html ?? "", "<[^>]+>", " ").Replace("  ", " ").Trim();

    string TextPreview(string? text, int max = 130)
    {
        var plain = StripHtml(text);
        return plain.Length > max ? plain[..max] + "…" : plain;
    }
}

<!-- ── Page header ─────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-patch-question me-2 text-primary"></i>Manage Questions
        </h4>
        <p class="text-muted small mb-0">
            <a asp-page="/Admin/Content/Tests/Edit" asp-route-id="@Model.TestId"
               class="text-decoration-none text-muted">
                <i class="bi bi-arrow-left me-1"></i>@(Model.Test?.Title ?? "Test")
            </a>
            &nbsp;·&nbsp; @Model.Questions.TotalCount mapped question(s)
            &nbsp;·&nbsp; @sections.Count section(s)
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a asp-page="/Admin/Content/Import/Index"
           asp-route-testId="@Model.TestId"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-cloud-upload me-1"></i>Import
        </a>
        <a asp-page="Browse"
           asp-route-testId="@Model.TestId"
           class="btn btn-outline-primary btn-sm">
            <i class="bi bi-bank me-1"></i>Add from Bank
        </a>
        <a asp-page="/Admin/Content/Questions/Create"
           asp-route-testId="@Model.TestId"
           class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Add Question
        </a>
    </div>
</div>

@if (TempData["Success"] is string succ)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-1"></i>@succ
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════════════
     SECTIONS PANEL
     ══════════════════════════════════════════════════════════════════════ -->
<div class="card shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2"
         style="cursor:pointer" data-bs-toggle="collapse" data-bs-target="#sectionsCollapse" aria-expanded="@(sections.Count == 0 ? "true" : "false")">
        <span class="fw-semibold">
            <i class="bi bi-grid-3x3-gap me-2 text-primary"></i>Sections
            @if (sections.Count > 0)
            {
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1">@sections.Count</span>
            }
            @if (isManual)
            {
                <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size:0.7rem">Manual — name only</span>
            }
            else
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size:0.7rem">Global Bank</span>
            }
        </span>
        <i class="bi bi-chevron-down small text-muted"></i>
    </div>
    <div class="collapse @(sections.Count == 0 ? "show" : "")" id="sectionsCollapse">
        <div class="card-body pt-2 pb-3">

            @if (sections.Count == 0)
            {
                <div class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    @if (isManual)
                    {
                        <text>No sections yet. Add named sections below so you can assign questions to them. In Manual mode, section assignment is <strong>required</strong> for each question.</text>
                    }
                    else
                    {
                        <text>No sections yet. Sections let you organise questions into groups (e.g. "Reasoning", "Maths", "GK"). Questions can then be assigned to a section below.</text>
                    }
                </div>
            }
            else
            {
                <!-- Existing sections list -->
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Section Name</th>
                                @if (!isManual)
                                {
                                    <th>Subject</th>
                                    <th>Difficulty</th>
                                    <th class="text-center">Questions Needed</th>
                                    <th class="text-center">Marks/Q</th>
                                    <th class="text-center">Neg/Q</th>
                                }
                                @if (!isPublished) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var sec in sections.OrderBy(s => s.SortOrder).ThenBy(s => s.Id))
                        {
                            <tr>
                                <td class="fw-semibold">@sec.Name</td>
                                @if (!isManual)
                                {
                                    <td class="small">@sec.SubjectName</td>
                                    <td class="small text-muted">@(sec.DifficultyLevelName ?? "Any")</td>
                                    <td class="text-center small">@sec.QuestionCount</td>
                                    <td class="text-center small text-success fw-semibold">+@sec.MarksPerQuestion</td>
                                    <td class="text-center small text-danger">-@sec.NegativeMarksPerQuestion</td>
                                }
                                @if (!isPublished)
                                {
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="DeleteSection"
                                              onsubmit="return confirm('Remove section \'@sec.Name\'? Questions assigned to it will become unassigned.')">
                                            <input type="hidden" name="sectionId" value="@sec.Id" />
                                            <button class="btn btn-xs btn-outline-danger btn-sm" title="Delete section">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            @if (!isPublished)
            {
                if (isManual)
                {
                    <!-- Manual mode: name-only section form -->
                    <form method="post" asp-page-handler="AddSection" class="border rounded p-3 bg-light">
                        <p class="fw-semibold small mb-2"><i class="bi bi-plus-circle me-1 text-primary"></i>Add New Section</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-sm-5">
                                <label class="form-label form-label-sm mb-1">Section Name <span class="text-danger">*</span></label>
                                <input asp-for="SectionForm.Name" class="form-control form-control-sm"
                                       placeholder="e.g. Reasoning, Maths, GK" required />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i>Add Section
                                </button>
                            </div>
                        </div>
                        <div class="form-text text-info-emphasis mt-1">
                            <i class="bi bi-info-circle me-1"></i>In Manual mode, sections are just named groups — no subject or criteria needed.
                        </div>
                    </form>
                }
                else
                {
                    <!-- GlobalBank mode: full form -->
                    <form method="post" asp-page-handler="AddSection" class="border rounded p-3 bg-light">
                        <p class="fw-semibold small mb-2"><i class="bi bi-plus-circle me-1 text-primary"></i>Add New Section</p>
                        <div class="row g-2 align-items-end">
                            <div class="col-12 col-sm-3">
                                <label class="form-label form-label-sm mb-1">Name <span class="text-danger">*</span></label>
                                <input asp-for="SectionForm.Name" class="form-control form-control-sm"
                                       placeholder="e.g. Reasoning" required />
                            </div>
                            <div class="col-6 col-sm-2">
                                <label class="form-label form-label-sm mb-1">Subject <span class="text-danger">*</span></label>
                                <select asp-for="SectionForm.SubjectId" class="form-select form-select-sm" required>
                                    <option value="">— select —</option>
                                    @foreach (var s in Model.Subjects)
                                    { <option value="@s.Id">@s.Name</option> }
                                </select>
                            </div>
                            <div class="col-6 col-sm-2">
                                <label class="form-label form-label-sm mb-1">Difficulty</label>
                                <select asp-for="SectionForm.DifficultyLevelId" class="form-select form-select-sm">
                                    <option value="">Any</option>
                                    @foreach (var d in Model.DifficultyLevels)
                                    { <option value="@d.Id">@d.Name</option> }
                                </select>
                            </div>
                            <div class="col-4 col-sm-1">
                                <label class="form-label form-label-sm mb-1">Q Count</label>
                                <input asp-for="SectionForm.QuestionCount" type="number" min="1"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-4 col-sm-1">
                                <label class="form-label form-label-sm mb-1">+Marks</label>
                                <input asp-for="SectionForm.MarksPerQuestion" type="number" min="0" step="0.25"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-4 col-sm-1">
                                <label class="form-label form-label-sm mb-1">-Marks</label>
                                <input asp-for="SectionForm.NegativeMarksPerQuestion" type="number" min="0" step="0.25"
                                       class="form-control form-control-sm" />
                            </div>
                            <div class="col-auto">
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-lg me-1"></i>Add
                                </button>
                            </div>
                        </div>
                    </form>
                }
            }
        </div>
    </div>
</div>

<!-- ── Filter bar ──────────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="testId" value="@Model.TestId" />
            <div class="col-12 col-md-3">
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Search question text…" />
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="SubjectId" class="form-select form-select-sm">
                    <option value="">All Subjects</option>
                    @foreach (var s in Model.Subjects)
                    { <option value="@s.Id" selected="@(Model.SubjectId == s.Id)">@s.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="TopicId" class="form-select form-select-sm">
                    <option value="">All Topics</option>
                    @foreach (var t in Model.Topics)
                    { <option value="@t.Id" selected="@(Model.TopicId == t.Id)">@t.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="DifficultyLevelId" class="form-select form-select-sm">
                    <option value="">All Difficulties</option>
                    @foreach (var d in Model.DifficultyLevels)
                    { <option value="@d.Id" selected="@(Model.DifficultyLevelId == d.Id)">@d.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-1">
                <select asp-for="Status" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="1" selected="@(Model.Status == QuestionStatus.Draft)">Draft</option>
                    <option value="2" selected="@(Model.Status == QuestionStatus.Published)">Published</option>
                </select>
            </div>
            <div class="col-6 col-md-1">
                <select asp-for="QuestionType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="1" selected="@(Model.QuestionType == QuestionType.MCQ)">MCQ</option>
                    <option value="2" selected="@(Model.QuestionType == QuestionType.MSQ)">MSQ</option>
                    <option value="3" selected="@(Model.QuestionType == QuestionType.NAT)">NAT</option>
                    <option value="4" selected="@(Model.QuestionType == QuestionType.FillInBlanks)">Fill Blanks</option>
                    <option value="5" selected="@(Model.QuestionType == QuestionType.TrueFalse)">True/False</option>
                    <option value="6" selected="@(Model.QuestionType == QuestionType.MatchTheFollowing)">Match</option>
                    <option value="7" selected="@(Model.QuestionType == QuestionType.AssertionReason)">Assert/Reason</option>
                    <option value="8" selected="@(Model.QuestionType == QuestionType.PassageBased)">Passage</option>
                    <option value="9" selected="@(Model.QuestionType == QuestionType.MatrixMatch)">Matrix</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-1">
                <button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
                <a asp-page="/Admin/Content/Tests/Questions/Index"
                   asp-route-testId="@Model.TestId"
                   class="btn btn-sm btn-outline-secondary" title="Clear filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ── Questions table ─────────────────────────────────────────────────── -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Questions.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size:2.5rem;opacity:0.4"></i>
                <p class="text-muted mt-2 mb-0">
                    No questions mapped to this test yet.<br />
                    <a asp-page="Browse" asp-route-testId="@Model.TestId">Pick from the global bank</a>
                    or
                    <a asp-page="/Admin/Content/Questions/Create" asp-route-testId="@Model.TestId">create a new question</a>.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:35%">Question</th>
                            <th>Subject / Topic</th>
                            <th>Type</th>
                            <th>Difficulty</th>
                            <th>Marks</th>
                            <th>Section</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{
                        // Track passage groups so we only show the passage header once per group
                        Guid? lastPassageId = null;
                        int   passageSubIdx = 0;
                    }
                    @foreach (var q in Model.Questions.Items)
                    {
                        @* Passage-based: show a passage header row the first time we see a new passageId *@
                        @if (q.QuestionType == QuestionType.PassageBased && q.Passage != null)
                        {
                            if (q.Passage.Id != lastPassageId)
                            {
                                lastPassageId = q.Passage.Id;
                                passageSubIdx = 0;
                                <tr class="table-info">
                                    <td colspan="8" class="py-1 px-3">
                                        <span class="badge bg-primary me-2" style="font-size:.7rem">PASSAGE</span>
                                        <span class="small fw-semibold">
                                            @(string.IsNullOrWhiteSpace(q.Passage.Title)
                                                ? TextPreview(q.Passage.PassageText, 100)
                                                : q.Passage.Title)
                                        </span>
                                        <span class="text-muted small ms-2" style="font-size:.7rem">ID: @q.Passage.Id.ToString()[..8]…</span>
                                    </td>
                                </tr>
                            }
                            passageSubIdx++;
                        }
                        else
                        {
                            lastPassageId = null;
                            passageSubIdx = 0;
                        }

                        @* Look up the SectionId for this question from the mapped list *@
                        @* We use the QuestionDto which doesn't have SectionId — we rely on the Section dropdown values *@
                        <tr @(q.QuestionType == QuestionType.PassageBased ? "class=\"table-light\"" : "")>
                            <td>
                                <div class="fw-semibold small" style="max-width:320px">
                                    @if (q.QuestionType == QuestionType.PassageBased)
                                    {
                                        <span class="text-muted me-1" style="font-size:.75rem">Q@(passageSubIdx).</span>
                                    }
                                    @TextPreview(q.Text)
                                </div>
                                @if (q.Tags.Any())
                                {
                                    foreach (var tag in q.Tags.Take(3))
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle me-1" style="font-size:0.65rem">@tag.Name</span>
                                    }
                                }
                            </td>
                            <td class="small">
                                <div>@q.SubjectName</div>
                                <div class="text-muted">@q.TopicName</div>
                            </td>
                            <td>
                                @{
                                    var (typeBadge, typeLabel) = q.QuestionType switch {
                                        QuestionType.MCQ               => ("bg-primary-subtle text-primary border-primary-subtle",      "MCQ"),
                                        QuestionType.MSQ               => ("bg-warning-subtle text-warning border-warning-subtle",      "MSQ"),
                                        QuestionType.NAT               => ("bg-secondary-subtle text-secondary border-secondary-subtle","NAT"),
                                        QuestionType.FillInBlanks      => ("bg-info-subtle text-info border-info-subtle",               "FIB"),
                                        QuestionType.TrueFalse         => ("bg-success-subtle text-success border-success-subtle",      "T/F"),
                                        QuestionType.MatchTheFollowing => ("bg-light text-dark border-secondary",                      "MTF"),
                                        QuestionType.AssertionReason   => ("bg-danger-subtle text-danger border-danger-subtle",         "ANR"),
                                        QuestionType.PassageBased      => ("bg-light text-dark border-secondary",                      "PBQ"),
                                        QuestionType.MatrixMatch       => ("bg-light text-dark border-secondary",                      "MMQ"),
                                        _                              => ("bg-light text-dark border-secondary",                      "?")
                                    };
                                }
                                <span class="badge border @typeBadge small">@typeLabel</span>
                            </td>
                            <td class="small text-muted">@q.DifficultyLevel</td>
                            <td class="small">
                                <span class="text-success fw-semibold">+@q.Marks</span>
                                @if (q.NegativeMarks != 0)
                                { <span class="text-danger ms-1">@q.NegativeMarks</span> }
                            </td>

                            <!-- ── Section assignment ──────────────────── -->
                            <td>
                                @if (sections.Count > 0 && (!isPublished || isManual))
                                {
                                    @* Manual mode: allow reassignment even when published (no pool logic involved).
                                       GlobalBank draft: also allow. GlobalBank published: read-only below. *@
                                    <form method="post" asp-page-handler="AssignSection" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="questionId" value="@q.Id" />
                                        <select name="sectionId" class="form-select form-select-sm sec-select"
                                                style="min-width:110px;max-width:150px"
                                                data-qid="@q.Id"
                                                onchange="this.form.submit()" title="Assign to section"
                                                @(isManual ? "required" : "")>
                                            @if (!isManual)
                                            {
                                                <option value="0">— none —</option>
                                            }
                                            @foreach (var sec in sections.OrderBy(s => s.SortOrder))
                                            {
                                                <option value="@sec.Id">@sec.Name</option>
                                            }
                                        </select>
                                    </form>
                                }
                                else if (sections.Count > 0 && isPublished)
                                {
                                    @* GlobalBank published — show read-only badge; JS fills in the name *@
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle small sec-badge" id="secbadge-@q.Id" data-qid="@q.Id">—</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <td>
                                @if (q.Status == QuestionStatus.Published)
                                { <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span> }
                                else
                                { <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Draft</span> }
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end flex-wrap">
                                    <a asp-page="/Admin/Content/Questions/Create"
                                       asp-route-id="@q.Id"
                                       asp-route-testId="@Model.TestId"
                                       class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (q.Status == QuestionStatus.Draft)
                                    {
                                        <form method="post" asp-page-handler="Publish">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button class="btn btn-sm btn-outline-success" title="Publish">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Unpublish">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button class="btn btn-sm btn-outline-warning" title="Unpublish">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="Remove"
                                          onsubmit="return confirm('Remove from test? (Question stays in the bank)')">
                                        <input type="hidden" name="id" value="@q.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" title="Remove from test">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('Delete permanently? Cannot be undone.')">
                                            <input type="hidden" name="id" value="@q.Id" />
                                            <button class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Showing @((Model.CurrentPage - 1) * IndexModel.PageSize + 1)–@(Math.Min(Model.CurrentPage * IndexModel.PageSize, Model.Questions.TotalCount))
                of @Model.Questions.TotalCount
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Admin/Content/Tests/Questions/Index"
                           asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["Status"]=((int?)Model.Status)?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=(Model.CurrentPage-1).ToString() })">
                            &laquo;
                        </a>
                    </li>
                    @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(totalPages, Model.CurrentPage + 2); p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="/Admin/Content/Tests/Questions/Index"
                               asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["Status"]=((int?)Model.Status)?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=p.ToString() })">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-page="/Admin/Content/Tests/Questions/Index"
                           asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["Status"]=((int?)Model.Status)?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=(Model.CurrentPage+1).ToString() })">
                            &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    // ── Pre-select section dropdowns AND update read-only badges via AJAX ─
    const testId = '@Model.TestId';
    if (!testId) return;

    // Build a sectionId → name lookup from the rendered sections
    const sectionNames = {};
    @foreach (var sec in sections)
    {
        <text>sectionNames[@sec.Id] = '@Html.Raw(sec.Name.Replace("'", "\\'"))';</text>
    }

    fetch('?handler=TestQuestions&testId=' + testId, {
        headers: { 'Accept': 'application/json' }
    })
    .then(function(r) { return r.ok ? r.json() : []; })
    .then(function(mappings) {
        mappings.forEach(function(m) {
            if (!m.sectionId) return;

            // ── Editable dropdown (draft / Manual-published) ──────────────
            const sel = document.querySelector('.sec-select[data-qid="' + m.questionId + '"]');
            if (sel) sel.value = String(m.sectionId);

            // ── Read-only badge (GlobalBank published) ────────────────────
            const badge = document.querySelector('.sec-badge[id="secbadge-' + m.questionId + '"]')
                       || document.getElementById('secbadge-' + m.questionId);
            if (badge) {
                const name = sectionNames[m.sectionId] || ('Section ' + m.sectionId);
                badge.textContent = name;
                badge.classList.remove('bg-secondary-subtle', 'text-secondary');
                badge.classList.add('bg-primary-subtle', 'text-primary');
            }
        });
    })
    .catch(function() { /* silently ignore */ });
})();
</script>
}
