@page "{testId:guid}"
@model GridAcademy.Pages.Admin.Content.Tests.Questions.BrowseModel
@using GridAcademy.Data.Entities.Content
@using GridAcademy.Data.Entities.Assessment
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = $"Question Bank — {Model.TestTitle}";
    int  totalPages = (int)Math.Ceiling((double)(Model.Questions.TotalCount) / BrowseModel.PageSize);
    bool isManual   = Model.TestQuestionMode == QuestionMode.Manual;

    string StripHtml(string? html) =>
        Regex.Replace(html ?? "", "<[^>]+>", " ").Replace("  ", " ").Trim();

    string TextPreview(string? text, int max = 120)
    {
        var plain = StripHtml(text);
        return plain.Length > max ? plain[..max] + "…" : plain;
    }
}

<!-- ── Page header ─────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-bank me-2 text-primary"></i>Global Question Bank
        </h4>
        <p class="text-muted small mb-0">
            <a asp-page="Index" asp-route-testId="@Model.TestId"
               class="text-decoration-none text-muted">
                <i class="bi bi-arrow-left me-1"></i>@Model.TestTitle
            </a>
            &nbsp;·&nbsp; Select questions to add to this test
        </p>
    </div>
    <a asp-page="Index" asp-route-testId="@Model.TestId"
       class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-x-lg me-1"></i>Cancel
    </a>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-circle me-1"></i>@err
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ── Filter bar ──────────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end" id="filterForm">
            <input type="hidden" name="testId" value="@Model.TestId" />
            <div class="col-12 col-md-3">
                <input asp-for="Search" class="form-control form-control-sm" placeholder="Search question text…" />
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="SubjectId" class="form-select form-select-sm" id="filterSubject">
                    <option value="">All Subjects</option>
                    @foreach (var s in Model.Subjects)
                    { <option value="@s.Id" selected="@(Model.SubjectId == s.Id)">@s.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="TopicId" class="form-select form-select-sm" id="filterTopic">
                    <option value="">All Topics</option>
                    @foreach (var t in Model.Topics)
                    { <option value="@t.Id" selected="@(Model.TopicId == t.Id)">@t.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="DifficultyLevelId" class="form-select form-select-sm">
                    <option value="">All Difficulties</option>
                    @foreach (var d in Model.DifficultyLevels)
                    { <option value="@d.Id" selected="@(Model.DifficultyLevelId == d.Id)">@d.Name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select asp-for="QuestionType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="1" selected="@(Model.QuestionType == QuestionType.MCQ)">MCQ</option>
                    <option value="2" selected="@(Model.QuestionType == QuestionType.MSQ)">MSQ</option>
                    <option value="3" selected="@(Model.QuestionType == QuestionType.NAT)">NAT</option>
                    <option value="4" selected="@(Model.QuestionType == QuestionType.FillInBlanks)">Fill Blanks</option>
                    <option value="5" selected="@(Model.QuestionType == QuestionType.TrueFalse)">True/False</option>
                    <option value="6" selected="@(Model.QuestionType == QuestionType.MatchTheFollowing)">Match</option>
                    <option value="7" selected="@(Model.QuestionType == QuestionType.AssertionReason)">Assert/Reason</option>
                    <option value="8" selected="@(Model.QuestionType == QuestionType.PassageBased)">Passage</option>
                    <option value="9" selected="@(Model.QuestionType == QuestionType.MatrixMatch)">Matrix</option>
                </select>
            </div>
            <div class="col-auto d-flex gap-1">
                <button class="btn btn-sm btn-primary"><i class="bi bi-search"></i></button>
                <a asp-page="Browse" asp-route-testId="@Model.TestId"
                   class="btn btn-sm btn-outline-secondary" title="Clear filters">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- ── Main form (checkboxes + submit) ─────────────────────────────────── -->
<form method="post" asp-page-handler="Add" id="addForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="TestId"    value="@Model.TestId" />
    <input type="hidden" name="SectionId" value="0" id="hiddenSectionId" />

    <!-- ── Sticky action bar ────────────────────────────────────────────── -->
    <div id="stickyBar"
         class="card shadow border-primary mb-3"
         style="position:sticky;top:60px;z-index:100;display:none">
        <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-semibold text-primary">
                <i class="bi bi-check2-square me-1"></i>
                <span id="selectedCount">0</span> question(s) selected
            </span>
            @if (Model.Sections.Count > 0)
            {
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <label class="form-label mb-0 small fw-semibold text-nowrap">
                        Section:
                        @if (isManual) { <span class="text-danger">*</span> }
                    </label>
                    <select name="SectionId" class="form-select form-select-sm" style="min-width:160px"
                            id="stickySection" @(isManual ? "required" : "")>
                        @if (!isManual) { <option value="0">— none —</option> }
                        @foreach (var sec in Model.Sections.OrderBy(s => s.SortOrder))
                        { <option value="@sec.Id">@sec.Name</option> }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" id="stickyAddBtn">
                    <i class="bi bi-plus-lg me-1"></i>Add to Test
                </button>
            }
            else if (isManual)
            {
                <div class="alert alert-warning py-1 px-2 mb-0 ms-auto small">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    No sections found. <a asp-page="/Admin/Content/Tests/Edit" asp-route-id="@Model.TestId" class="alert-link">Create sections on the Edit page</a> before adding questions.
                </div>
            }
            else
            {
                <button type="submit" class="btn btn-primary btn-sm ms-auto">
                    <i class="bi bi-plus-lg me-1"></i>Add Selected to Test
                </button>
            }
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearAll()">
                <i class="bi bi-x me-1"></i>Clear
            </button>
        </div>
    </div>

    <!-- ── Questions table ──────────────────────────────────────────────── -->
    <div class="card shadow-sm">
        @if (!Model.Questions.Items.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size:2.5rem;opacity:0.4"></i>
                <p class="text-muted mt-2 mb-0">No published questions found matching your filters.</p>
            </div>
        }
        else
        {
            <div class="card-header bg-white d-flex align-items-center gap-3 py-2">
                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="selectAll" title="Select / deselect all unmapped questions on this page" />
                    <label class="form-check-label small text-muted" for="selectAll">Select all</label>
                </div>
                <span class="text-muted small ms-auto">
                    Showing @((Model.CurrentPage - 1) * BrowseModel.PageSize + 1)–@(Math.Min(Model.CurrentPage * BrowseModel.PageSize, Model.Questions.TotalCount))
                    of @Model.Questions.TotalCount published question(s)
                    @if (Model.MappedIds.Count > 0)
                    { <span>· <span class="text-success fw-semibold">@Model.MappedIds.Count already in test</span></span> }
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:42px"></th>
                            <th style="width:42%">Question</th>
                            <th>Subject / Topic</th>
                            <th>Type</th>
                            <th>Difficulty</th>
                            <th>Marks</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var q in Model.Questions.Items)
                    {
                        bool alreadyMapped = Model.MappedIds.Contains(q.Id);
                        <tr class="@(alreadyMapped ? "table-success" : "")">
                            <td class="text-center">
                                @if (alreadyMapped)
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5" title="Already in this test"></i>
                                }
                                else
                                {
                                    <input class="form-check-input question-chk" type="checkbox"
                                           name="SelectedIds" value="@q.Id"
                                           title="Select to add" />
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small" style="max-width:380px">
                                    @TextPreview(q.Text)
                                </div>
                                @if (alreadyMapped)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle"
                                          style="font-size:0.65rem">
                                        <i class="bi bi-check2 me-1"></i>Already in test
                                    </span>
                                }
                                @foreach (var tag in q.Tags.Take(3))
                                {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle ms-1"
                                          style="font-size:0.65rem">@tag.Name</span>
                                }
                            </td>
                            <td class="small">
                                <div>@q.SubjectName</div>
                                <div class="text-muted">@q.TopicName</div>
                            </td>
                            <td>
                                @{
                                    var (typeBadge, typeLabel) = q.QuestionType switch {
                                        QuestionType.MCQ               => ("bg-primary-subtle text-primary border-primary-subtle",      "MCQ"),
                                        QuestionType.MSQ               => ("bg-warning-subtle text-warning border-warning-subtle",      "MSQ"),
                                        QuestionType.NAT               => ("bg-secondary-subtle text-secondary border-secondary-subtle","NAT"),
                                        QuestionType.FillInBlanks      => ("bg-info-subtle text-info border-info-subtle",               "FIB"),
                                        QuestionType.TrueFalse         => ("bg-success-subtle text-success border-success-subtle",      "T/F"),
                                        QuestionType.MatchTheFollowing => ("bg-light text-dark border-secondary",                      "MTF"),
                                        QuestionType.AssertionReason   => ("bg-danger-subtle text-danger border-danger-subtle",         "ANR"),
                                        QuestionType.PassageBased      => ("bg-light text-dark border-secondary",                      "PBQ"),
                                        QuestionType.MatrixMatch       => ("bg-light text-dark border-secondary",                      "MMQ"),
                                        _                              => ("bg-light text-dark border-secondary",                      "?")
                                    };
                                }
                                <span class="badge border @typeBadge small">@typeLabel</span>
                            </td>
                            <td class="small text-muted">@q.DifficultyLevel</td>
                            <td class="small">
                                <span class="text-success fw-semibold">+@q.Marks</span>
                                @if (q.NegativeMarks != 0)
                                { <span class="text-danger ms-1">@q.NegativeMarks</span> }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- ── Bottom action bar ─────────────────────────────────────── -->
            <div class="card-footer bg-white d-flex align-items-center justify-content-between gap-2">
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="Browse"
                                   asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=(Model.CurrentPage-1).ToString() })">
                                    &laquo;
                                </a>
                            </li>
                            @for (int p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(totalPages, Model.CurrentPage + 2); p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="Browse"
                                       asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=p.ToString() })">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="Browse"
                                   asp-all-route-data="@(new Dictionary<string,string?> { ["testId"]=Model.TestId.ToString(), ["Search"]=Model.Search, ["SubjectId"]=Model.SubjectId?.ToString(), ["TopicId"]=Model.TopicId?.ToString(), ["DifficultyLevelId"]=Model.DifficultyLevelId?.ToString(), ["QuestionType"]=((int?)Model.QuestionType)?.ToString(), ["CurrentPage"]=(Model.CurrentPage+1).ToString() })">
                                    &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
                else
                {
                    <span></span>
                }

                <!-- Add button (bottom) -->
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (Model.Sections.Count > 0)
                    {
                        <label class="form-label mb-0 small fw-semibold text-nowrap">
                            Section:
                            @if (isManual) { <span class="text-danger">*</span> }
                        </label>
                        <select class="form-select form-select-sm" style="min-width:150px" id="bottomSection"
                                @(isManual ? "required" : "")
                                onchange="document.getElementById('hiddenSectionId').value = this.value; var s=document.getElementById('stickySection'); if(s) s.value=this.value; updateCounts();">
                            @if (!isManual) { <option value="0">— none —</option> }
                            @foreach (var sec in Model.Sections.OrderBy(s => s.SortOrder))
                            { <option value="@sec.Id">@sec.Name</option> }
                        </select>
                        @* For Manual mode with sections: set hidden input to first section by default *@
                        @if (isManual && Model.Sections.Count > 0)
                        {
                            <script>document.getElementById('hiddenSectionId').value = '@Model.Sections.OrderBy(s => s.SortOrder).First().Id';</script>
                        }
                    }
                    <span class="text-muted small" id="bottomCount" style="display:none">
                        <span id="bottomCountNum">0</span> selected
                    </span>
                    <button type="submit" class="btn btn-primary btn-sm" id="bottomAddBtn" disabled>
                        <i class="bi bi-plus-lg me-1"></i>Add Selected to Test
                    </button>
                </div>
            </div>
        }
    </div>
</form>

@section Scripts {
<script>
(function () {
    const checkboxes    = document.querySelectorAll('.question-chk');
    const selectAllChk  = document.getElementById('selectAll');
    const stickyBar     = document.getElementById('stickyBar');
    const selectedCount = document.getElementById('selectedCount');
    const bottomCount   = document.getElementById('bottomCount');
    const bottomCountNum= document.getElementById('bottomCountNum');
    const bottomAddBtn  = document.getElementById('bottomAddBtn');
    const isManual      = @(isManual ? "true" : "false");

    function isSectionSelected() {
        const h = document.getElementById('hiddenSectionId');
        return !isManual || (h && h.value && h.value !== '0' && h.value !== '');
    }

    function updateCounts() {
        const n = document.querySelectorAll('.question-chk:checked').length;
        if (selectedCount) selectedCount.textContent = n;
        if (bottomCountNum) bottomCountNum.textContent = n;

        const show = n > 0;
        if (stickyBar)    stickyBar.style.display    = show ? '' : 'none';
        if (bottomCount)  bottomCount.style.display  = show ? '' : 'none';
        // In manual mode: also require a section to be selected
        if (bottomAddBtn) bottomAddBtn.disabled = !(show && isSectionSelected());

        // Update select-all indeterminate state
        if (selectAllChk) {
            const total = checkboxes.length;
            if (n === 0)     { selectAllChk.checked = false; selectAllChk.indeterminate = false; }
            else if (n === total) { selectAllChk.checked = true;  selectAllChk.indeterminate = false; }
            else             { selectAllChk.checked = false; selectAllChk.indeterminate = true; }
        }
    }

    checkboxes.forEach(function (chk) {
        chk.addEventListener('change', updateCounts);
        // Make clicking the whole row toggle the checkbox
        const row = chk.closest('tr');
        if (row) {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function (e) {
                if (e.target === chk || e.target.tagName === 'A' || e.target.tagName === 'BUTTON') return;
                chk.checked = !chk.checked;
                updateCounts();
            });
        }
    });

    if (selectAllChk) {
        selectAllChk.addEventListener('change', function () {
            checkboxes.forEach(function (chk) { chk.checked = selectAllChk.checked; });
            updateCounts();
        });
    }

    window.clearAll = function () {
        checkboxes.forEach(function (chk) { chk.checked = false; });
        if (selectAllChk) { selectAllChk.checked = false; selectAllChk.indeterminate = false; }
        updateCounts();
    };

    // Keep sticky + bottom section selectors in sync with the hidden input
    const stickySection = document.getElementById('stickySection');
    const bottomSection = document.getElementById('bottomSection');
    const hiddenSection = document.getElementById('hiddenSectionId');
    if (stickySection) {
        stickySection.addEventListener('change', function () {
            if (hiddenSection) hiddenSection.value = stickySection.value;
            if (bottomSection) bottomSection.value = stickySection.value;
        });
    }
    if (bottomSection) {
        bottomSection.addEventListener('change', function () {
            if (hiddenSection) hiddenSection.value = bottomSection.value;
            if (stickySection) stickySection.value = bottomSection.value;
        });
    }

    updateCounts();
})();
</script>
}
