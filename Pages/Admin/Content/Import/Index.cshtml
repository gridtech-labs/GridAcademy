@page
@model GridAcademy.Pages.Admin.Content.Import.IndexModel
@{
    ViewData["Title"] = "Import Questions";
    var src = Model.ActiveSource ?? "csv";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-cloud-upload me-2 text-primary"></i>Import Questions</h4>
        <p class="text-muted small mb-0">Bulk-upload questions from CSV, Excel, or PDF files</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/samples/questions-template.csv" class="btn btn-sm btn-outline-success" download="questions-template.csv">
            <i class="bi bi-filetype-csv me-1"></i>CSV Template
        </a>
        <a asp-page-handler="ExcelTemplate" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Excel Template
        </a>
    </div>
</div>

<!-- ── Destination Selector ────────────────────────────────────────────────── -->
<div class="card shadow-sm mb-4 border-primary border-opacity-25">
    <div class="card-header bg-primary-subtle fw-semibold py-3">
        <i class="bi bi-arrow-right-square me-2"></i>Import Destination
    </div>
    <div class="card-body py-3">
        <div class="d-flex flex-wrap gap-4 align-items-start">
            <!-- Radio: Global Bank -->
            <div class="form-check mt-1">
                <input class="form-check-input" type="radio" name="destination" id="destGlobal"
                       value="global" checked onchange="onDestinationChange(this.value)">
                <label class="form-check-label" for="destGlobal">
                    <span class="fw-semibold">Global Question Bank</span>
                    <span class="d-block text-muted small">Questions go into the shared bank (default)</span>
                </label>
            </div>

            <!-- Radio: Map to Test -->
            <div class="form-check mt-1">
                <input class="form-check-input" type="radio" name="destination" id="destTest"
                       value="test" onchange="onDestinationChange(this.value)">
                <label class="form-check-label" for="destTest">
                    <span class="fw-semibold">Map to a Specific Test</span>
                    <span class="d-block text-muted small">Also link directly to a test's question set</span>
                </label>
            </div>

            <!-- Test dropdown — shown when "Map to Test" is selected -->
            <div id="testSelectWrapper" class="flex-grow-1" style="display:none; min-width:260px;">
                <select id="testSelectDropdown" class="form-select form-select-sm"
                        onchange="onTestSelected(this.value)">
                    <option value="">— select a test —</option>
                    @foreach (var t in Model.AvailableTests)
                    {
                        <option value="@t.Id">@t.Title</option>
                    }
                </select>
                @if (!Model.AvailableTests.Any())
                {
                    <div class="form-text text-warning">
                        <i class="bi bi-exclamation-triangle me-1"></i>No tests found.
                        <a asp-page="/Admin/Tests/Create" class="text-decoration-none">Create a test first.</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ── Source tabs ────────────────────────────────────────────────────────── -->
<ul class="nav nav-tabs mb-3" id="importTabs">
    @foreach (var (id, label, icon) in new[] {
        ("csv",   "CSV",   "bi-filetype-csv"),
        ("excel", "Excel", "bi-file-earmark-spreadsheet"),
        ("pdf",   "PDF",   "bi-file-earmark-pdf"),
    })
    {
        <li class="nav-item">
            <button class="nav-link @(src == id ? "active" : "")"
                    data-bs-toggle="tab" data-bs-target="#tab-@id" type="button">
                <i class="bi @icon me-1"></i>@label
            </button>
        </li>
    }
    <li class="nav-item">
        <button class="nav-link @(src == "ocr" ? "active" : "")"
                data-bs-toggle="tab" data-bs-target="#tab-ocr" type="button">
            <i class="bi bi-cpu me-1"></i>PDF (OCR)
            @if (Model.MathpixConfigured)
            {
                <span class="badge bg-success ms-1" style="font-size:.65rem">Ready</span>
            }
            else
            {
                <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem">Setup needed</span>
            }
        </button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(src == "rrbalp" ? "active" : "")"
                data-bs-toggle="tab" data-bs-target="#tab-rrbalp" type="button">
            <i class="bi bi-train-front me-1"></i>RRB ALP
            <span class="badge bg-primary ms-1" style="font-size:.65rem">Custom Format</span>
        </button>
    </li>
</ul>

<div class="tab-content">

    @foreach (var (id, label, handler, accept, hint) in new[] {
        ("csv",   "CSV File",   "Csv",   ".csv,text/csv",
         "Each row = one question. Download the template above for the correct column order."),
        ("excel", "Excel File", "Excel", ".xlsx,.xls",
         "Same column layout as the CSV template but in .xlsx format. Row 1 must be headers."),
        ("pdf",   "PDF File",  "Pdf",   ".pdf",
         "Questions must follow the pattern: Q1. <text> (A) <opt> (B) <opt> … Answer: A. Works best with text-based (not scanned) PDFs."),
    })
    {
        <div class="tab-pane fade @(src == id ? "show active" : "")" id="tab-@id">
            <div class="card shadow-sm">
                <div class="card-header bg-white fw-semibold py-3">Upload @label</div>
                <div class="card-body">
                    <p class="text-muted small mb-3"><i class="bi bi-info-circle me-1"></i>@hint</p>
                    <form method="post" asp-page-handler="@handler" enctype="multipart/form-data"
                          class="import-form" data-source="@id">
                        @Html.AntiForgeryToken()
                        <!-- Hidden TestId — populated by JS from destination selector -->
                        <input type="hidden" name="TestId" class="testid-field" value="" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Select File</label>
                            <input type="file" name="file" class="form-control" accept="@accept" required />
                            <div class="form-text">Maximum file size: 10 MB</div>
                        </div>
                        <button type="submit" class="btn btn-primary import-submit-btn">
                            <i class="bi bi-upload me-1"></i>Import
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- ── OCR tab pane ───────────────────────────────────────────────── -->
    <div class="tab-pane fade @(src == "ocr" ? "show active" : "")" id="tab-ocr">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-3 d-flex align-items-center gap-2">
                PDF Import via Mathpix OCR
                @if (Model.MathpixConfigured)
                {
                    <span class="badge bg-success">API Configured</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Not Configured</span>
                }
            </div>
            <div class="card-body">

                @if (!Model.MathpixConfigured)
                {
                    <div class="alert alert-warning d-flex gap-3 align-items-start">
                        <i class="bi bi-exclamation-triangle-fill fs-4 flex-shrink-0"></i>
                        <div>
                            <div class="fw-semibold mb-1">Mathpix API credentials are not configured</div>
                            <ol class="mb-2 ps-3 small">
                                <li>Sign up at <strong>mathpix.com</strong> → go to <em>Dashboard → API Keys</em></li>
                                <li>Copy your <strong>App ID</strong> and <strong>App Key</strong></li>
                                <li>Open <code>appsettings.json</code> and fill in:</li>
                            </ol>
                            <pre class="bg-light rounded p-2 small mb-2" style="font-size:.8rem">"Mathpix": {
  "AppId":  "YOUR_APP_ID",
  "AppKey": "YOUR_APP_KEY"
}</pre>
                            <p class="mb-0 small text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Restart the application after saving. Mathpix offers a free tier —
                                a 60-question JEE paper costs roughly <strong>₹3–4</strong>.
                            </p>
                        </div>
                    </div>
                }

                <div class="alert alert-info small mb-3 d-flex gap-2 align-items-start">
                    <i class="bi bi-lightbulb flex-shrink-0 mt-1"></i>
                    <div>
                        <strong>How OCR import works:</strong>
                        The PDF is rendered image-by-image by Mathpix and all mathematical symbols
                        are recognised as proper LaTeX (e.g. <code>$\vec{B}$</code>,
                        <code>$\frac{\mu_0 I}{4\pi}$</code>). Use this when the regular
                        <em>PDF</em> tab produces garbled characters (◆ □ ⬧).
                        Processing takes <strong>15–60 seconds</strong> depending on paper length —
                        do not close the tab while waiting.
                    </div>
                </div>

                <form method="post" asp-page-handler="Ocr" enctype="multipart/form-data"
                      class="import-form @(!Model.MathpixConfigured ? "opacity-50 pe-none" : "")"
                      data-source="ocr">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TestId" class="testid-field" value="" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select PDF File</label>
                        <input type="file" name="file" class="form-control" accept=".pdf"
                               @(!Model.MathpixConfigured ? "disabled" : "") required />
                        <div class="form-text">Maximum file size: 20 MB</div>
                    </div>
                    <button type="submit" class="btn btn-primary import-submit-btn"
                            @(!Model.MathpixConfigured ? "disabled" : "")
                            onclick="if(!this.disabled){this.disabled=true;this.innerHTML='<span class=\'spinner-border spinner-border-sm me-2\'></span>Processing…';this.form.submit();}return false;">
                        <i class="bi bi-cpu me-1"></i>Import with OCR
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ── RRB ALP tab pane ───────────────────────────────────────────────── -->
    <div class="tab-pane fade @(src == "rrbalp" ? "show active" : "")" id="tab-rrbalp">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-3 d-flex align-items-center gap-2">
                <i class="bi bi-train-front text-primary"></i> RRB ALP Question Bank Import
                <span class="badge bg-success">Auto-creates 12 Test Papers</span>
            </div>
            <div class="card-body">
                <div class="alert alert-info d-flex gap-3 align-items-start mb-3">
                    <i class="bi bi-info-circle-fill fs-5 flex-shrink-0 mt-1"></i>
                    <div class="small">
                        <strong>What this importer does:</strong>
                        <ul class="mb-1 mt-1 ps-3">
                            <li>Reads the <strong>Master_Question_Bank</strong> sheet → imports all questions as <em>Published</em></li>
                            <li>Reads <strong>CBT1_Paper</strong>, <strong>CBT2_Paper</strong> sheets → creates 2 stage-wise practice tests</li>
                            <li>Reads <strong>Mock_Test_1 … Mock_Test_10</strong> → creates 10 mock test papers</li>
                            <li>Auto-seeds subjects/topics if any are missing</li>
                        </ul>
                        <strong>Required column order:</strong>
                        <code>QID | Question | Option A | Option B | Option C | Option D | Correct Answer | Subject | Topic | Difficulty | Marks | Negative Marks | Language</code>
                    </div>
                </div>
                <form method="post" asp-page-handler="RrbAlp" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Excel File (.xlsx)</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                        <div class="form-text">Max file size: 25 MB. Must have sheets: Master_Question_Bank, CBT1_Paper, CBT2_Paper, Mock_Test_1..10</div>
                    </div>
                    <button type="submit" class="btn btn-primary"
                            onclick="this.disabled=true;this.innerHTML='<span class=\'spinner-border spinner-border-sm me-2\'></span>Importing 1800+ questions… please wait';this.form.submit()">
                        <i class="bi bi-cloud-upload me-1"></i>Import RRB ALP Question Bank
                    </button>
                </form>
            </div>
        </div>
    </div>

</div>

<!-- ── Import Results ────────────────────────────────────────────────────── -->
@if (Model.Result != null)
{
    var r = Model.Result;
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Import Results — @r.Source</span>
            <small class="text-muted">@r.TotalRows row(s) processed</small>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(r.MappedTestName))
            {
                <div class="alert alert-success d-flex gap-2 align-items-center mb-3">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>
                        <strong>@r.Imported question(s) successfully added to "@r.MappedTestName".</strong>
                        <span class="d-block text-muted small">Questions are also saved to the global question bank.</span>
                    </div>
                </div>
            }
            @if (r.TestsCreated > 0)
            {
                <div class="alert alert-success d-flex gap-2 align-items-center mb-3">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>
                        <strong>@r.TestsCreated test paper(s) created automatically:</strong>
                        <ul class="mb-0 mt-1 ps-3 small">
                            @foreach (var name in r.TestNames) { <li>@name</li> }
                        </ul>
                    </div>
                </div>
            }
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="text-center p-3 bg-success-subtle rounded border border-success-subtle">
                        <div class="fw-bold fs-3 text-success">@r.Imported</div>
                        <div class="small text-muted">Imported</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="text-center p-3 bg-warning-subtle rounded border border-warning-subtle">
                        <div class="fw-bold fs-3 text-warning">@r.Skipped</div>
                        <div class="small text-muted">Skipped</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="text-center p-3 bg-danger-subtle rounded border border-danger-subtle">
                        <div class="fw-bold fs-3 text-danger">@r.Errors.Count</div>
                        <div class="small text-muted">Errors</div>
                    </div>
                </div>
            </div>

            @if (r.Errors.Any())
            {
                <h6 class="fw-semibold mb-2"><i class="bi bi-exclamation-triangle text-danger me-1"></i>Row Errors</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr><th style="width:60px">Row</th><th style="width:140px">Field</th><th>Message</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var e in r.Errors)
                        {
                            <tr>
                                <td class="text-muted">@e.Row</td>
                                <td class="fw-semibold">@e.Field</td>
                                <td class="text-danger small">@e.Message</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer bg-white">
            <a asp-page="/Admin/Content/Questions/Index" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-arrow-right me-1"></i>View Questions
            </a>
        </div>
    </div>
}

<!-- ── Question Type Reference ───────────────────────────────────────────── -->
<div class="card shadow-sm mt-4">
    <div class="card-header bg-white fw-semibold py-3">
        <i class="bi bi-info-circle text-primary me-2"></i>Valid Values Reference
    </div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-6">
                <h6 class="fw-semibold mb-2">QuestionType</h6>
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light"><tr><th>Value</th><th>Description</th></tr></thead>
                    <tbody>
                        <tr><td><code>MCQ</code></td><td>Single Correct — one answer from A–D</td></tr>
                        <tr><td><code>MSQ</code></td><td>Multiple Select — comma-separate CorrectOptions e.g. <code>A,C</code></td></tr>
                        <tr><td><code>NAT</code></td><td>Numerical Answer — leave options blank, fill NumericalAnswer</td></tr>
                        <tr><td><code>TrueFalse</code></td><td>OptionA=True, OptionB=False, CorrectOptions=A or B</td></tr>
                        <tr><td><code>FillInBlanks</code></td><td>Options are choices, CorrectOptions = correct letter</td></tr>
                        <tr><td><code>AssertionReason</code></td><td>Assertion + Reason evaluated together</td></tr>
                        <tr><td><code>PassageBased</code></td><td>Comprehension / paragraph based</td></tr>
                        <tr><td><code>MatrixMatch</code></td><td>Matrix match (many-to-many)</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="col-md-3">
                <h6 class="fw-semibold mb-2">Marks</h6>
                <ul class="list-unstyled small mb-3">
                    <li><code>1 Mark</code></li><li><code>2 Marks</code></li>
                    <li><code>3 Marks</code></li><li><code>4 Marks</code></li>
                </ul>
                <h6 class="fw-semibold mb-2">NegativeMarks</h6>
                <ul class="list-unstyled small mb-3">
                    <li><code>No Negative</code></li><li><code>-0.25 Marks</code></li>
                    <li><code>-1 Mark</code></li><li><code>-2 Marks</code></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="fw-semibold mb-2">DifficultyLevel</h6>
                <ul class="list-unstyled small mb-3">
                    <li><code>Easy</code></li><li><code>Medium</code></li><li><code>Hard</code></li>
                </ul>
                <h6 class="fw-semibold mb-2">ComplexityLevel</h6>
                <ul class="list-unstyled small mb-3">
                    <li><code>Low</code></li><li><code>Medium</code></li><li><code>High</code></li>
                </ul>
                <h6 class="fw-semibold mb-2">ExamType</h6>
                <ul class="list-unstyled small">
                    <li><code>JEE Main</code></li><li><code>JEE Advanced</code></li>
                    <li><code>NEET</code></li><li><code>Board</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // ── Restore active tab ────────────────────────────────────────────────
    const src = '@src';
    const el  = document.querySelector(`[data-bs-target="#tab-${src}"]`);
    if (el) bootstrap.Tab.getOrCreateInstance(el).show();

    // ── Destination selector logic ────────────────────────────────────────
    window.onDestinationChange = function (value) {
        const wrapper = document.getElementById('testSelectWrapper');
        const dropdown = document.getElementById('testSelectDropdown');

        if (value === 'test') {
            wrapper.style.display = '';
            // Disable submit buttons until a test is chosen (unless already chosen)
            updateSubmitButtons(dropdown.value);
        } else {
            wrapper.style.display = 'none';
            // Clear any previously set testId and re-enable
            syncTestIdToForms('');
            updateSubmitButtons('__global__'); // non-empty → enable
        }
    };

    window.onTestSelected = function (testId) {
        syncTestIdToForms(testId);
        updateSubmitButtons(testId);
    };

    function syncTestIdToForms(testId) {
        document.querySelectorAll('.testid-field').forEach(f => f.value = testId);
    }

    function updateSubmitButtons(testId) {
        const dest = document.querySelector('input[name="destination"]:checked')?.value;
        const enabled = dest !== 'test' || testId !== '';
        document.querySelectorAll('.import-submit-btn').forEach(btn => {
            btn.disabled = !enabled;
            btn.title = !enabled ? 'Please select a test first.' : '';
        });
    }
})();
</script>
}
