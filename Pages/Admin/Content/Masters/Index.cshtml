@section Scripts {
<script>
// ── Restore active tab ────────────────────────────────────────────────────
(function () {
    const serverTab = '@tab';
    const el = document.querySelector(`[data-bs-target="#tab-${serverTab}"]`);
    if (el) bootstrap.Tab.getOrCreateInstance(el).show();
    document.querySelectorAll('#masterTabs [data-bs-toggle="tab"]').forEach(btn => {
        btn.addEventListener('shown.bs.tab', e => {
            const id = e.target.getAttribute('data-bs-target').replace('#tab-', '');
            localStorage.setItem('masterTab', id);
        });
    });
})();

// ── Pagination + Search ───────────────────────────────────────────────────
(function () {
    const inited = new WeakSet();

    function initTable(table) {
        if (inited.has(table)) return;
        inited.add(table);

        const pageSize    = parseInt(table.dataset.pageSize) || 10;
        const tbody       = table.querySelector('tbody');
        if (!tbody) return;

        const cardBody    = table.closest('.card-body');
        const searchInput = cardBody?.querySelector('.master-search');
        let page          = 1;
        let searchText    = '';

        const bar = document.createElement('div');
        bar.className = 'pg-bar d-flex align-items-center justify-content-between px-3 py-2 border-top bg-light';
        table.after(bar);

        function getFiltered() {
            const all = Array.from(tbody.querySelectorAll('tr'));
            if (!searchText) return all;
            const q = searchText.toLowerCase();
            return all.filter(tr => tr.textContent.toLowerCase().includes(q));
        }

        function render() {
            const allRows  = Array.from(tbody.querySelectorAll('tr'));
            const filtered = getFiltered();
            const total    = filtered.length;
            const pages    = Math.max(1, Math.ceil(total / pageSize));
            page = Math.min(Math.max(1, page), pages);

            allRows.forEach(tr => tr.style.display = 'none');
            const visible = filtered.slice((page - 1) * pageSize, page * pageSize);
            visible.forEach(tr => tr.style.display = '');

            const from = total === 0 ? 0 : (page - 1) * pageSize + 1;
            const to   = Math.min(page * pageSize, total);

            bar.innerHTML = `
                <span class="text-muted" style="font-size:0.75rem">Showing ${from}–${to} of ${total}</span>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0 pg-prev" ${page <= 1 ? 'disabled' : ''}>
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span style="font-size:0.75rem" class="mx-1">Page ${page}/${pages}</span>
                    <button class="btn btn-sm btn-outline-secondary px-2 py-0 pg-next" ${page >= pages ? 'disabled' : ''}>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>`;

            bar.querySelector('.pg-prev')?.addEventListener('click', () => { page--; render(); });
            bar.querySelector('.pg-next')?.addEventListener('click', () => { page++; render(); });
        }

        if (searchInput && !searchInput._pgInited) {
            searchInput._pgInited = true;
            searchInput.addEventListener('input', () => {
                searchText = searchInput.value.trim();
                page = 1;
                render();
            });
        }

        render();
    }

    // Init all tables now (active tab renders immediately)
    document.querySelectorAll('table.paginated-table').forEach(initTable);

    // Also init when a tab is shown (catches tabs that were hidden on load)
    document.querySelectorAll('#masterTabs [data-bs-toggle="tab"]').forEach(btn => {
        btn.addEventListener('shown.bs.tab', e => {
            const pane = document.querySelector(e.target.getAttribute('data-bs-target'));
            pane?.querySelectorAll('table.paginated-table').forEach(initTable);
        });
    });
})();

// ── Generic simple-master modal ───────────────────────────────────────────
(function () {
    const modal = document.getElementById('editSimpleModal');
    if (!modal) return;

    // Handler → form field name prefix mapping
    const handlerFields = {
        UpdateSubject:      { name: 'EditSubject.Name',      sort: 'EditSubject.SortOrder',      active: 'EditSubject.IsActive'      },
        UpdateDifficulty:   { name: 'EditDifficulty.Name',   sort: 'EditDifficulty.SortOrder',   active: 'EditDifficulty.IsActive'   },
        UpdateComplexity:   { name: 'EditComplexity.Name',   sort: 'EditComplexity.SortOrder',   active: 'EditComplexity.IsActive'   },
        UpdateExamType:     { name: 'EditExamType.Name',     sort: 'EditExamType.SortOrder',     active: 'EditExamType.IsActive'     },
        UpdateExamCategory: { name: 'EditExamCategory.Name', sort: 'EditExamCategory.SortOrder', active: 'EditExamCategory.IsActive' },
        UpdateTag:          { name: 'EditTag.Name',          sort: 'EditTag.SortOrder',          active: 'EditTag.IsActive'          },
    };

    modal.addEventListener('show.bs.modal', function (e) {
        const btn     = e.relatedTarget;
        const handler = btn.getAttribute('data-handler');
        const fields  = handlerFields[handler];
        if (!fields) return;

        const form = modal.querySelector('form');
        form.setAttribute('action', `?handler=${handler}`);

        // Update input names to match the bound property
        modal.querySelector('#editSimpleName').name   = fields.name;
        modal.querySelector('#editSimpleSort').name   = fields.sort;
        modal.querySelector('#editSimpleActive').name = fields.active;

        modal.querySelector('#editSimpleLabel').textContent = btn.getAttribute('data-label');
        modal.querySelector('#editSimpleId').value          = btn.getAttribute('data-id');
        modal.querySelector('#editSimpleName').value        = btn.getAttribute('data-name');
        modal.querySelector('#editSimpleSort').value        = btn.getAttribute('data-sort');
        modal.querySelector('#editSimpleActive').checked    = btn.getAttribute('data-active') === 'true';
    });
})();

