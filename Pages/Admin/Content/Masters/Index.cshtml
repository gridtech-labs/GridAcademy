@page
@model GridAcademy.Pages.Admin.Content.Masters.IndexModel
@{
    ViewData["Title"] = "Masters";
    var tab = Model.ActiveTab ?? "subjects";
    bool isAdmin = User.IsInRole("Admin");
    bool canEdit = isAdmin || User.IsInRole("Instructor");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-collection me-2 text-primary"></i>Masters</h4>
        <p class="text-muted small mb-0">Manage lookup data used across the content module</p>
    </div>
</div>

@if (TempData["Error"]   != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<!-- ── Tab nav ──────────────────────────────────────────────────────────── -->
<ul class="nav nav-tabs mb-3" id="masterTabs">
    @{
        var navItems = new[] {
            ("subjects",         "Subjects",       "bi-journal-text", Model.Subjects.Count),
            ("topics",           "Topics",         "bi-list-nested",  Model.Topics.Count),
            ("difficulty",       "Difficulty",     "bi-speedometer",  Model.DifficultyLevels.Count),
            ("complexity",       "Complexity",     "bi-layers",       Model.ComplexityLevels.Count),
            ("examtypes",        "Exam Types",     "bi-mortarboard",  Model.ExamTypes.Count),
            ("examcategories",   "Categories",     "bi-grid",         Model.ExamCategories.Count),
            ("examsubcategories","Sub-Categories", "bi-grid-3x2",     Model.ExamSubCategories.Count),
            ("marks",            "Marks",          "bi-plus-circle",  Model.Marks.Count),
            ("negmarks",         "Neg. Marks",     "bi-dash-circle",  Model.NegativeMarks.Count),
            ("tags",             "Tags",           "bi-tags",         Model.Tags.Count),
            ("qtypes",           "Q. Types",       "bi-ui-checks",    Model.QuestionTypes.Count),
        };
    }
    @foreach (var (id, label, icon, count) in navItems)
    {
        <li class="nav-item">
            <button class="nav-link @(tab == id ? "active" : "")"
                    data-bs-toggle="tab" data-bs-target="#tab-@id" type="button">
                <i class="bi @icon me-1"></i>@label
                <span class="badge bg-secondary ms-1">@count</span>
            </button>
        </li>
    }
</ul>

<div class="tab-content">

    <!-- ══ SUBJECTS ══════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="subjects" ? "show active" : "")" id="tab-subjects">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Subjects</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Status</th><th>Sort</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var s in Model.Subjects)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Name</td>
                            <td>
                                @if (s.IsActive) { <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span> }
                                else             { <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span> }
                            </td>
                            <td class="text-muted">@s.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editSimpleModal"
                                            data-handler="UpdateSubject"
                                            data-id="@s.Id" data-name="@s.Name"
                                            data-sort="@s.SortOrder" data-active="@s.IsActive.ToString().ToLower()"
                                            data-label="Subject">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteSubject" class="d-inline"
                                          onsubmit="return confirm('Delete subject \'@s.Name\'?')">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Subjects.Any())
                    { <tr><td colspan="5" class="text-center text-muted py-3">No subjects yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddSubject" class="row g-2 align-items-end">
                        <div class="col-12 col-md">
                            <label class="form-label small mb-1 text-muted">New Subject Name</label>
                            <input asp-for="NewSubject.Name" class="form-control form-control-sm" placeholder="e.g. Mathematics" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-1 text-muted">Sort</label>
                            <input asp-for="NewSubject.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" />
                        </div>
                        <div class="col-auto align-self-end">
                            <button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Subject</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ TOPICS ════════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="topics" ? "show active" : "")" id="tab-topics">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Topics</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Subject</th><th>Status</th><th>Sort</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var t in Model.Topics)
                    {
                        <tr>
                            <td class="fw-semibold">@t.Name</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@t.SubjectName</span></td>
                            <td>
                                @if (t.IsActive) { <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span> }
                                else             { <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span> }
                            </td>
                            <td class="text-muted">@t.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editTopicModal"
                                            data-id="@t.Id" data-name="@t.Name"
                                            data-subjectid="@t.SubjectId"
                                            data-sort="@t.SortOrder" data-active="@t.IsActive.ToString().ToLower()">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteTopic" class="d-inline"
                                          onsubmit="return confirm('Delete topic \'@t.Name\'?')">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Topics.Any())
                    { <tr><td colspan="6" class="text-center text-muted py-3">No topics yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddTopic" class="row g-2 align-items-end">
                        <div class="col-auto">
                            <label class="form-label small mb-1 text-muted">Subject</label>
                            <select asp-for="NewTopic.SubjectId" class="form-select form-select-sm" required>
                                <option value="">— select —</option>
                                @foreach (var s in Model.Subjects.Where(x => x.IsActive))
                                { <option value="@s.Id">@s.Name</option> }
                            </select>
                        </div>
                        <div class="col-12 col-md">
                            <label class="form-label small mb-1 text-muted">Topic Name</label>
                            <input asp-for="NewTopic.Name" class="form-control form-control-sm" placeholder="e.g. Algebra" required />
                        </div>
                        <div class="col-auto">
                            <label class="form-label small mb-1 text-muted">Sort</label>
                            <input asp-for="NewTopic.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" />
                        </div>
                        <div class="col-auto align-self-end">
                            <button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Topic</button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ DIFFICULTY ════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="difficulty" ? "show active" : "")" id="tab-difficulty">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Difficulty Levels</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light"><tr><th>Name</th><th>Sort</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model.DifficultyLevels)
                    {
                        <tr>
                            <td class="fw-semibold">@d.Name</td>
                            <td class="text-muted">@d.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editSimpleModal"
                                            data-handler="UpdateDifficulty"
                                            data-id="@d.Id" data-name="@d.Name"
                                            data-sort="@d.SortOrder" data-active="@d.IsActive.ToString().ToLower()"
                                            data-label="Difficulty Level">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteDifficulty" class="d-inline"
                                          onsubmit="return confirm('Delete \'@d.Name\'?')">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.DifficultyLevels.Any())
                    { <tr><td colspan="4" class="text-center text-muted py-3">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddDifficulty" class="row g-2 align-items-end">
                        <div class="col-12 col-md"><input asp-for="NewDifficulty.Name" class="form-control form-control-sm" placeholder="e.g. Easy" required /></div>
                        <div class="col-auto"><input asp-for="NewDifficulty.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" /></div>
                        <div class="col-auto"><button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ COMPLEXITY ════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="complexity" ? "show active" : "")" id="tab-complexity">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Complexity Levels</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light"><tr><th>Name</th><th>Sort</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.ComplexityLevels)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td class="text-muted">@c.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editSimpleModal"
                                            data-handler="UpdateComplexity"
                                            data-id="@c.Id" data-name="@c.Name"
                                            data-sort="@c.SortOrder" data-active="@c.IsActive.ToString().ToLower()"
                                            data-label="Complexity Level">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteComplexity" class="d-inline"
                                          onsubmit="return confirm('Delete \'@c.Name\'?')">
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.ComplexityLevels.Any())
                    { <tr><td colspan="4" class="text-center text-muted py-3">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddComplexity" class="row g-2 align-items-end">
                        <div class="col-12 col-md"><input asp-for="NewComplexity.Name" class="form-control form-control-sm" placeholder="e.g. Basic" required /></div>
                        <div class="col-auto"><input asp-for="NewComplexity.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" /></div>
                        <div class="col-auto"><button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ EXAM TYPES ════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="examtypes" ? "show active" : "")" id="tab-examtypes">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Exam Types</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light"><tr><th>Name</th><th>Sort</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var e in Model.ExamTypes)
                    {
                        <tr>
                            <td class="fw-semibold">@e.Name</td>
                            <td class="text-muted">@e.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editSimpleModal"
                                            data-handler="UpdateExamType"
                                            data-id="@e.Id" data-name="@e.Name"
                                            data-sort="@e.SortOrder" data-active="@e.IsActive.ToString().ToLower()"
                                            data-label="Exam Type">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteExamType" class="d-inline"
                                          onsubmit="return confirm('Delete \'@e.Name\'?')">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.ExamTypes.Any())
                    { <tr><td colspan="4" class="text-center text-muted py-3">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddExamType" class="row g-2 align-items-end">
                        <div class="col-12 col-md"><input asp-for="NewExamType.Name" class="form-control form-control-sm" placeholder="e.g. JEE Main" required /></div>
                        <div class="col-auto"><input asp-for="NewExamType.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" /></div>
                        <div class="col-auto"><button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ MARKS ═════════════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="marks" ? "show active" : "")" id="tab-marks">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Marks</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light"><tr><th>Label</th><th>Value</th><th>Sort</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var m in Model.Marks)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Name</td>
                            <td><span class="badge bg-success text-white">+@m.Value</span></td>
                            <td class="text-muted">@m.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editMarksModal"
                                            data-handler="UpdateMarks"
                                            data-id="@m.Id" data-name="@m.Name"
                                            data-value="@m.Value" data-sort="@m.SortOrder"
                                            data-active="@m.IsActive.ToString().ToLower()"
                                            data-label="Marks">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteMarks" class="d-inline"
                                          onsubmit="return confirm('Delete marks \'@m.Name\'?')">
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Marks.Any())
                    { <tr><td colspan="5" class="text-center text-muted py-3">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddMarks" class="row g-2 align-items-end">
                        <div class="col-auto"><label class="form-label small mb-1 text-muted">Label</label><input asp-for="NewMarks.Name" class="form-control form-control-sm" placeholder="e.g. 2 Marks" required /></div>
                        <div class="col-auto"><label class="form-label small mb-1 text-muted">Value</label><input asp-for="NewMarks.Value" type="number" step="0.25" class="form-control form-control-sm" style="width:90px" required /></div>
                        <div class="col-auto"><label class="form-label small mb-1 text-muted">Sort</label><input asp-for="NewMarks.SortOrder" type="number" class="form-control form-control-sm" style="width:80px" /></div>
                        <div class="col-auto align-self-end"><button class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>Add</button></div>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- ══ NEGATIVE MARKS ════════════════════════════════════════════════════ -->
    <div class="tab-pane fade @(tab=="negmarks" ? "show active" : "")" id="tab-negmarks">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold py-2 small">Negative Marks</div>
            <div class="card-body p-0">
                <div class="px-3 py-2 border-bottom bg-white">
                    <input type="search" class="form-control form-control-sm master-search" placeholder="&#128269; Search..." autocomplete="off" />
                </div>
                <table class="table table-sm table-hover align-middle mb-0 paginated-table" style="font-size:0.8rem" data-page-size="10">
                    <thead class="table-light"><tr><th>Label</th><th>Value</th><th>Sort</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var n in Model.NegativeMarks)
                    {
                        <tr>
                            <td class="fw-semibold">@n.Name</td>
                            <td><span class="badge bg-danger text-white">@n.Value</span></td>
                            <td class="text-muted">@n.SortOrder</td>
                            <td class="text-end">
                                @if (canEdit)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Edit"
                                            data-bs-toggle="modal" data-bs-target="#editMarksModal"
                                            data-handler="UpdateNegativeMarks"
                                            data-id="@n.Id" data-name="@n.Name"
                                            data-value="@n.Value" data-sort="@n.SortOrder"
                                            data-active="@n.IsActive.ToString().ToLower()"
                                            data-label="Negative Marks">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (isAdmin)
                                {
                                    <form method="post" asp-page-handler="DeleteNegativeMarks" class="d-inline"
                                          onsubmit="return confirm('Delete \'@n.Name\'?')">
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.NegativeMarks.Any())
                    { <tr><td colspan="5" class="text-center text-muted py-3">No entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
            @if (canEdit)
            {
                <div class="card-footer bg-white">
                    <form method="post" asp-page-handler="AddNegativeMarks" class="row g-2 align-items-end">
