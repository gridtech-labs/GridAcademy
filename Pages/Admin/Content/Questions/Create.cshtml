@page
@model GridAcademy.Pages.Admin.Content.Questions.CreateModel
@using GridAcademy.Data.Entities.Content
@{
    ViewData["Title"] = Model.IsEdit ? "Edit Question" : "Add Question";
    var optRows = new[]
    {
        new { Letter = "A", Name = "Form.OptionA", ChkName = "Form.CorrectA", Val = Model.Form.OptionA, Chk = Model.Form.CorrectA, Optional = false },
        new { Letter = "B", Name = "Form.OptionB", ChkName = "Form.CorrectB", Val = Model.Form.OptionB, Chk = Model.Form.CorrectB, Optional = false },
        new { Letter = "C", Name = "Form.OptionC", ChkName = "Form.CorrectC", Val = Model.Form.OptionC, Chk = Model.Form.CorrectC, Optional = false },
        new { Letter = "D", Name = "Form.OptionD", ChkName = "Form.CorrectD", Val = Model.Form.OptionD, Chk = Model.Form.CorrectD, Optional = false },
        // Option E is optional — leave blank for 4-option questions; it only renders when filled.
        new { Letter = "E", Name = "Form.OptionE", ChkName = "Form.CorrectE", Val = Model.Form.OptionE, Chk = Model.Form.CorrectE, Optional = true },
    };
    var qtype = (int)Model.Form.QuestionType;
}

@section Styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
<style>
    .math-editor-wrap { border:1px solid #dee2e6; border-radius:.375rem; overflow:hidden; }
    .math-editor-wrap .ql-toolbar.ql-snow  { border:none; border-bottom:1px solid #dee2e6; background:#f8f9fa; border-radius:0; }
    .math-editor-wrap .ql-container.ql-snow { border:none; font-size:.925rem; }
    /* Editors auto-grow with content and can be dragged taller via the bottom-right handle. */
    .math-editor-wrap .ql-editor            { min-height:130px; resize:vertical; overflow-y:auto; }
    .math-editor-wrap.ql-mini .ql-editor    { min-height:90px; }
    /* Give rendered KaTeX formulas vertical breathing room so tall fractions/roots aren't clipped. */
    .math-editor-wrap .ql-editor .ql-formula { display:inline-block; padding:2px 0; line-height:1.6; }
    .opt-letter { display:inline-block; width:26px; height:26px; line-height:26px;
                  text-align:center; border-radius:50%; background:#6c757d;
                  color:#fff; font-weight:700; font-size:.8rem; flex-shrink:0; }
    .math-editor-wrap .ql-editor img { max-width:100%; max-height:380px; object-fit:contain;
        display:block; margin:.5rem 0; border-radius:.25rem; border:1px solid #dee2e6; background:#f8f9fa; }
    .img-uploading { opacity:.45; animation:shimmer 1s infinite alternate; }
    @@keyframes shimmer { from{opacity:.3} to{opacity:.7} }

    /* Font-size dropdown labels */
    .ql-snow .ql-picker.ql-size .ql-picker-label::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item::before                          { content:'Normal'; }
    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value='0.75em']::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value='0.75em']::before     { content:'Small'; }
    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value='1em']::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value='1em']::before        { content:'Normal'; }
    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value='1.25em']::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value='1.25em']::before     { content:'Medium'; }
    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value='1.5em']::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value='1.5em']::before      { content:'Large'; }
    .ql-snow .ql-picker.ql-size .ql-picker-label[data-value='2em']::before,
    .ql-snow .ql-picker.ql-size .ql-picker-item[data-value='2em']::before        { content:'Huge'; }

    /* Formula tooltip aligned to editor */
    .math-editor-wrap .ql-tooltip { left:0 !important; }

    /* Match table */
    .match-cell-chk { width:26px; height:26px; cursor:pointer; }

    /* Sub-question card header */
    .subq-header { background:#f8f9fa; }
</style>
}

<!-- ── Page header ─────────────────────────────────────────────────────────── -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="bi bi-patch-question me-2 text-primary"></i>@ViewData["Title"]
        </h4>
        <p class="text-muted small mb-0">
            Fill in all required fields. Use the <kbd>ƒ</kbd> button in any toolbar to insert a LaTeX formula.
            Drag the bottom-right corner of any editor box to make it taller.
        </p>
    </div>
    @if (Model.TestId.HasValue)
    {
        <a asp-page="/Admin/Content/Tests/Questions/Index"
           asp-route-testId="@Model.TestId"
           class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Questions
        </a>
    }
    else
    {
        <a asp-page="/Admin/Content/Questions/Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Questions
        </a>
    }
</div>

<form method="post" id="questionForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible py-2 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Could not save question:</strong>
            <ul class="mb-0 mt-1 ps-3">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- LEFT COLUMN                                                        -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <div class="col-12 col-xl-8">

            <!-- ── Question Text (hidden for AR and PBQ) ──────────────────── -->
            <div class="card shadow-sm mb-3" id="questionTextCard">
                <div class="card-header bg-white fw-semibold py-3 d-flex align-items-center gap-2">
                    Question Text <span class="badge bg-danger">Required</span>
                    <small class="text-muted fw-normal ms-auto" style="font-size:.76rem">
                        Use <kbd>ƒ</kbd> for LaTeX · <code>[BLANK_1]</code> for fill-in-the-blank
                    </small>
                </div>
                <div class="card-body">
                    <textarea asp-for="Form.Text" id="Form_Text" style="display:none"></textarea>
                    <div class="math-editor-wrap" id="wrap-text">
                        <div id="editor-text"></div>
                    </div>
                    <div id="textError" class="text-danger small mt-1" style="display:none">
                        <i class="bi bi-exclamation-circle me-1"></i>Question text is required.
                    </div>
                    <div class="row mt-3 g-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Subtopic / Chapter <span class="text-muted fw-normal">(optional)</span></label>
                            <input asp-for="Form.Subtopic" class="form-control form-control-sm" placeholder="e.g. Quadratic Equations" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Solution / Explanation <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea asp-for="Form.Solution" id="Form_Solution" style="display:none"></textarea>
                            <div class="math-editor-wrap ql-mini"><div id="editor-solution"></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Question Type selector ─────────────────────────────────── -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold py-3">Question Type</div>
                <div class="card-body pb-3">
                    <select asp-for="Form.QuestionType" id="qtypeSelect" class="form-select">
                        <option value="1">MCQ — Single Correct · One correct option (A–D)</option>
                        <option value="2">MSQ — Multi Correct · One or more correct options</option>
                        <option value="3">NAT — Numerical · Integer or decimal answer</option>
                        <option value="4">FIB — Fill in Blank · Use [BLANK_1] in text</option>
                        <option value="5">T/F — True / False · Statement is True or False</option>
                        <option value="6">MTF — Match Following · List I ↔ List II pairs</option>
                        <option value="7">A&amp;R — Assert &amp; Reason · Assertion A + Reason R</option>
                        <option value="8">PBQ — Passage Based · Questions on a paragraph</option>
                        <option value="9">MMQ — Matrix Match · Row × Column grid</option>
                    </select>
                </div>
            </div>

            <!-- ── MCQ / MSQ options ───────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="mcqOptionsCard">
                <div class="card-header bg-white fw-semibold py-3 d-flex align-items-center gap-2">
                    Options
                    <small class="text-muted fw-normal ms-auto" style="font-size:.76rem">
                        <i class="bi bi-check-circle text-success"></i> Tick checkbox to mark correct
                    </small>
                </div>
                <div class="card-body">
                    @foreach (var opt in optRows)
                    {
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="d-flex flex-column align-items-center gap-1 pt-2" style="min-width:40px">
                                <span class="opt-letter">@opt.Letter</span>
                                <div class="form-check m-0 d-flex flex-column align-items-center">
                                    <input type="checkbox" name="@opt.ChkName" value="true"
                                           @(opt.Chk ? "checked" : "") id="chk@(opt.Letter)"
                                           class="form-check-input" title="Mark as correct answer" />
                                    <label for="chk@(opt.Letter)" class="form-check-label text-success"
                                           style="font-size:.65rem;font-weight:600">✓</label>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                @if (opt.Optional)
                                {
                                    <div class="small text-muted mb-1"><i class="bi bi-info-circle me-1"></i>Optional — leave blank for 4-option questions.</div>
                                }
                                <input type="hidden" id="Form_Option@(opt.Letter)" name="@opt.Name" value="@opt.Val" />
                                <div class="math-editor-wrap ql-mini"><div id="editor-opt@(opt.Letter)"></div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ── NAT ────────────────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="numericalCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">Numerical Answer</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Exact Answer <span class="text-danger">*</span></label>
                            <input asp-for="Form.NumericalAnswer" type="number" step="any"
                                   class="form-control" placeholder="e.g. 9.81" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tolerance ± <span class="text-muted fw-normal">(optional, 0 = exact)</span></label>
                            <input asp-for="Form.NumericalTolerance" type="number" step="any"
                                   class="form-control" placeholder="e.g. 0.01" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── True / False ───────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="tfCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">Correct Answer</div>
                <div class="card-body">
                    <p class="text-muted small mb-3">The question text above is the statement. Select which answer is correct.</p>
                    <div class="d-flex gap-4">
                        <div class="form-check border rounded px-4 py-3" style="cursor:pointer">
                            <input class="form-check-input" type="radio" name="Form.TfTrueIsCorrect"
                                   id="tf_true" value="true" @(Model.Form.TfTrueIsCorrect ? "checked" : "") />
                            <label class="form-check-label fw-semibold text-success" for="tf_true">
                                <i class="bi bi-check-circle me-1"></i> True
                            </label>
                        </div>
                        <div class="form-check border rounded px-4 py-3" style="cursor:pointer">
                            <input class="form-check-input" type="radio" name="Form.TfTrueIsCorrect"
                                   id="tf_false" value="false" @(!Model.Form.TfTrueIsCorrect ? "checked" : "") />
                            <label class="form-check-label fw-semibold text-danger" for="tf_false">
                                <i class="bi bi-x-circle me-1"></i> False
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Fill in Blanks ─────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="fibCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3 d-flex align-items-center gap-2">
                    Blank Answers
                    <button type="button" class="btn btn-sm btn-outline-primary ms-auto" onclick="addBlank()">
                        <i class="bi bi-plus me-1"></i>Add Blank
                    </button>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Mark positions in the question text using <code>[BLANK_1]</code>, <code>[BLANK_2]</code>, etc.,
                        then define the correct answer for each blank below.
                    </p>
                    <input type="hidden" asp-for="Form.BlanksJson" id="Form_BlanksJson" />
                    <div id="fibBlanksContainer"></div>
                    <p class="text-muted small mt-2 mb-0" id="fibNoBlanksTip">
                        <i class="bi bi-info-circle me-1"></i>Click "Add Blank" to define answers.
                    </p>
                </div>
            </div>

            <!-- ── Match the Following ────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="mtfCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">Match the Following</div>
                <div class="card-body">
                    <input type="hidden" asp-for="Form.MatchJson" id="Form_MatchJson" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <p class="fw-semibold small text-primary mb-2">List I (Left column)</p>
                            @foreach (var lbl in new[] { "A","B","C","D" })
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="opt-letter">@lbl</span>
                                    <input type="text" id="mtf-left-@lbl" class="form-control form-control-sm"
                                           placeholder="Item @lbl" oninput="saveMtfJson()" />
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <p class="fw-semibold small text-success mb-2">List II (Right column)</p>
                            @foreach (var lbl in new[] { "p","q","r","s" })
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="opt-letter" style="background:#198754">@lbl</span>
                                    <input type="text" id="mtf-right-@lbl" class="form-control form-control-sm"
                                           placeholder="Item @lbl" oninput="saveMtfJson()" />
                                </div>
                            }
                        </div>
                    </div>
                    <hr class="my-3" />
                    <p class="fw-semibold small mb-2">Correct Matching</p>
                    <div class="row g-2">
                        @foreach (var lbl in new[] { "A","B","C","D" })
                        {
                            <div class="col-6 col-md-3">
                                <label class="form-label small">@lbl matches →</label>
                                <select id="mtf-match-@lbl" class="form-select form-select-sm" onchange="saveMtfJson()">
                                    <option value="">— select —</option>
                                    @foreach (var r in new[] { "p","q","r","s" })
                                    { <option value="@r">@r</option> }
                                </select>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ── Matrix Match ───────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="mmqCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">Matrix Match</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <p class="fw-semibold small text-primary mb-2">Row Items</p>
                            @foreach (var lbl in new[] { "I","II","III","IV" })
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary" style="min-width:2.2rem;text-align:center">@lbl</span>
                                    <input type="text" id="mmq-row-@lbl" class="form-control form-control-sm"
                                           placeholder="Row @lbl" oninput="saveMmqJson()" />
                                </div>
                            }
                        </div>
                        <div class="col-md-6">
                            <p class="fw-semibold small text-success mb-2">Column Items</p>
                            @foreach (var lbl in new[] { "A","B","C","D" })
                            {
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="opt-letter" style="background:#198754">@lbl</span>
                                    <input type="text" id="mmq-col-@lbl" class="form-control form-control-sm"
                                           placeholder="Col @lbl" oninput="saveMmqJson()" />
                                </div>
                            }
                        </div>
                    </div>
                    <hr />
                    <p class="fw-semibold small mb-2">Correct Mappings <span class="text-muted fw-normal">(tick all that apply)</span></p>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm text-center align-middle" style="width:auto">
                            <thead class="table-light">
                                <tr>
                                    <th></th>
                                    @foreach (var c in new[] { "A","B","C","D" })
                                    { <th class="text-success">@c</th> }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r2 in new[] { "I","II","III","IV" })
                                {
                                    <tr>
                                        <td class="fw-semibold text-primary">@r2</td>
                                        @foreach (var c in new[] { "A","B","C","D" })
                                        {
                                            <td>
                                                <input type="checkbox" id="mmq-@(r2)-@c"
                                                       class="match-cell-chk form-check-input"
                                                       onchange="saveMmqJson()" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ── Assertion & Reason ─────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="arCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-chat-quote me-2 text-primary"></i>Assertion &amp; Reason
                </div>
                <div class="card-body">
                    <textarea asp-for="Form.AssertionText" id="Form_AssertionText" style="display:none"></textarea>
                    <textarea asp-for="Form.ReasonText"    id="Form_ReasonText"    style="display:none"></textarea>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Assertion (A) <span class="text-danger">*</span>
                        </label>
                        <div class="math-editor-wrap ql-mini"><div id="editor-assertion"></div></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">
                            Reason (R) <span class="text-danger">*</span>
                        </label>
                        <div class="math-editor-wrap ql-mini"><div id="editor-reason"></div></div>
                    </div>
                    <hr />
                    <p class="fw-semibold small mb-2">Correct Option <span class="text-danger">*</span></p>
                    @{
                        var arTexts = new[]
                        {
                            "Both A and R are true and R is the correct explanation of A.",
                            "Both A and R are true but R is NOT the correct explanation of A.",
                            "A is true but R is false.",
                            "A is false but R is true."
                        };
                    }
                    @for (int i = 1; i <= 4; i++)
                    {
                        <div class="form-check mb-2 border rounded p-2">
                            <input class="form-check-input" type="radio" name="Form.ArCorrectOption"
                                   id="ar_opt_@i" value="@i"
                                   @(Model.Form.ArCorrectOption == i ? "checked" : "") />
                            <label class="form-check-label" for="ar_opt_@i">
                                <span class="badge bg-secondary me-1">@i</span>@arTexts[i - 1]
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- ── Passage Based ──────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3" id="pbqCard" style="display:none">
                <div class="card-header bg-white fw-semibold py-3">
                    <i class="bi bi-book-half me-2 text-primary"></i>Passage Text
                    <span class="badge bg-danger ms-1">Required</span>
                </div>
                <div class="card-body">
                    <input asp-for="Form.PassageId" type="hidden" />
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Passage Title <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Form.PassageTitle" class="form-control form-control-sm"
                               placeholder="e.g. Read the following paragraph carefully…" />
                    </div>
                    <textarea asp-for="Form.PassageTextContent" id="Form_PassageTextContent" style="display:none"></textarea>
                    <div class="math-editor-wrap" id="wrap-passage">
                        <div id="editor-passage"></div>
                    </div>
                </div>
            </div>

            <!-- Sub-questions container (PBQ) -->
            <div id="pbqSubSection" style="display:none">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-list-ol me-2 text-primary"></i>Sub-questions</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addSubQuestion()">
                        <i class="bi bi-plus me-1"></i>Add Sub-question
                    </button>
                </div>
                <input type="hidden" asp-for="Form.SubQuestionsJson" id="Form_SubQuestionsJson" />
                <div id="subQContainer"></div>
                <p class="text-muted small" id="subQEmptyTip">
                    <i class="bi bi-info-circle me-1"></i>Click "Add Sub-question" to add the first question for this passage.
                </p>
            </div>

        </div>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- RIGHT COLUMN                                                       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <div class="col-12 col-xl-4">

            <!-- ── LaTeX Quick Reference ──────────────────────────────────── -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-2 d-flex align-items-center justify-content-between"
                     style="cursor:pointer" data-bs-toggle="collapse" data-bs-target="#latexRefPanel">
                    <span class="fw-semibold">
                        <i class="bi bi-calculator me-2 text-primary"></i>LaTeX Quick Reference
                    </span>
                    <i class="bi bi-chevron-down small text-muted"></i>
                </div>
                <div id="latexRefPanel" class="collapse">
                    <div class="card-body p-2">
                        <div class="d-flex gap-1 mb-2 flex-wrap" id="latexTabBar">
                            <button type="button" class="btn btn-xs btn-primary latex-tab active"
                                    data-ltab="greek" style="font-size:.72rem;padding:.2rem .55rem">Greek</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary latex-tab"
                                    data-ltab="math"  style="font-size:.72rem;padding:.2rem .55rem">Math</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary latex-tab"
                                    data-ltab="trig"  style="font-size:.72rem;padding:.2rem .55rem">Trig/Calc</button>
                            <button type="button" class="btn btn-xs btn-outline-secondary latex-tab"
                                    data-ltab="phys"  style="font-size:.72rem;padding:.2rem .55rem">Physics</button>
                        </div>
                        <div id="latexSymGrid" class="d-flex flex-wrap gap-1"></div>
                        <p class="text-muted mb-0 mt-2" style="font-size:.7rem">
                            <i class="bi bi-info-circle me-1"></i>Click to insert into the focused editor.
                        </p>
                    </div>
                </div>
            </div>

            <!-- ── Classification ─────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold py-3">Classification</div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Subject <span class="text-danger">*</span></label>
                        <select asp-for="Form.SubjectId" class="form-select form-select-sm" id="subjectSelect">
                            <option value="0">— select subject —</option>
                            @foreach (var s in Model.Subjects)
                            { <option value="@s.Id" selected="@(Model.Form.SubjectId == s.Id)">@s.Name</option> }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Topic <span class="text-danger">*</span></label>
                        <select asp-for="Form.TopicId" class="form-select form-select-sm" id="topicSelect">
                            <option value="0">— select topic —</option>
                            @foreach (var t in Model.Topics)
                            { <option value="@t.Id" data-subject="@t.SubjectId" selected="@(Model.Form.TopicId == t.Id)">@t.Name</option> }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Difficulty <span class="text-danger">*</span></label>
                        <select asp-for="Form.DifficultyLevelId" class="form-select form-select-sm">
                            <option value="0">— select —</option>
                            @foreach (var d in Model.DifficultyLevels)
                            { <option value="@d.Id" selected="@(Model.Form.DifficultyLevelId == d.Id)">@d.Name</option> }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Complexity <span class="text-danger">*</span></label>
                        <select asp-for="Form.ComplexityLevelId" class="form-select form-select-sm">
                            <option value="0">— select —</option>
                            @foreach (var c in Model.ComplexityLevels)
                            { <option value="@c.Id" selected="@(Model.Form.ComplexityLevelId == c.Id)">@c.Name</option> }
                        </select>
                    </div>

                </div>
            </div>

            <!-- ── Marks ───────────────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold py-3">Marks</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Positive Marks <span class="text-danger">*</span></label>
                        <select asp-for="Form.MarksId" class="form-select form-select-sm">
                            <option value="0">— select —</option>
                            @foreach (var m in Model.Marks)
                            { <option value="@m.Id" selected="@(Model.Form.MarksId == m.Id)">@m.Name (+@m.Value)</option> }
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold">Negative Marks <span class="text-danger">*</span></label>
                        <select asp-for="Form.NegativeMarksId" class="form-select form-select-sm">
                            <option value="0">— select —</option>
                            @foreach (var n in Model.NegativeMarks)
                            { <option value="@n.Id" selected="@(Model.Form.NegativeMarksId == n.Id)">@n.Name (@n.Value)</option> }
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Tags ───────────────────────────────────────────────────── -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold py-3">Tags</div>
                <div class="card-body">
                    <input type="hidden" asp-for="Form.SelectedTagIds" id="selectedTagIds" />
                    <div id="tagBadges" class="mb-2 d-flex flex-wrap gap-1" style="min-height:1.5rem"></div>
                    <div class="d-flex flex-wrap gap-1" id="tagOptions">
                        @foreach (var t in Model.Tags)
                        {
                            <span class="badge border border-secondary text-secondary tag-pick"
                                  data-id="@t.Id" data-name="@t.Name"
                                  style="cursor:pointer;font-size:.8rem">@t.Name</span>
                        }
                    </div>
                    <small class="text-muted d-block mt-1">Click a tag to add / remove it.</small>
                </div>
            </div>

            @if (Model.IsEdit)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold py-3">Status</div>
                    <div class="card-body">
                        <select asp-for="Form.Status" class="form-select form-select-sm">
                            <option value="1">Draft</option>
                            <option value="2">Published</option>
                        </select>
                    </div>
                </div>
            }

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i>@(Model.IsEdit ? "Save Changes" : "Create Question")
                </button>
                <a asp-page="/Admin/Content/Questions/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>

        </div>
    </div>
</form>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
if (typeof jQuery !== 'undefined' && jQuery.validator) {
    jQuery.validator.setDefaults({ ignore: ':hidden, [type=hidden]' });
}
</script>
<script>
(function () {
    'use strict';

    // ── Font-size format ──────────────────────────────────────────────────────
    const SizeStyle = Quill.import('attributors/style/size');
    SizeStyle.whitelist = ['0.75em', '1em', '1.25em', '1.5em', '2em'];
    Quill.register(SizeStyle, true);

    // ── Toolbar configs ───────────────────────────────────────────────────────
    const fullToolbar = [
        [{ size: ['0.75em', '1em', '1.25em', '1.5em', '2em'] }],
        ['bold', 'italic', 'underline'],
        [{ script: 'sub' }, { script: 'super' }],
        ['formula', 'image'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['clean']
    ];
    const miniToolbar = [
        ['bold', 'italic'],
        [{ script: 'sub' }, { script: 'super' }],
        ['formula', 'image'],
        ['clean']
    ];

    // ── Editor factory ────────────────────────────────────────────────────────
    function mkEditor(containerId, toolbar, placeholder) {
        return new Quill('#' + containerId, {
            modules: { formula: true, toolbar },
            theme: 'snow',
            placeholder: placeholder || ''
        });
    }
    function loadHtml(editor, hiddenId) {
        const h = document.getElementById(hiddenId);
        if (h && h.value && h.value.trim()) editor.clipboard.dangerouslyPasteHTML(h.value);
    }
    function syncField(editor, inputId) {
        const html = editor.root.innerHTML;
        const empty = html === '<p><br></p>' || html.trim() === '';
        document.getElementById(inputId).value = empty ? '' : html;
    }

    // ── Static editors (always visible on page load) ──────────────────────────
    const qText      = mkEditor('editor-text',      fullToolbar, 'Enter the full question text…');
    const qSolution  = mkEditor('editor-solution',   miniToolbar, 'Step-by-step solution (optional)…');
    const qOptA      = mkEditor('editor-optA',       miniToolbar, 'Option A…');
    const qOptB      = mkEditor('editor-optB',       miniToolbar, 'Option B…');
    const qOptC      = mkEditor('editor-optC',       miniToolbar, 'Option C…');
    const qOptD      = mkEditor('editor-optD',       miniToolbar, 'Option D…');
    const qOptE      = mkEditor('editor-optE',       miniToolbar, 'Option E (optional)…');
    const qAssertion = mkEditor('editor-assertion',  miniToolbar, 'Assertion (A) statement…');
    const qReason    = mkEditor('editor-reason',     miniToolbar, 'Reason (R) statement…');

    // NOTE: qPassage is intentionally NOT created here.
    // The pbqCard div starts hidden (display:none). Quill editors initialised inside
    // a hidden container cannot properly track typed content — root.innerHTML stays
    // as "<p><br></p>" even after the user types.  We lazy-init qPassage the first
    // time the user switches to Passage Based type, when the container is visible.
    let qPassage = null;

    loadHtml(qText,      'Form_Text');
    loadHtml(qSolution,  'Form_Solution');
    loadHtml(qOptA,      'Form_OptionA');
    loadHtml(qOptB,      'Form_OptionB');
    loadHtml(qOptC,      'Form_OptionC');
    loadHtml(qOptD,      'Form_OptionD');
    loadHtml(qOptE,      'Form_OptionE');
    loadHtml(qAssertion, 'Form_AssertionText');
    loadHtml(qReason,    'Form_ReasonText');
    // qPassage is loaded lazily in applyType(8)

    // ── Track active editor for LaTeX quick ref ───────────────────────────────
    let activeEditor = qText;
    function trackActive(ed) {
        ed.on('selection-change', r => { if (r) activeEditor = ed; });
    }
    [qText, qSolution, qOptA, qOptB, qOptC, qOptD, qOptE, qAssertion, qReason].forEach(trackActive);

    function insertFormula(latex) {
        const range = activeEditor.getSelection() || { index: Math.max(0, activeEditor.getLength() - 1) };
        activeEditor.insertEmbed(range.index, 'formula', latex);
        activeEditor.setSelection(range.index + 1);
        activeEditor.focus();
    }

    // ── Image upload handler ──────────────────────────────────────────────────
    function setupImageUpload(editor) {
        editor.getModule('toolbar').addHandler('image', function () {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/jpeg,image/png,image/gif,image/webp';
            input.onchange = async function () {
                const file = input.files[0];
                if (!file) return;
                const range = editor.getSelection(true) || { index: editor.getLength() - 1 };
                editor.insertEmbed(range.index, 'image', '/img/uploading.gif');
                editor.root.querySelector('img[src="/img/uploading.gif"]')?.classList.add('img-uploading');
                const fd = new FormData();
                fd.append('file', file);
                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
                    const res = await fetch('?handler=UploadImage', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    const data = await res.json();
                    editor.deleteText(range.index, 1);
                    if (data.url) { editor.insertEmbed(range.index, 'image', data.url); editor.setSelection(range.index + 1); editor.focus(); }
                    else alert('Upload failed: ' + (data.error || 'Unknown error'));
                } catch (err) { editor.deleteText(range.index, 1); console.error(err); alert('Upload failed.'); }
            };
            input.click();
        });
    }
    setupImageUpload(qText);
    setupImageUpload(qSolution);
    setupImageUpload(qOptA);
    setupImageUpload(qOptB);
    setupImageUpload(qOptC);
    setupImageUpload(qOptD);
    setupImageUpload(qOptE);
    setupImageUpload(qAssertion);
    setupImageUpload(qReason);
    // qPassage image upload is wired in applyType(8) after lazy init

    // ── Question type toggle ──────────────────────────────────────────────────
    const TYPE_SECTIONS = {
        1: ['mcqOptionsCard'],
        2: ['mcqOptionsCard'],
        3: ['numericalCard'],
        4: ['fibCard'],
        5: ['tfCard'],
        6: ['mtfCard'],
        7: ['arCard'],              // AssertionReason = 7
        8: ['pbqCard', 'pbqSubSection'], // PassageBased = 8
        9: ['mmqCard']              // MatrixMatch = 9
    };
    const ALL_SECTIONS = ['mcqOptionsCard','numericalCard','fibCard','tfCard','mtfCard','mmqCard','arCard','pbqCard','pbqSubSection'];
    // Types where the main question-text card is hidden (AR=7 and PBQ=8 have their own editors)
    const HIDE_QUESTION_TEXT = [7, 8];

    function applyType(val) {
        const v = parseInt(val);
        const qtc = document.getElementById('questionTextCard');
        if (qtc) qtc.style.display = HIDE_QUESTION_TEXT.includes(v) ? 'none' : '';
        ALL_SECTIONS.forEach(id => { const el = document.getElementById(id); if (el) el.style.display = 'none'; });
        (TYPE_SECTIONS[v] || []).forEach(id => { const el = document.getElementById(id); if (el) el.style.display = ''; });

        // ── Lazy-init passage Quill editor (must be visible first) ────────────
        if (v === 8 && !qPassage) {
            // pbqCard is now visible — safe to initialise Quill
            qPassage = mkEditor('editor-passage', fullToolbar, 'Enter the reading passage here…');
            setupImageUpload(qPassage);
            trackActive(qPassage);
            // If in edit mode, load existing passage HTML from the hidden textarea
            loadHtml(qPassage, 'Form_PassageTextContent');
        }
    }

    const qtypeSelect = document.getElementById('qtypeSelect');
    if (qtypeSelect) {
        qtypeSelect.addEventListener('change', () => applyType(qtypeSelect.value));
        applyType(qtypeSelect.value);
    }

    // ── Fill in Blanks ────────────────────────────────────────────────────────
    let blanks = [];
    const fibContainer = document.getElementById('fibBlanksContainer');
    const fibTip = document.getElementById('fibNoBlanksTip');

    // Load existing blanks (edit mode)
    try { const j = document.getElementById('Form_BlanksJson').value; if (j) blanks = JSON.parse(j); } catch(e) {}

    function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function renderBlanks() {
        fibContainer.innerHTML = '';
        fibTip.style.display = blanks.length === 0 ? '' : 'none';
        blanks.forEach(function(b, i) {
            const row = document.createElement('div');
            row.className = 'border rounded p-2 mb-2';
            row.innerHTML =
                '<div class="d-flex align-items-center gap-2 flex-wrap">' +
                '<span class="badge bg-primary fw-normal" style="min-width:5.5rem">[BLANK_' + b.blankIndex + ']</span>' +
                '<input type="text" class="form-control form-control-sm flex-grow-1" placeholder="Correct answer *" style="min-width:120px" value="' + escHtml(b.correctAnswer) + '" oninput="window._fibUpdate(' + i + ',\'correctAnswer\',this.value)">' +
                '<input type="text" class="form-control form-control-sm" placeholder="Alternate answers (pipe-separated)" style="min-width:170px;max-width:260px" value="' + escHtml(b.alternateAnswers || '') + '" oninput="window._fibUpdate(' + i + ',\'alternateAnswers\',this.value)">' +
                '<div class="form-check mb-0 d-flex align-items-center gap-1">' +
                '<input class="form-check-input mt-0" type="checkbox" id="fib-cs-' + i + '" ' + (b.caseSensitive ? 'checked' : '') + ' onchange="window._fibUpdate(' + i + ',\'caseSensitive\',this.checked)">' +
                '<label class="form-check-label small" for="fib-cs-' + i + '">Case sensitive</label></div>' +
                '<button type="button" class="btn btn-sm btn-outline-danger" onclick="window._fibRemove(' + i + ')"><i class="bi bi-trash"></i></button>' +
                '</div>';
            fibContainer.appendChild(row);
        });
        saveBlanksJson();
    }

    window._fibUpdate = function(i, key, val) { blanks[i][key] = val; saveBlanksJson(); };
    window._fibRemove = function(i) { blanks.splice(i, 1); renderBlanks(); };
    window.addBlank = function() {
        const next = blanks.length > 0 ? Math.max(...blanks.map(function(b){return b.blankIndex;})) + 1 : 1;
        blanks.push({ blankIndex: next, correctAnswer: '', alternateAnswers: '', caseSensitive: false });
        renderBlanks();
    };
    function saveBlanksJson() { document.getElementById('Form_BlanksJson').value = JSON.stringify(blanks); }
    renderBlanks();

    // ── Match the Following ───────────────────────────────────────────────────
    window.saveMtfJson = function() {
        const items = [], correct = [];
        ['A','B','C','D'].forEach(function(l) {
            const t = (document.getElementById('mtf-left-' + l)?.value || '').trim();
            if (t) items.push({ side: 'left', label: l, text: t });
        });
        ['p','q','r','s'].forEach(function(l) {
            const t = (document.getElementById('mtf-right-' + l)?.value || '').trim();
            if (t) items.push({ side: 'right', label: l, text: t });
        });
        ['A','B','C','D'].forEach(function(l) {
            const v = document.getElementById('mtf-match-' + l)?.value;
            if (v) correct.push({ left: l, right: v });
        });
        document.getElementById('Form_MatchJson').value = JSON.stringify({ items, correct });
    };

    // ── Matrix Match ──────────────────────────────────────────────────────────
    window.saveMmqJson = function() {
        const items = [], correct = [];
        ['I','II','III','IV'].forEach(function(l) {
            const t = (document.getElementById('mmq-row-' + l)?.value || '').trim();
            if (t) items.push({ side: 'row', label: l, text: t });
        });
        ['A','B','C','D'].forEach(function(l) {
            const t = (document.getElementById('mmq-col-' + l)?.value || '').trim();
            if (t) items.push({ side: 'col', label: l, text: t });
        });
        ['I','II','III','IV'].forEach(function(rl) {
            ['A','B','C','D'].forEach(function(cl) {
                const chk = document.getElementById('mmq-' + rl + '-' + cl);
                if (chk && chk.checked) correct.push({ left: rl, right: cl });
            });
        });
        document.getElementById('Form_MatchJson').value = JSON.stringify({ items, correct });
    };

    // Load existing match data (edit mode)
    (function() {
        try {
            const raw = document.getElementById('Form_MatchJson').value;
            if (!raw) return;
            const md = JSON.parse(raw);
            (md.items || []).forEach(function(item) {
                const el = document.getElementById('mtf-left-' + item.label)
                        || document.getElementById('mtf-right-' + item.label)
                        || document.getElementById('mmq-row-' + item.label)
                        || document.getElementById('mmq-col-' + item.label);
                if (el) el.value = item.text;
            });
            (md.correct || []).forEach(function(c) {
                // MTF dropdown
                const sel = document.getElementById('mtf-match-' + c.left);
                if (sel) sel.value = c.right;
                // MMQ checkbox
                const chk = document.getElementById('mmq-' + c.left + '-' + c.right);
                if (chk) chk.checked = true;
            });
        } catch(e) {}
    })();

    // ── Passage Based sub-questions ───────────────────────────────────────────
    let subQCount = 0;
    const subQEditors = [];
    const subQContainer = document.getElementById('subQContainer');
    const subQEmptyTip = document.getElementById('subQEmptyTip');

    window.addSubQuestion = function() {
        subQCount++;
        const idx = subQCount;
        if (subQEmptyTip) subQEmptyTip.style.display = 'none';

        const card = document.createElement('div');
        card.id = 'subq-card-' + idx;
        card.className = 'card shadow-sm mb-3';
        card.innerHTML =
            '<div class="card-header subq-header d-flex justify-content-between align-items-center py-2">' +
            '<span class="fw-semibold small"><i class="bi bi-question-circle me-1 text-primary"></i>Sub-question ' + idx + '</span>' +
            '<button type="button" class="btn btn-sm btn-outline-danger" onclick="window.removeSubQuestion(' + idx + ')">' +
            '<i class="bi bi-trash me-1"></i>Remove</button></div>' +
            '<div class="card-body">' +
            '<div class="mb-3">' +
            '<div class="d-flex align-items-center justify-content-between mb-1">' +
            '<label class="form-label small fw-semibold mb-0">Question text <span class="text-danger">*</span></label>' +
            '<select name="subq-type-' + idx + '" class="form-select form-select-sm w-auto" style="min-width:220px">' +
            '<option value="1" selected>MCQ — Single Correct</option>' +
            '<option value="2">MSQ — Multi Correct</option>' +
            '</select>' +
            '</div>' +
            '<div class="math-editor-wrap"><div id="subq-editor-' + idx + '"></div></div>' +
            '</div>' +
            ['A','B','C','D'].map(function(label) {
                return '<div class="d-flex align-items-center gap-2 mb-2">' +
                '<span class="opt-letter">' + label + '</span>' +
                '<input type="checkbox" data-opt-chk="' + idx + '-' + label + '" class="form-check-input mt-0" title="Correct?">' +
                '<input type="text" data-opt="' + idx + '-' + label + '" class="form-control form-control-sm" placeholder="Option ' + label + '">' +
                '</div>';
            }).join('') +
            '</div>';

        subQContainer.appendChild(card);

        const editor = mkEditor('subq-editor-' + idx, miniToolbar, 'Sub-question text…');
        trackActive(editor);
        subQEditors.push({ index: idx, editor: editor });
    };

    window.removeSubQuestion = function(idx) {
        const card = document.getElementById('subq-card-' + idx);
        if (card) card.remove();
        const i = subQEditors.findIndex(function(e) { return e.index === idx; });
        if (i >= 0) subQEditors.splice(i, 1);
        if (subQEditors.length === 0 && subQEmptyTip) subQEmptyTip.style.display = '';
    };

    function getSubQData() {
        return subQEditors.map(function(sq) {
            const card = document.getElementById('subq-card-' + sq.index);
            if (!card) return null;
            const html = sq.editor.root.innerHTML;
            const text = (html === '<p><br></p>' || html.trim() === '') ? '' : html;
            if (!text) return null;
            const typeSelect = card.querySelector('select[name="subq-type-' + sq.index + '"]');
            const qtype = typeSelect ? parseInt(typeSelect.value) : 1;
            const options = [];
            ['A','B','C','D'].forEach(function(label) {
                const inp = card.querySelector('[data-opt="' + sq.index + '-' + label + '"]');
                const chk = card.querySelector('[data-opt-chk="' + sq.index + '-' + label + '"]');
                if (inp && inp.value.trim())
                    options.push({ label: label, text: inp.value.trim(), isCorrect: chk ? chk.checked : false });
            });
            return { text: text, questionType: qtype, options: options };
        }).filter(Boolean);
    }

    // ── LaTeX Quick Reference ─────────────────────────────────────────────────
    const SYMS = {
        greek: [
            {d:'α',l:'\\alpha'},{d:'β',l:'\\beta'},{d:'γ',l:'\\gamma'},{d:'δ',l:'\\delta'},
            {d:'ε',l:'\\epsilon'},{d:'ζ',l:'\\zeta'},{d:'θ',l:'\\theta'},{d:'λ',l:'\\lambda'},
            {d:'μ',l:'\\mu'},{d:'π',l:'\\pi'},{d:'ρ',l:'\\rho'},{d:'σ',l:'\\sigma'},
            {d:'τ',l:'\\tau'},{d:'φ',l:'\\phi'},{d:'ψ',l:'\\psi'},{d:'ω',l:'\\omega'},
            {d:'Γ',l:'\\Gamma'},{d:'Δ',l:'\\Delta'},{d:'Θ',l:'\\Theta'},{d:'Σ',l:'\\Sigma'},{d:'Ω',l:'\\Omega'},
        ],
        math: [
            {d:'a/b',l:'\\frac{a}{b}'},{d:'√x',l:'\\sqrt{x}'},{d:'ⁿ√x',l:'\\sqrt[n]{x}'},
            {d:'x²',l:'x^{2}'},{d:'xₙ',l:'x_{n}'},{d:'±',l:'\\pm'},{d:'×',l:'\\times'},
            {d:'÷',l:'\\div'},{d:'∞',l:'\\infty'},{d:'|x|',l:'|x|'},
            {d:'∑',l:'\\sum_{i=1}^{n}'},{d:'∏',l:'\\prod_{i=1}^{n}'},
            {d:'≤',l:'\\leq'},{d:'≥',l:'\\geq'},{d:'≠',l:'\\neq'},{d:'≈',l:'\\approx'},
            {d:'∈',l:'\\in'},{d:'∉',l:'\\notin'},{d:'⊂',l:'\\subset'},{d:'∩',l:'\\cap'},{d:'∪',l:'\\cup'},
            {d:'∀',l:'\\forall'},{d:'∃',l:'\\exists'},
        ],
        trig: [
            {d:'sin',l:'\\sin'},{d:'cos',l:'\\cos'},{d:'tan',l:'\\tan'},{d:'cot',l:'\\cot'},
            {d:'sec',l:'\\sec'},{d:'csc',l:'\\csc'},{d:'sin⁻¹',l:'\\sin^{-1}'},{d:'cos⁻¹',l:'\\cos^{-1}'},
            {d:'tan⁻¹',l:'\\tan^{-1}'},{d:'log',l:'\\log'},{d:'log₂',l:'\\log_{2}'},
            {d:'ln',l:'\\ln'},{d:'lim',l:'\\lim_{x\\to a}'},{d:'d/dx',l:'\\frac{d}{dx}'},
            {d:'∂/∂x',l:'\\frac{\\partial}{\\partial x}'},{d:'∫',l:'\\int_{a}^{b}'},{d:'∬',l:'\\iint'},{d:'∮',l:'\\oint'},
        ],
        phys: [
            {d:'v⃗',l:'\\vec{v}'},{d:'F⃗',l:'\\vec{F}'},{d:'B⃗',l:'\\vec{B}'},{d:'E⃗',l:'\\vec{E}'},
            {d:'î',l:'\\hat{i}'},{d:'ĵ',l:'\\hat{j}'},{d:'k̂',l:'\\hat{k}'},{d:'n̂',l:'\\hat{n}'},
            {d:'ℏ',l:'\\hbar'},{d:'μ₀',l:'\\mu_0'},{d:'ε₀',l:'\\varepsilon_0'},{d:'∇',l:'\\nabla'},
            {d:'∇×',l:'\\nabla \\times'},{d:'∇·',l:'\\nabla \\cdot'},{d:'∝',l:'\\propto'},
            {d:'°',l:'^{\\circ}'},{d:'Å',l:'\\text{Å}'},{d:'eV',l:'\\text{eV}'},
        ],
    };
    let activeTab = 'greek';
    const symGrid = document.getElementById('latexSymGrid');
    function renderLatexTab(tab) {
        symGrid.innerHTML = '';
        SYMS[tab].forEach(function(sym) {
            const btn = document.createElement('button');
            btn.type = 'button'; btn.className = 'btn btn-sm btn-outline-secondary';
            btn.style.cssText = 'font-family:Georgia,serif;font-size:.82rem;padding:.15rem .45rem;min-width:2.4rem';
            btn.title = sym.l; btn.textContent = sym.d;
            btn.addEventListener('click', function() { insertFormula(sym.l); });
            symGrid.appendChild(btn);
        });
    }
    document.querySelectorAll('.latex-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('.latex-tab').forEach(function(t) {
                t.classList.replace('btn-primary','btn-outline-secondary'); t.classList.remove('active');
            });
            tab.classList.replace('btn-outline-secondary','btn-primary'); tab.classList.add('active');
            activeTab = tab.dataset.ltab; renderLatexTab(activeTab);
        });
    });
    renderLatexTab(activeTab);

    // ── Subject → Topic cascade ───────────────────────────────────────────────
    const subjectSel = document.getElementById('subjectSelect');
    const topicSel   = document.getElementById('topicSelect');
    const allTopics  = Array.from(topicSel.querySelectorAll('option[data-subject]'));
    function filterTopics(sid) {
        const val = sid ? String(sid) : '';
        topicSel.querySelectorAll('option[data-subject]').forEach(function(o){o.remove();});
        allTopics.forEach(function(o){ if (!val || o.dataset.subject === val) topicSel.appendChild(o); });
    }
    subjectSel.addEventListener('change', function(){ filterTopics(subjectSel.value); });
    filterTopics(subjectSel.value);

    // ── Tag picker ────────────────────────────────────────────────────────────
    const hiddenTagInput = document.getElementById('selectedTagIds');
    const badgesBox      = document.getElementById('tagBadges');
    const tagPicks       = document.querySelectorAll('.tag-pick');
    let selected = new Set((hiddenTagInput.value || '').split(',').map(Number).filter(Boolean));

    function refreshTags() {
        badgesBox.innerHTML = '';
        selected.forEach(function(id) {
            const opt = document.querySelector('.tag-pick[data-id="' + id + '"]');
            if (!opt) return;
            const span = document.createElement('span');
            span.className = 'badge bg-info text-white';
            span.style.cssText = 'font-size:.8rem;cursor:pointer';
            span.textContent = opt.dataset.name + ' ✕';
            span.addEventListener('click', function(){ selected.delete(id); refreshTags(); });
            badgesBox.appendChild(span);
        });
        hiddenTagInput.value = [...selected].join(',');
        tagPicks.forEach(function(o) {
            const id = Number(o.dataset.id);
            o.classList.toggle('bg-info',          selected.has(id));
            o.classList.toggle('text-white',        selected.has(id));
            o.classList.toggle('border-info',       selected.has(id));
            o.classList.toggle('text-secondary',   !selected.has(id));
            o.classList.toggle('border-secondary', !selected.has(id));
        });
    }
    tagPicks.forEach(function(o) {
        o.addEventListener('click', function() {
            const id = Number(o.dataset.id);
            selected.has(id) ? selected.delete(id) : selected.add(id);
            refreshTags();
        });
    });
    refreshTags();

    // ── Validation helper ─────────────────────────────────────────────────────
    function showClientError(msg, scrollId) {
        let bar = document.getElementById('clientValidationBar');
        if (!bar) {
            bar = document.createElement('div');
            bar.id = 'clientValidationBar';
            bar.className = 'alert alert-danger d-flex align-items-center gap-2 py-2 mt-3 mb-0';
            bar.style.cssText = 'border-radius:.375rem';
            bar.innerHTML = '<i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>' +
                '<span id="clientValidationMsg"></span>' +
                '<button type="button" class="btn-close ms-auto" onclick="document.getElementById(\'clientValidationBar\').style.display=\'none\'"></button>';
            const submitArea = document.querySelector('.d-grid.gap-2');
            if (submitArea) submitArea.before(bar);
            else document.getElementById('questionForm').appendChild(bar);
        }
        document.getElementById('clientValidationMsg').textContent = msg;
        bar.style.display = '';
        const target = scrollId ? document.getElementById(scrollId) : bar;
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
    function hideClientError() {
        const bar = document.getElementById('clientValidationBar');
        if (bar) bar.style.display = 'none';
    }

    // ── Form submit ───────────────────────────────────────────────────────────
    document.getElementById('questionForm').addEventListener('submit', function(e) {
        const sel = document.getElementById('qtypeSelect');
        const v = sel ? parseInt(sel.value) : 1;

        // ── Sync all rich editors ────────────────────────────────────────────
        // AR=7 and PBQ=8 use their own text editors, not the main question text
        if (v !== 7 && v !== 8) syncField(qText, 'Form_Text');
        syncField(qSolution, 'Form_Solution');
        if (v === 1 || v === 2) {
            syncField(qOptA, 'Form_OptionA');
            syncField(qOptB, 'Form_OptionB');
            syncField(qOptC, 'Form_OptionC');
            syncField(qOptD, 'Form_OptionD');
            syncField(qOptE, 'Form_OptionE');
        }
        if (v === 7) {   // AssertionReason
            syncField(qAssertion, 'Form_AssertionText');
            syncField(qReason,    'Form_ReasonText');
        }
        if (v === 8) {   // PassageBased
            if (qPassage) syncField(qPassage, 'Form_PassageTextContent');
            document.getElementById('Form_SubQuestionsJson').value = JSON.stringify(getSubQData());
        }
        if (v === 6) window.saveMtfJson();   // MatchTheFollowing
        if (v === 9) window.saveMmqJson();   // MatrixMatch
        if (v === 4) saveBlanksJson();        // FillInBlanks

        // ── Client-side validation ───────────────────────────────────────────

        // Require question text for all types except AR (7) and PBQ (8)
        if (v !== 7 && v !== 8) {
            const txt = (document.getElementById('Form_Text').value || '').trim();
            if (!txt) {
                e.preventDefault();
                const errDiv = document.getElementById('textError');
                const wrap   = document.getElementById('wrap-text');
                if (errDiv) errDiv.style.display = '';
                if (wrap)   wrap.style.borderColor = '#dc3545';
                document.getElementById('editor-text')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
            const errDiv = document.getElementById('textError');
            const wrap   = document.getElementById('wrap-text');
            if (errDiv) errDiv.style.display = 'none';
            if (wrap)   wrap.style.borderColor = '';
        }

        // MCQ / MSQ — require at least one option with text
        if (v === 1 || v === 2) {
            const optIds = ['Form_OptionA','Form_OptionB','Form_OptionC','Form_OptionD','Form_OptionE'];
            const hasOpts = optIds.some(function(id) {
                const el = document.getElementById(id);
                return el && (el.value || '').trim();
            });
            if (!hasOpts) {
                e.preventDefault();
                showClientError('MCQ/MSQ questions must have at least one option with text.', 'mcqOptionsCard');
                return;
            }
        }

        // FillInBlanks — require at least one blank + each blank must have a correct answer
        if (v === 4) {
            if (blanks.length === 0) {
                e.preventDefault();
                showClientError('Please add at least one blank answer. Use [BLANK_1] in the question text and click "Add Blank".', 'fibCard');
                return;
            }
            const emptyBlank = blanks.find(function(b) { return !b.correctAnswer || !b.correctAnswer.trim(); });
            if (emptyBlank) {
                e.preventDefault();
                showClientError('Blank #' + emptyBlank.blankIndex + ' is missing a correct answer. Please fill in all blank answers.', 'fibCard');
                return;
            }
        }

        // MatchTheFollowing — require at least one pair filled + one correct match
        if (v === 6) {
            var mtfRaw = document.getElementById('Form_MatchJson').value || '{}';
            try {
                var mtfData = JSON.parse(mtfRaw);
                if (!mtfData.items || mtfData.items.length < 2) {
                    e.preventDefault();
                    showClientError('Please fill in at least two items (one on each side) for Match the Following.', 'mtfCard');
                    return;
                }
                if (!mtfData.correct || mtfData.correct.length === 0) {
                    e.preventDefault();
                    showClientError('Please select at least one correct matching pair for Match the Following.', 'mtfCard');
                    return;
                }
            } catch (ex) {}
        }

        // MatrixMatch (MMQ) — require at least one row + col + one ticked cell
        if (v === 9) {
            var mmqRaw = document.getElementById('Form_MatchJson').value || '{}';
            try {
                var mmqData = JSON.parse(mmqRaw);
                var hasRow = (mmqData.items || []).some(function(i) { return i.side === 'row'; });
                var hasCol = (mmqData.items || []).some(function(i) { return i.side === 'col'; });
                if (!hasRow || !hasCol) {
                    e.preventDefault();
                    showClientError('Please fill in at least one row and one column for Matrix Match.', 'mmqCard');
                    return;
                }
                if (!mmqData.correct || mmqData.correct.length === 0) {
                    e.preventDefault();
                    showClientError('Please check at least one correct cell in the Matrix Match grid.', 'mmqCard');
                    return;
                }
            } catch (ex) {}
        }

        // AssertionReason — require both assertion and reason text
        if (v === 7) {
            const atxt = (document.getElementById('Form_AssertionText').value || '').trim();
            const rtxt = (document.getElementById('Form_ReasonText').value || '').trim();
            if (!atxt) {
                e.preventDefault();
                showClientError('Assertion (A) text is required.', 'arCard');
                return;
            }
            if (!rtxt) {
                e.preventDefault();
                showClientError('Reason (R) text is required.', 'arCard');
                return;
            }
        }

        // Required dropdowns — Subject, Topic, Difficulty, Complexity, Marks
        const reqSelects = [
            { id: 'Form_SubjectId',        label: 'Subject' },
            { id: 'Form_TopicId',          label: 'Topic' },
            { id: 'Form_DifficultyLevelId',label: 'Difficulty' },
            { id: 'Form_ComplexityLevelId',label: 'Complexity' },
            { id: 'Form_MarksId',          label: 'Positive Marks' },
            { id: 'Form_NegativeMarksId',  label: 'Negative Marks' }
        ];
        for (const s of reqSelects) {
            const el = document.getElementById(s.id);
            if (el && (el.value === '' || el.value === '0')) {
                e.preventDefault();
                showClientError(s.label + ' is required. Please select a value from the Classification / Marks panel.', null);
                el.focus();
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
        }

        // PassageBased — require passage text + at least one sub-question with option
        if (v === 8) {
            // Sync passage content first, then validate
            if (qPassage) syncField(qPassage, 'Form_PassageTextContent');
            const ptxt = (document.getElementById('Form_PassageTextContent').value || '').trim();
            if (!ptxt) {
                e.preventDefault();
                document.getElementById('wrap-passage').style.borderColor = '#dc3545';
                showClientError('Passage text is required. Please type the reading passage in the editor above.', 'pbqCard');
                return;
            }
            document.getElementById('wrap-passage').style.borderColor = '';
            const sqs = getSubQData();
            if (sqs.length === 0) {
                e.preventDefault();
                showClientError('Please add at least one sub-question. Click the "Add Sub-question" button.', 'pbqSubSection');
                return;
            }
            const sqNoOpts = sqs.find(function(sq) { return sq.options.length === 0; });
            if (sqNoOpts) {
                e.preventDefault();
                showClientError('Each sub-question must have at least one option filled in (A, B, C or D).', 'pbqSubSection');
                return;
            }
        }

        hideClientError();
    });

})();
</script>
}
