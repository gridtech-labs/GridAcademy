@page
@model GridAcademy.Pages.ContactModel
@{
    ViewData["Title"]      = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    ViewData["MetaDescription"] = "Get in touch with GridAcademy. Write to us at info@gridacademy.in or fill the contact form — we typically respond within 24 hours.";
    Layout = "_PublicLayout";
}

<!-- ── Page Hero ─────────────────────────────────────────────────────────── -->
<section class="page-hero">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item active">Contact Us</li>
            </ol>
        </nav>
        <h1><i class="bi bi-envelope-fill me-2"></i>Contact Us</h1>
        <p>Have a question or feedback? We'd love to hear from you.</p>
    </div>
</section>

<!-- ── Main Content ──────────────────────────────────────────────────────── -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">

            <!-- ── LEFT: Contact Form ──────────────────────────────────── -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                    <h2 class="fw-700 mb-1" style="color:var(--ga-blue);font-size:1.5rem;">Send Us a Message</h2>
                    <p class="text-muted mb-4" style="font-size:.9rem;">Fill the form below and our team will get back to you within 24 hours.</p>

                    @if (Model.SuccessMessage != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>@Model.SuccessMessage</span>
                        </div>
                    }
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3" role="alert">
                            <i class="bi bi-exclamation-circle-fill fs-5"></i>
                            <span>@Model.ErrorMessage</span>
                        </div>
                    }

                    <form method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <!-- Name -->
                            <div class="col-sm-6">
                                <label class="form-label fw-500" style="font-size:.875rem;">
                                    Full Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Name" class="form-control form-control-lg rounded-3"
                                       placeholder="Your full name"
                                       style="font-size:.95rem;" />
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-sm-6">
                                <label class="form-label fw-500" style="font-size:.875rem;">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Email" class="form-control form-control-lg rounded-3"
                                       placeholder="you@example.com" type="email"
                                       style="font-size:.95rem;" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-sm-6">
                                <label class="form-label fw-500" style="font-size:.875rem;">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text rounded-start-3" style="background:#f8f9fa;border-color:#dee2e6;">
                                        <i class="bi bi-telephone text-muted"></i>
                                    </span>
                                    <input asp-for="Input.Phone" class="form-control form-control-lg rounded-end-3"
                                           placeholder="+91 98765 43210" type="tel"
                                           style="font-size:.95rem;" />
                                </div>
                            </div>

                            <!-- Subject -->
                            <div class="col-sm-6">
                                <label class="form-label fw-500" style="font-size:.875rem;">
                                    Subject <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Subject" class="form-select form-select-lg rounded-3" style="font-size:.95rem;">
                                    <option value="">— Select a subject —</option>
                                    <option>Course / Exam Enquiry</option>
                                    <option>Technical Support</option>
                                    <option>Payment / Billing</option>
                                    <option>Partnership / Collaboration</option>
                                    <option>Feedback / Suggestion</option>
                                    <option>Other</option>
                                </select>
                                <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                            </div>

                            <!-- Message -->
                            <div class="col-12">
                                <label class="form-label fw-500" style="font-size:.875rem;">
                                    Message <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Input.Message" class="form-control rounded-3"
                                          rows="5" placeholder="Write your message here…"
                                          style="font-size:.95rem;resize:vertical;"></textarea>
                                <span asp-validation-for="Input.Message" class="text-danger small"></span>
                            </div>

                            <!-- Submit -->
                            <div class="col-12 pt-1">
                                <button type="submit" class="btn btn-lg w-100 fw-600 rounded-3"
                                        style="background:var(--ga-blue);color:#fff;font-size:1rem;padding:.75rem;">
                                    <i class="bi bi-send-fill me-2"></i>Send Message
                                </button>
                                <p class="text-muted mt-2 mb-0" style="font-size:.8rem;text-align:center;">
                                    <i class="bi bi-shield-check me-1"></i>
                                    We respect your privacy. Your information will not be shared with third parties.
                                </p>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── RIGHT: Contact Info ─────────────────────────────────── -->
            <div class="col-lg-5">

                <!-- Direct Contact -->
                <div class="card border-0 rounded-4 mb-4" style="background:var(--ga-blue);color:#fff;">
                    <div class="card-body p-4">
                        <h3 class="fw-600 mb-3" style="font-size:1.2rem;">
                            <i class="bi bi-headset me-2" style="color:#f8c95b;"></i>Get In Touch Directly
                        </h3>
                        <ul class="list-unstyled mb-0" style="line-height:1;">
                            <li class="mb-3 d-flex align-items-start gap-3">
                                <div style="width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-envelope-fill" style="color:#f8c95b;"></i>
                                </div>
                                <div>
                                    <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-bottom:2px;">Email Us</div>
                                    <a href="mailto:info@gridacademy.in" style="color:#fff;font-weight:600;text-decoration:none;font-size:.95rem;">info@gridacademy.in</a>
                                </div>
                            </li>
                            <li class="mb-3 d-flex align-items-start gap-3">
                                <div style="width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-telephone-fill" style="color:#f8c95b;"></i>
                                </div>
                                <div>
                                    <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-bottom:2px;">Call Us</div>
                                    <a href="tel:+918000000000" style="color:#fff;font-weight:600;text-decoration:none;font-size:.95rem;">+91 80000 00000</a>
                                </div>
                            </li>
                            <li class="d-flex align-items-start gap-3">
                                <div style="width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                    <i class="bi bi-clock-fill" style="color:#f8c95b;"></i>
                                </div>
                                <div>
                                    <div style="font-size:.75rem;color:rgba(255,255,255,.6);margin-bottom:2px;">Support Hours</div>
                                    <span style="font-weight:600;font-size:.95rem;">Mon – Sat, 9:00 AM – 6:00 PM IST</span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Response Time -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h3 class="fw-600 mb-3" style="font-size:1.1rem;color:var(--ga-blue);">
                            <i class="bi bi-lightning-charge-fill me-2" style="color:var(--ga-orange);"></i>What to Expect
                        </h3>
                        <ul class="list-unstyled mb-0" style="font-size:.875rem;">
                            <li class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill" style="color:#28a745;font-size:.9rem;"></i>
                                Email replies within <strong>24 hours</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill" style="color:#28a745;font-size:.9rem;"></i>
                                Technical issues resolved within <strong>48 hours</strong>
                            </li>
                            <li class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill" style="color:#28a745;font-size:.9rem;"></i>
                                Payment queries resolved within <strong>24 hours</strong>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Follow Us -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h3 class="fw-600 mb-3" style="font-size:1.1rem;color:var(--ga-blue);">
                            <i class="bi bi-share-fill me-2" style="color:var(--ga-orange);"></i>Follow Us
                        </h3>
                        <div class="d-flex flex-wrap gap-2">
                            <a href="#" class="btn btn-sm rounded-pill d-flex align-items-center gap-1"
                               style="background:#1877f2;color:#fff;font-size:.8rem;padding:.35rem .9rem;">
                                <i class="bi bi-facebook"></i> Facebook
                            </a>
                            <a href="#" class="btn btn-sm rounded-pill d-flex align-items-center gap-1"
                               style="background:linear-gradient(135deg,#f58529,#dd2a7b,#8134af);color:#fff;font-size:.8rem;padding:.35rem .9rem;">
                                <i class="bi bi-instagram"></i> Instagram
                            </a>
                            <a href="#" class="btn btn-sm rounded-pill d-flex align-items-center gap-1"
                               style="background:#ff0000;color:#fff;font-size:.8rem;padding:.35rem .9rem;">
                                <i class="bi bi-youtube"></i> YouTube
                            </a>
                            <a href="#" class="btn btn-sm rounded-pill d-flex align-items-center gap-1"
                               style="background:#229ed9;color:#fff;font-size:.8rem;padding:.35rem .9rem;">
                                <i class="bi bi-telegram"></i> Telegram
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- ── FAQ Strip ──────────────────────────────────────────────── -->
        <div class="row mt-5 pt-2">
            <div class="col-12 text-center mb-4">
                <h2 class="fw-700" style="color:var(--ga-blue);">Frequently Asked Questions</h2>
                <p class="text-muted">Quick answers to common queries.</p>
            </div>
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                    <h6 class="fw-600" style="color:var(--ga-blue);">How do I enroll in a course?</h6>
                    <p class="text-muted mb-0" style="font-size:.875rem;">Browse our courses, click "Enroll Now" and complete the payment. You'll get instant access to all content.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                    <h6 class="fw-600" style="color:var(--ga-blue);">What payment methods are accepted?</h6>
                    <p class="text-muted mb-0" style="font-size:.875rem;">We accept UPI, Net Banking, Credit/Debit cards and popular wallets via Razorpay's secure gateway.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 mb-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                    <h6 class="fw-600" style="color:var(--ga-blue);">How can I get a refund?</h6>
                    <p class="text-muted mb-0" style="font-size:.875rem;">Email us at <a href="mailto:info@gridacademy.in" style="color:var(--ga-blue);">info@gridacademy.in</a> within 7 days of purchase. Refunds are processed within 5–7 business days.</p>
                </div>
            </div>
        </div>

    </div>
</section>

@section Styles {
<style>
    .fw-500 { font-weight: 500; }
    .fw-600 { font-weight: 600; }
    .fw-700 { font-weight: 700; }
    .form-control:focus, .form-select:focus { border-color: var(--ga-blue); box-shadow: 0 0 0 .2rem rgba(26,58,107,.15); }
    .card { transition: transform .15s; }
</style>
}
