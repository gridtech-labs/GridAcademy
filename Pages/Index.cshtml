@page
@model GridAcademy.Pages.IndexModel
@using GridAcademy.DTOs.Marketplace
@{
    ViewData["Title"]            = "India's Simplest Mock Test Platform";
    ViewData["ActivePage"]       = "Home";
    ViewData["MetaDescription"]  = "Practice for JEE, NEET, UPSC, SSC, RRB and more — clean, focused, distraction-free mock tests by GridAcademy.";
    Layout = "_PublicLayout";
}

@section Styles {
<style>
    /* ── Hero ───────────────────────────────────────────────── */
    .ga-hero {
        padding: 5rem 0 4.5rem;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        text-align: center;
    }
    .ga-hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
        margin-bottom: 1rem;
        letter-spacing: -.02em;
    }
    .ga-hero p {
        font-size: 1.1rem;
        color: #6b7280;
        max-width: 520px;
        margin: 0 auto 2rem;
        line-height: 1.7;
    }
    .btn-hero {
        background: #1760f4;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: .85rem 2.2rem;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
        transition: background .15s, transform .1s;
        box-shadow: 0 4px 14px rgba(23,96,244,.25);
    }
    .btn-hero:hover { background: #0e4dd4; color: #fff; transform: translateY(-1px); }
    .btn-hero-outline {
        background: transparent;
        color: #374151;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: .85rem 2rem;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        display: inline-block;
        transition: border-color .15s, color .15s;
    }
    .btn-hero-outline:hover { border-color: #1760f4; color: #1760f4; }

    /* ── Category chips ──────────────────────────────────────── */
    .cat-chip {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .55rem 1.1rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 50px;
        background: #f9fafb;
        color: #374151;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background .12s, border-color .12s, color .12s;
        white-space: nowrap;
    }
    .cat-chip:hover  { background: #1760f4; border-color: #1760f4; color: #fff; }
    .cat-chip:hover .cat-count { background: rgba(255,255,255,.25); color: #fff; }
    .cat-count {
        background: #e5e7eb;
        color: #6b7280;
        border-radius: 50px;
        padding: .1rem .5rem;
        font-size: .75rem;
        font-weight: 700;
        line-height: 1.5;
        transition: background .12s, color .12s;
    }

    /* ── Section heading ─────────────────────────────────────── */
    .sec-heading { font-size: 1.3rem; font-weight: 700; color: #111827; margin-bottom: 0; }
    .sec-divider  { border: none; border-top: 1px solid #e5e7eb; margin: .7rem 0 1.75rem; }

    /* ── Test card ───────────────────────────────────────────── */
    .ga-card {
        background: #fff;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: box-shadow .15s, border-color .15s, transform .12s;
    }
    .ga-card:hover {
        box-shadow: 0 6px 24px rgba(0,0,0,.09);
        border-color: #c7d2fe;
        transform: translateY(-2px);
    }
    .ga-card-accent {
        height: 5px;
        border-radius: 12px 12px 0 0;
        background: linear-gradient(90deg, #1760f4, #6366f1);
    }
    .ga-card-body  { padding: 1.5rem 1.6rem; flex: 1; display: flex; flex-direction: column; }
    .ga-card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: .5rem;
        line-height: 1.4;
    }
    .ga-card-meta  { font-size: .875rem; color: #6b7280; margin-bottom: .85rem; display: flex; flex-wrap: wrap; gap: .6rem; }
    .ga-card-meta span { display: inline-flex; align-items: center; gap: .3rem; }
    .ga-card-footer { padding: 1rem 1.6rem; border-top: 1px solid #e5e7eb; }

    /* ── Price / free badge ──────────────────────────────────── */
    .badge-free  { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; border-radius: 6px; padding: .25rem .65rem; font-size: .8rem; font-weight: 700; }
    .badge-price { font-size: .95rem; font-weight: 700; color: #374151; }

    /* ── Card CTA buttons ────────────────────────────────────── */
    .btn-card {
        display: block; text-align: center;
        background: #1760f4; color: #fff;
        border-radius: 8px; padding: .7rem;
        font-weight: 700; font-size: .95rem;
        text-decoration: none;
        transition: background .15s;
    }
    .btn-card:hover { background: #0e4dd4; color: #fff; }
    .btn-card-outline {
        display: block; text-align: center;
        background: #fff; color: #1760f4;
        border: 1.5px solid #1760f4; border-radius: 8px; padding: .7rem;
        font-weight: 700; font-size: .95rem;
        text-decoration: none;
        transition: background .15s, color .15s;
    }
    .btn-card-outline:hover { background: #1760f4; color: #fff; }
</style>
}

<!-- ══════════════════════════════ HERO ════════════════════════════════════ -->
<section class="ga-hero">
    <div class="container">
        <h1>Practice Smart.<br/>Clear Any Exam.</h1>
        <p>
            Free &amp; premium mock tests for JEE, NEET, UPSC, SSC, RRB and more —<br class="d-none d-sm-inline"/>
            NTA-style interface, real exam pattern.
        </p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="/Courses" class="btn-hero">
                <i class="bi bi-collection-play me-2"></i>Browse Free Tests
            </a>
            <a href="/Account/Login" class="btn-hero-outline">
                <i class="bi bi-person me-2"></i>Student Login
            </a>
        </div>
        <div class="d-flex flex-wrap gap-4 mt-4 justify-content-center" style="font-size:.85rem;color:#9ca3af;">
            <span><i class="bi bi-patch-check-fill me-1" style="color:#1760f4;"></i>No signup needed to browse</span>
            <span><i class="bi bi-shield-check me-1" style="color:#1760f4;"></i>100% free tests available</span>
            <span><i class="bi bi-phone me-1" style="color:#1760f4;"></i>Works on mobile &amp; desktop</span>
        </div>
    </div>
</section>

@if (Model.Data != null)
{
    <!-- ══════════════════════════════ EXAM CATEGORIES ═════════════════════ -->
    @if (Model.Data.ExamCategories.Count > 0)
    {
        <section class="py-5" style="background:#fff;">
            <div class="container">
                <p class="sec-heading">Browse by Exam</p>
                <hr class="sec-divider" />
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var cat in Model.Data.ExamCategories)
                    {
                        <a href="/Courses?category=@cat.Slug" class="cat-chip">
                            @if (!string.IsNullOrEmpty(cat.Emoji)) { <span>@cat.Emoji</span> }
                            @cat.Name
                            @if (cat.SeriesCount > 0) { <span class="cat-count">@cat.SeriesCount</span> }
                        </a>
                    }
                    <a href="/Courses" class="cat-chip" style="border-style:dashed;background:transparent;">
                        All Tests <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>
    }

    <!-- ══════════════════════════════ FREE TESTS ══════════════════════════ -->
    @if (Model.Data.FreeTests.Count > 0)
    {
        <section class="py-5" style="background:#f9fafb;border-top:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between">
                    <p class="sec-heading mb-0">Free Mock Tests</p>
                    <a href="/Courses" style="font-size:.875rem;color:#1760f4;text-decoration:none;font-weight:600;">
                        See all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <hr class="sec-divider" />
                <div class="row g-4 row-cols-1 row-cols-sm-2">
                    @foreach (var series in Model.Data.FreeTests.Take(4))
                    {
                        <div class="col">
                            <div class="ga-card">
                                <div class="ga-card-accent"></div>
                                <div class="ga-card-body">
                                    <div class="ga-card-title">@series.Title</div>
                                    <div class="ga-card-meta">
                                        @if (!string.IsNullOrEmpty(series.ExamTypeName))
                                        {
                                            <span><i class="bi bi-mortarboard"></i>@series.ExamTypeName</span>
                                        }
                                        <span><i class="bi bi-file-text"></i>@series.TestCount test@(series.TestCount != 1 ? "s" : "")</span>
                                    </div>
                                    <div class="mt-auto">
                                        <span class="badge-free">FREE</span>
                                    </div>
                                </div>
                                <div class="ga-card-footer">
                                    <a href="/Series/@series.Slug" class="btn-card">
                                        Start Test <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ══════════════════════════════ TOP SELLING ═════════════════════════ -->
    @if (Model.Data.TopSelling.Count > 0)
    {
        <section class="py-5" style="background:#fff;">
            <div class="container">
                <div class="d-flex align-items-center justify-content-between">
                    <p class="sec-heading mb-0">Popular Test Series</p>
                    <a href="/Courses" style="font-size:.875rem;color:#1760f4;text-decoration:none;font-weight:600;">
                        See all <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <hr class="sec-divider" />
                <div class="row g-4 row-cols-1 row-cols-sm-2">
                    @foreach (var series in Model.Data.TopSelling.Take(4))
                    {
                        <div class="col">
                            <div class="ga-card">
                                <div class="ga-card-accent" style="background:linear-gradient(90deg,#f59e0b,#ef4444);"></div>
                                <div class="ga-card-body">
                                    <div class="ga-card-title">@series.Title</div>
                                    <div class="ga-card-meta">
                                        @if (!string.IsNullOrEmpty(series.ExamTypeName))
                                        {
                                            <span><i class="bi bi-mortarboard"></i>@series.ExamTypeName</span>
                                        }
                                        <span><i class="bi bi-file-text"></i>@series.TestCount test@(series.TestCount != 1 ? "s" : "")</span>
                                        @if (series.PurchaseCount > 0)
                                        {
                                            <span><i class="bi bi-people"></i>@series.PurchaseCount enrolled</span>
                                        }
                                    </div>
                                    <div class="mt-auto d-flex align-items-center justify-content-between">
                                        @if (series.PriceInr == 0)
                                        {
                                            <span class="badge-free">FREE</span>
                                        }
                                        else if (series.IsFirstTestFree)
                                        {
                                            <div class="d-flex gap-2 align-items-center">
                                                <span class="badge-price">₹@series.PriceInr.ToString("0")</span>
                                                <span class="badge-free">1st free</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge-price">₹@series.PriceInr.ToString("0")</span>
                                        }
                                        @if (series.AvgRating > 0)
                                        {
                                            <span style="font-size:.82rem;color:#6b7280;">
                                                <i class="bi bi-star-fill" style="color:#f59e0b;"></i>
                                                @series.AvgRating.ToString("0.0")
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="ga-card-footer">
                                    @if (series.PriceInr == 0 || series.IsFirstTestFree)
                                    {
                                        <a href="/Series/@series.Slug" class="btn-card">
                                            Start Test <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Series/@series.Slug" class="btn-card-outline">
                                            View Series <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}
else
{
    <section class="py-5">
        <div class="container text-center py-5">
            <i class="bi bi-collection-play" style="font-size:3rem;color:#d1d5db;display:block;margin-bottom:1rem;"></i>
            <p style="color:#6b7280;font-size:1rem;">Content is loading. Please refresh in a moment.</p>
            <a href="/Courses" class="btn-hero mt-2">Browse All Tests</a>
        </div>
    </section>
}

<!-- ══════════════════════════════ WHY US STRIP ═══════════════════════════ -->
