    <div class="container">
        <p class="sec-heading text-center mb-0">Why GridAcademy?</p>
        <hr class="sec-divider" />
        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-4 text-center">
            <div class="col">
                <i class="bi bi-ui-checks-grid" style="font-size:2rem;color:#1760f4;"></i>
                <div style="font-weight:700;color:#111827;margin:.6rem 0 .3rem;font-size:1rem;">NTA-Style Interface</div>
                <div style="font-size:.875rem;color:#6b7280;line-height:1.6;">Exactly like the real exam. No surprises on test day.</div>
            </div>
            <div class="col">
                <i class="bi bi-graph-up-arrow" style="font-size:2rem;color:#1760f4;"></i>
                <div style="font-weight:700;color:#111827;margin:.6rem 0 .3rem;font-size:1rem;">Detailed Analytics</div>
                <div style="font-size:.875rem;color:#6b7280;line-height:1.6;">Section-wise scores, time analysis and percentile rank.</div>
            </div>
            <div class="col">
                <i class="bi bi-people" style="font-size:2rem;color:#1760f4;"></i>
                <div style="font-weight:700;color:#111827;margin:.6rem 0 .3rem;font-size:1rem;">Expert-Curated Tests</div>
                <div style="font-size:.875rem;color:#6b7280;line-height:1.6;">Questions vetted by experienced educators and toppers.</div>
            </div>
            <div class="col">
                <i class="bi bi-phone" style="font-size:2rem;color:#1760f4;"></i>
                <div style="font-weight:700;color:#111827;margin:.6rem 0 .3rem;font-size:1rem;">Works on Any Device</div>
                <div style="font-size:.875rem;color:#6b7280;line-height:1.6;">Desktop, tablet or mobile — seamless across all screens.</div>
            </div>
        </div>
    </div>
</section>
