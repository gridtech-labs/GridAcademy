@page
@model GridAcademy.Pages.IndexModel
@using GridAcademy.DTOs.Marketplace
@{
    ViewData["Title"]           = "India's Simplest Mock Test Platform";
    ViewData["ActivePage"]      = "Home";
    ViewData["MetaDescription"] = "Practice for JEE, NEET, UPSC, SSC, RRB and more — clean, focused, distraction-free mock tests by GridAcademy.";
    Layout = "_PublicLayout";

    // Palette for category accent rings (cycles)
    var palettes = new[] {
        ("#1760f4","#e0e9ff"), ("#16a34a","#dcfce7"), ("#dc2626","#fee2e2"),
        ("#d97706","#fef3c7"), ("#7c3aed","#ede9fe"), ("#0891b2","#cffafe"),
        ("#db2777","#fce7f3"), ("#65a30d","#ecfccb")
    };
}

@section Styles {
<style>
    /* ── Hero ────────────────────────────────────────────────────── */
    .ga-hero {
        padding: 4rem 0 3.5rem;
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        text-align: center;
    }
    .ga-hero h1 {
        font-size: clamp(1.9rem, 4.5vw, 2.75rem);
        font-weight: 800;
        color: #111827;
        line-height: 1.2;
        letter-spacing: -.02em;
        margin-bottom: .9rem;
    }
    .ga-hero p {
        font-size: 1.05rem;
        color: #6b7280;
        max-width: 500px;
        margin: 0 auto 1.75rem;
        line-height: 1.65;
    }
    .btn-hero {
        display: inline-block;
        background: #1760f4;
        color: #fff;
        border-radius: 8px;
        padding: .8rem 2rem;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(23,96,244,.22);
        transition: background .15s, transform .1s;
    }
    .btn-hero:hover { background: #0e4dd4; color: #fff; transform: translateY(-1px); }
    .btn-hero-ghost {
        display: inline-block;
        color: #374151;
        border: 1.5px solid #e5e7eb;
        border-radius: 8px;
        padding: .8rem 1.8rem;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        transition: border-color .15s, color .15s;
    }
    .btn-hero-ghost:hover { border-color: #1760f4; color: #1760f4; }

    /* ── Category filter chips ───────────────────────────────────── */
    .cat-strip {
        background: #fff;
        border-bottom: 1px solid #e5e7eb;
        padding: 1.25rem 0;
        position: sticky;
        top: 57px;
        z-index: 100;
    }
    .cat-chip {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .5rem 1.1rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 50px;
        background: #f9fafb;
        color: #374151;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .12s;
        white-space: nowrap;
    }
    .cat-chip:hover { background: #1760f4; border-color: #1760f4; color: #fff; }
    .cat-chip .cnt { background: #e5e7eb; color: #6b7280; border-radius: 50px; padding: .1rem .45rem; font-size: .72rem; font-weight: 700; transition: all .12s; }
    .cat-chip:hover .cnt { background: rgba(255,255,255,.3); color: #fff; }

    /* ── Section heading ─────────────────────────────────────────── */
    .sec-label {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        background: linear-gradient(90deg, #1760f4, #6366f1);
        color: #fff;
        border-radius: 6px;
        padding: .3rem .85rem;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        margin-bottom: .65rem;
    }
    .sec-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #111827;
        margin-bottom: 1.5rem;
        letter-spacing: -.01em;
    }

    /* ── Exam icon card ──────────────────────────────────────────── */
    .exam-card {
        background: #fff;
        border: 1.5px solid #e8eaf0;
        border-radius: 14px;
        padding: 1.6rem 1rem 1.3rem;
        text-align: center;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        transition: box-shadow .15s, border-color .15s, transform .12s;
        cursor: pointer;
    }
    .exam-card:hover {
        box-shadow: 0 8px 28px rgba(0,0,0,.1);
        border-color: #c7d2fe;
        transform: translateY(-3px);
        text-decoration: none;
    }
    .exam-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.85rem;
        line-height: 1;
        border: 3px solid transparent;
        flex-shrink: 0;
    }
    .exam-name {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.35;
    }
    .exam-meta {
        font-size: .82rem;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: .3rem;
    }
    .badge-free {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 6px;
        padding: .2rem .55rem;
        font-size: .75rem;
        font-weight: 700;
    }
    .badge-paid {
        background: #fefce8;
        color: #854d0e;
        border: 1px solid #fde68a;
        border-radius: 6px;
        padding: .2rem .55rem;
        font-size: .75rem;
        font-weight: 700;
    }

    /* ── Category section ────────────────────────────────────────── */
    .cat-section { scroll-margin-top: 115px; }
    .sec-divider { border: none; border-top: 1px solid #f3f4f6; margin: 0 0 2rem; }
</style>
}

<!-- ═══════════════════════ HERO ══════════════════════════════════════════ -->
<section class="ga-hero">
    <div class="container">
        <h1>Free Mock Tests for<br/>Every Competitive Exam</h1>
        <p>JEE · NEET · UPSC · SSC · RRB · Banking — NTA-style interface, real exam pattern.</p>
        <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="#exams" class="btn-hero"><i class="bi bi-collection-play me-2"></i>Start Practicing — It's Free</a>
            <a href="/Account/Login" class="btn-hero-ghost"><i class="bi bi-person me-2"></i>Student Login</a>
        </div>
    </div>
</section>

@if (Model.Data != null)
{
    var groups = Model.Data.ByCategory.Where(g => g.Series.Count > 0).ToList();

    @if (groups.Count > 0 || Model.Data.ExamCategories.Count > 0)
    {
        <!-- ═══════════════════════ STICKY CATEGORY STRIP ════════════════════ -->
        <div class="cat-strip" id="exams">
            <div class="container">
                <div class="d-flex flex-wrap gap-2">
                    @{
                        var displayGroups = groups.Count > 0 ? groups : null;
                        var displayCats   = Model.Data.ExamCategories.Where(c => c.SeriesCount > 0).ToList();
                        var chips = displayGroups != null
                            ? displayGroups.Select(g => (Name: g.CategoryName, Slug: g.CategorySlug, Emoji: g.Emoji, Count: g.Series.Count)).ToList()
                            : displayCats.Select(c => (Name: c.Name, Slug: c.Slug, Emoji: c.Emoji, Count: c.SeriesCount)).ToList();
                    }
                    @foreach (var chip in chips)
                    {
                        <a href="#cat-@chip.Slug" class="cat-chip">
                            @if (!string.IsNullOrEmpty(chip.Emoji)) { <span>@chip.Emoji</span> }
                            @chip.Name
                            <span class="cnt">@chip.Count</span>
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- ═══════════════════════ EXAM SECTIONS BY CATEGORY ═══════════════ -->
        <div style="background:#f9fafb; padding: 3rem 0;">
            <div class="container">

                @if (groups.Count > 0)
                {
                    @for (int gi = 0; gi < groups.Count; gi++)
                    {
                        var group = groups[gi];
                        var (accent, ring) = palettes[gi % palettes.Length];

                        <section class="cat-section @(gi > 0 ? "mt-5" : "")" id="cat-@group.CategorySlug">
                            <div class="sec-label" style="background:linear-gradient(90deg,@accent,@accent)dd;">
                                @if (!string.IsNullOrEmpty(group.Emoji)) { <span>@group.Emoji</span> }
                                @group.CategoryName.ToUpper()
                            </div>
                            <p class="sec-title">Free Mock Tests — @group.CategoryName</p>
                            <hr class="sec-divider" />

                            <div class="row g-3 row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-5">
                                @foreach (var s in group.Series)
                                {
                                    var initial = s.Title.Length > 0 ? s.Title[0].ToString().ToUpper() : "E";
                                    <div class="col">
                                        <a href="/Series/@s.Slug" class="exam-card">
                                            <div class="exam-icon" style="background:@ring; border-color:@accent; color:@accent;">
                                                @if (!string.IsNullOrEmpty(group.Emoji))
                                                {
                                                    <span>@group.Emoji</span>
                                                }
                                                else
                                                {
                                                    <span style="font-size:1.4rem; font-weight:800;">@initial</span>
                                                }
                                            </div>
                                            <div class="exam-name">@s.Title</div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap justify-content-center">
                                                <span class="exam-meta"><i class="bi bi-file-text"></i>@s.TestCount test@(s.TestCount != 1 ? "s" : "")</span>
                                                @if (s.PriceInr == 0)
                                                {
                                                    <span class="badge-free">FREE</span>
                                                }
                                                else if (s.IsFirstTestFree)
                                                {
                                                    <span class="badge-free">1st Free</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-paid">₹@s.PriceInr.ToString("0")</span>
                                                }
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
                else
                {
                    <!-- No series yet — show category placeholders -->
                    @for (int ci = 0; ci < Math.Min(displayCats.Count, 6); ci++)
                    {
                        var cat = displayCats[ci];
                        var (accent, ring) = palettes[ci % palettes.Length];
                        <section class="cat-section @(ci > 0 ? "mt-5" : "")" id="cat-@cat.Slug">
                            <div class="sec-label" style="background:linear-gradient(90deg,@accent,@accent)dd;">
                                @if (!string.IsNullOrEmpty(cat.Emoji)) { <span>@cat.Emoji</span> }
                                @cat.Name.ToUpper()
                            </div>
                            <p class="sec-title">Free Mock Tests — @cat.Name</p>
                            <hr class="sec-divider" />
                            <p style="color:#6b7280; font-size:.95rem; padding: 1.5rem 0;">
                                Tests coming soon. <a href="/Courses" style="color:#1760f4; font-weight:600;">Browse all available tests →</a>
                            </p>
                        </section>
                    }
                }

            </div>
        </div>
    }
    else
    {
        <section class="py-5">
            <div class="container text-center py-5">
                <i class="bi bi-collection-play" style="font-size:3rem; color:#d1d5db; display:block; margin-bottom:1rem;"></i>
                <p style="color:#6b7280; font-size:1rem;">Tests are loading. Please refresh in a moment.</p>
                <a href="/Courses" class="btn-hero mt-2">Browse All Tests</a>
            </div>
        </section>
    }
}
else
{
    <section class="py-5">
        <div class="container text-center py-5">
            <i class="bi bi-wifi-off" style="font-size:2.5rem; color:#d1d5db; display:block; margin-bottom:1rem;"></i>
            <p style="color:#6b7280; font-size:1rem;">Content is loading. Please refresh in a moment.</p>
            <a href="/Courses" class="btn-hero mt-2">Browse All Tests</a>
        </div>
    </section>
}

@section Scripts {
<script>
// Smooth scroll for anchor links
document.querySelectorAll('a[href^="#cat-"]').forEach(a => {
    a.addEventListener('click', e => {
        const target = document.querySelector(a.getAttribute('href'));
        if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
    });
});
// Anchor scroll for #exams
document.querySelector('a[href="#exams"]')?.addEventListener('click', e => {
    const target = document.getElementById('exams');
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
});
</script>
}
