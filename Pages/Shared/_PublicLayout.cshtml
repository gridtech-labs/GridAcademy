<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GridAcademy</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "GridAcademy — India's premier online learning platform for competitive exams. JEE, NEET, UPSC, SSC, RRB and more.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --ga-blue:      #1a3a6b;
            --ga-blue-light:#2453a1;
            --ga-orange:    #f47c20;
            --ga-orange-lt: #fef3e8;
        }
        body { font-family: 'Inter', sans-serif; color: #333; }

        /* ── Navbar ── */
        .ga-navbar {
            background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,.08);
            padding: .75rem 0;
            position: sticky; top: 0; z-index: 1000;
        }
        .ga-navbar .navbar-brand {
            display: flex; align-items: center; gap: .6rem;
            font-weight: 700; font-size: 1.25rem; color: var(--ga-blue);
            text-decoration: none;
        }
        .ga-navbar .navbar-brand .logo-icon {
            width: 38px; height: 38px;
            background: var(--ga-blue); border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }
        .ga-navbar .navbar-brand .logo-icon i { color: #fff; font-size: 1.1rem; }
        .ga-navbar .brand-sub { font-size: .65rem; font-weight: 400; color: #888; display: block; line-height: 1; }
        .ga-navbar .nav-link { color: #555; font-weight: 500; padding: .5rem 1rem !important; border-radius: 6px; transition: all .2s; }
        .ga-navbar .nav-link:hover, .ga-navbar .nav-link.active { color: var(--ga-blue); background: #f0f4ff; }
        .ga-navbar .btn-login {
            background: var(--ga-blue); color: #fff !important; padding: .45rem 1.25rem !important;
            border-radius: 20px; font-weight: 600; font-size: .875rem;
        }
        .ga-navbar .btn-login:hover { background: var(--ga-blue-light); }

        /* ── Footer ── */
        .ga-footer { background: #0e2347; color: #cdd8ea; padding: 3.5rem 0 1.5rem; margin-top: auto; }
        .ga-footer h5 { color: #fff; font-weight: 600; margin-bottom: 1rem; }
        .ga-footer a { color: #aebdd6; text-decoration: none; transition: color .2s; }
        .ga-footer a:hover { color: #fff; }
        .ga-footer .footer-brand { font-size: 1.3rem; font-weight: 700; color: #fff; }
        .ga-footer .footer-brand small { font-size: .7rem; font-weight: 300; color: #7e9ac0; display: block; }
        .ga-footer .social-link {
            width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,.1);
            display: inline-flex; align-items: center; justify-content: center;
            color: #fff; transition: background .2s;
        }
        .ga-footer .social-link:hover { background: var(--ga-orange); color: #fff; }
        .ga-footer .footer-bottom { border-top: 1px solid rgba(255,255,255,.1); margin-top: 2rem; padding-top: 1.25rem; font-size: .82rem; color: #6e88a8; }

        /* ── Page Hero ── */
        .page-hero { background: linear-gradient(135deg, var(--ga-blue) 0%, var(--ga-blue-light) 100%); color: #fff; padding: 3.5rem 0 3rem; }
        .page-hero h1 { font-weight: 700; font-size: 2rem; margin-bottom: .4rem; }
        .page-hero p  { color: rgba(255,255,255,.8); margin: 0; }
        .page-hero .breadcrumb-item, .page-hero .breadcrumb-item a { color: rgba(255,255,255,.7); font-size: .875rem; }
        .page-hero .breadcrumb-item.active { color: rgba(255,255,255,.95); }
        .page-hero .breadcrumb-item + .breadcrumb-item::before { color: rgba(255,255,255,.5); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

<!-- ══════════════════════════════ NAVBAR ══════════════════════════════════ -->
<nav class="ga-navbar navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">
            <div class="logo-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
            <div>
                GridAcademy
                <span class="brand-sub">Learn · Practice · Excel</span>
            </div>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Courses" ? "active" : "")" href="/Courses">Courses</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "About" ? "active" : "")" href="/About">About Us</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Contact" ? "active" : "")" href="/Contact">Contact</a></li>
                <li class="nav-item ms-2"><a class="nav-link btn-login" href="/Account/Login">Login</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- ══════════════════════════════ CONTENT ═════════════════════════════════ -->
<main class="flex-grow-1">
    @RenderBody()
</main>

<!-- ══════════════════════════════ FOOTER ══════════════════════════════════ -->
<footer class="ga-footer">
    <div class="container">
        <div class="row g-4">
            <!-- Brand -->
            <div class="col-lg-4">
                <div class="footer-brand mb-2">
                    <i class="bi bi-grid-3x3-gap-fill me-2" style="color:var(--ga-orange)"></i>GridAcademy
                    <small>India's Premier Exam Preparation Platform</small>
                </div>
                <p style="font-size:.875rem;color:#8aa5c8;line-height:1.7;">
                    Empowering students across India to crack competitive exams with high-quality content,
                    adaptive practice tests, and expert-curated study material.
                </p>
                <div class="d-flex gap-2 mt-3">
                    <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link" title="YouTube"><i class="bi bi-youtube"></i></a>
                    <a href="#" class="social-link" title="Telegram"><i class="bi bi-telegram"></i></a>
                    <a href="#" class="social-link" title="Twitter/X"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
            <!-- Quick Links -->
            <div class="col-6 col-lg-2 offset-lg-1">
                <h5>Quick Links</h5>
                <ul class="list-unstyled" style="font-size:.875rem;line-height:2;">
                    <li><a href="/"><i class="bi bi-chevron-right me-1" style="font-size:.7rem;"></i>Home</a></li>
                    <li><a href="/Courses"><i class="bi bi-chevron-right me-1" style="font-size:.7rem;"></i>Courses</a></li>
                    <li><a href="/About"><i class="bi bi-chevron-right me-1" style="font-size:.7rem;"></i>About Us</a></li>
                    <li><a href="/Contact"><i class="bi bi-chevron-right me-1" style="font-size:.7rem;"></i>Contact</a></li>
                    <li><a href="/Account/Login"><i class="bi bi-chevron-right me-1" style="font-size:.7rem;"></i>Student Login</a></li>
                </ul>
            </div>
            <!-- Exams -->
            <div class="col-6 col-lg-2">
                <h5>Exams</h5>
                <ul class="list-unstyled" style="font-size:.875rem;line-height:2;">
                    <li><a href="/Courses">JEE Mains &amp; Advanced</a></li>
                    <li><a href="/Courses">NEET UG</a></li>
                    <li><a href="/Courses">UPSC CSE</a></li>
                    <li><a href="/Courses">SSC CGL / CHSL</a></li>
                    <li><a href="/Courses">RRB NTPC / Group D</a></li>
                </ul>
            </div>
            <!-- Contact -->
            <div class="col-lg-3">
                <h5>Contact Us</h5>
                <ul class="list-unstyled" style="font-size:.875rem;line-height:2.2;color:#8aa5c8;">
                    <li><i class="bi bi-envelope-fill me-2" style="color:var(--ga-orange)"></i><a href="mailto:info@gridacademy.in">info@gridacademy.in</a></li>
                    <li><i class="bi bi-telephone-fill me-2" style="color:var(--ga-orange)"></i><a href="tel:+918000000000">+91 80000 00000</a></li>
                    <li><i class="bi bi-clock-fill me-2" style="color:var(--ga-orange)"></i>Mon–Sat, 9 AM – 6 PM IST</li>
                    <li><i class="bi bi-geo-alt-fill me-2" style="color:var(--ga-orange)"></i>India</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year GridAcademy. All rights reserved.</span>
            <span>
                <a href="/Privacy" class="me-3">Privacy Policy</a>
                <a href="/Terms">Terms of Use</a>
            </span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
