<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GridAcademy</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "GridAcademy — India's premier online learning platform for competitive exams. JEE, NEET, UPSC, SSC, RRB and more.")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        :root {
            --ga-blue:       #1760f4;
            --ga-blue-dark:  #0e4dd4;
            --ga-blue-light: #1760f4;
            --ga-orange:     #1760f4;   /* remapped — pages using --ga-orange get the primary blue */
            --ga-text:       #111827;
            --ga-muted:      #6b7280;
            --ga-border:     #e5e7eb;
            --ga-surface:    #f9fafb;
        }

        body { font-family: 'Inter', sans-serif; color: var(--ga-text); background: #fff; }

        /* ── Navbar ── */
        .ga-navbar {
            background: #fff;
            border-bottom: 1px solid var(--ga-border);
            padding: .875rem 0;
            position: sticky; top: 0; z-index: 1000;
        }
        .ga-navbar .navbar-brand {
            display: flex; align-items: center; gap: .55rem;
            font-weight: 700; font-size: 1.05rem; color: var(--ga-text);
            text-decoration: none;
        }
        .ga-navbar .navbar-brand .logo-icon {
            width: 32px; height: 32px;
            background: var(--ga-blue); border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
        }
        .ga-navbar .navbar-brand .logo-icon i { color: #fff; font-size: .95rem; }
        .ga-navbar .brand-sub { font-size: .6rem; font-weight: 400; color: var(--ga-muted); display: block; line-height: 1; }
        .ga-navbar .nav-link { color: var(--ga-muted); font-weight: 500; font-size: .875rem; padding: .4rem .85rem !important; border-radius: 5px; transition: color .15s; }
        .ga-navbar .nav-link:hover, .ga-navbar .nav-link.active { color: var(--ga-text); background: none; }
        .ga-navbar .btn-login {
            background: var(--ga-blue); color: #fff !important; padding: .4rem 1.1rem !important;
            border-radius: 6px; font-weight: 600; font-size: .875rem; transition: background .15s;
        }
        .ga-navbar .btn-login:hover { background: var(--ga-blue-dark); }

        /* ── Footer ── */
        .ga-footer { background: var(--ga-surface); color: var(--ga-muted); border-top: 1px solid var(--ga-border); padding: 3rem 0 1.25rem; margin-top: auto; }
        .ga-footer h5 { color: var(--ga-text); font-weight: 600; margin-bottom: .85rem; font-size: .9rem; letter-spacing: .01em; }
        .ga-footer a { color: var(--ga-muted); text-decoration: none; transition: color .15s; font-size: .875rem; }
        .ga-footer a:hover { color: var(--ga-text); }
        .ga-footer .footer-brand { font-size: 1.1rem; font-weight: 700; color: var(--ga-text); }
        .ga-footer .footer-brand small { font-size: .68rem; font-weight: 400; color: var(--ga-muted); display: block; }
        .ga-footer .social-link {
            width: 32px; height: 32px; border-radius: 6px; background: var(--ga-border);
            display: inline-flex; align-items: center; justify-content: center;
            color: var(--ga-muted); transition: background .15s, color .15s;
        }
        .ga-footer .social-link:hover { background: var(--ga-blue); color: #fff; }
        .ga-footer .footer-bottom { border-top: 1px solid var(--ga-border); margin-top: 1.75rem; padding-top: 1.1rem; font-size: .8rem; color: var(--ga-muted); }

        /* ── Page Hero ── */
        .page-hero { background: var(--ga-surface); border-bottom: 1px solid var(--ga-border); color: var(--ga-text); padding: 2.25rem 0 2rem; }
        .page-hero h1 { font-weight: 700; font-size: 1.65rem; margin-bottom: .35rem; color: var(--ga-text); }
        .page-hero p  { color: var(--ga-muted); margin: 0; font-size: .925rem; }
        .page-hero .breadcrumb-item, .page-hero .breadcrumb-item a { color: var(--ga-muted); font-size: .82rem; text-decoration: none; }
        .page-hero .breadcrumb-item.active { color: var(--ga-text); }
        .page-hero .breadcrumb-item + .breadcrumb-item::before { color: var(--ga-border); }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

<!-- ══════════════════════════════ NAVBAR ══════════════════════════════════ -->
<nav class="ga-navbar navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/">
            <div class="logo-icon"><i class="bi bi-grid-3x3-gap-fill"></i></div>
            <div>
                GridAcademy
                <span class="brand-sub">Learn · Practice · Excel</span>
            </div>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Courses" ? "active" : "")" href="/Courses">Courses</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "About" ? "active" : "")" href="/About">About Us</a></li>
                <li class="nav-item"><a class="nav-link @(ViewData["ActivePage"]?.ToString() == "Contact" ? "active" : "")" href="/Contact">Contact</a></li>
                <li class="nav-item ms-2"><a class="nav-link btn-login" href="/Account/Login">Login</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- ══════════════════════════════ CONTENT ═════════════════════════════════ -->
<main class="flex-grow-1">
    @RenderBody()
</main>

<!-- ══════════════════════════════ FOOTER ══════════════════════════════════ -->
<footer class="ga-footer">
    <div class="container">
        <div class="row g-4">
            <!-- Brand -->
            <div class="col-lg-4">
                <div class="footer-brand mb-2">
                    <i class="bi bi-grid-3x3-gap-fill me-2" style="color:var(--ga-blue)"></i>GridAcademy
                    <small>India's Premier Exam Preparation Platform</small>
                </div>
                <p style="font-size:.875rem;line-height:1.7;margin-top:.5rem;">
                    Empowering students across India to crack competitive exams with high-quality content
                    and expert-curated mock tests.
                </p>
                <div class="d-flex gap-2 mt-3">
                    <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-link" title="YouTube"><i class="bi bi-youtube"></i></a>
                    <a href="#" class="social-link" title="Telegram"><i class="bi bi-telegram"></i></a>
                    <a href="#" class="social-link" title="Twitter/X"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
            <!-- Quick Links -->
            <div class="col-6 col-lg-2 offset-lg-1">
                <h5>Quick Links</h5>
                <ul class="list-unstyled" style="line-height:2.1;">
                    <li><a href="/">Home</a></li>
                    <li><a href="/Courses">Courses</a></li>
                    <li><a href="/About">About Us</a></li>
                    <li><a href="/Contact">Contact</a></li>
                    <li><a href="/Account/Login">Student Login</a></li>
                </ul>
            </div>
            <!-- Exams -->
            <div class="col-6 col-lg-2">
                <h5>Exams</h5>
                <ul class="list-unstyled" style="line-height:2.1;">
                    <li><a href="/Courses">JEE Mains &amp; Advanced</a></li>
                    <li><a href="/Courses">NEET UG</a></li>
                    <li><a href="/Courses">UPSC CSE</a></li>
                    <li><a href="/Courses">SSC CGL / CHSL</a></li>
                    <li><a href="/Courses">RRB NTPC / Group D</a></li>
                </ul>
            </div>
            <!-- Contact -->
            <div class="col-lg-3">
                <h5>Contact Us</h5>
                <ul class="list-unstyled" style="line-height:2.2;">
                    <li><i class="bi bi-envelope me-2"></i><a href="mailto:info@gridacademy.in">info@gridacademy.in</a></li>
                    <li><i class="bi bi-telephone me-2"></i><a href="tel:+918000000000">+91 80000 00000</a></li>
                    <li><i class="bi bi-clock me-2"></i>Mon–Sat, 9 AM – 6 PM IST</li>
                    <li><i class="bi bi-geo-alt me-2"></i>India</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year GridAcademy. All rights reserved.</span>
            <span>
                <a href="/Privacy" class="me-3">Privacy Policy</a>
                <a href="/Terms">Terms of Use</a>
            </span>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
